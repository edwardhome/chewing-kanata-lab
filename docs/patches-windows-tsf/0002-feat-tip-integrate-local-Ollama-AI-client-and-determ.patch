+// SPDX-License-Identifier: GPL-3.0-or-later
+//! 本機 Ollama 候選字語意重排與智慧預測用戶端 (Local AI Loopback)
+//!
+//! 1. 純 Rust 標準庫實作 (std::net::TcpStream)，不依賴龐大 async runtime，確保 TSF DLL 輕量穩定。
+//! 2. 獨立背景 Worker 執行緒，透過非同步 mpsc channel 傳遞，絕不阻塞輸入法打字按鍵主迴圈。
+//! 3. 嚴格白名單檢驗：AI 僅允許在既有合法候選字中推薦，若包含非法或捏造字元一律丟棄。
+//! 4. 版本戳記保護 (Revision Guard)：逾時 (預設 120ms) 或使用者繼續打字時，自動丟棄過期預測結果。
+
+use std::io::{Read, Write};
+use std::net::{SocketAddr, TcpStream};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::mpsc::{self, Receiver, Sender};
+use std::sync::Arc;
+use std::thread;
+use std::time::Duration;
+use log::debug;
+
+#[derive(Debug, Clone)]
+pub(crate) struct RerankRequest {
+    pub revision: u64,
+    pub context: String,
+    pub candidates: Vec<String>,
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct RerankResult {
+    pub revision: u64,
+    pub chosen: String,
+}
+
+pub(crate) struct AiRerankerClient {
+    tx: Sender<RerankRequest>,
+    rx: Receiver<RerankResult>,
+    current_revision: Arc<AtomicU64>,
+}
+
+impl AiRerankerClient {
+    pub fn new() -> Self {
+        let (req_tx, req_rx) = mpsc::channel::<RerankRequest>();
+        let (res_tx, res_rx) = mpsc::channel::<RerankResult>();
+        let current_revision = Arc::new(AtomicU64::new(0));
+        let rev_clone = Arc::clone(&current_revision);
+
+        thread::Builder::new()
+            .name("chewing-ai-reranker".into())
+            .spawn(move || {
+                worker_loop(req_rx, res_tx, rev_clone);
+            })
+            .expect("Failed to spawn ai reranker thread");
+
+        Self {
+            tx: req_tx,
+            rx: res_rx,
+            current_revision,
+        }
+    }
+
+    /// 取得新的累加版本號
+    pub fn next_revision(&self) -> u64 {
+        self.current_revision.fetch_add(1, Ordering::SeqCst) + 1
+    }
+
+    /// 異步發送重排請求 (非阻塞)
+    pub fn request_rerank(&self, revision: u64, context: String, candidates: Vec<String>) {
+        if candidates.is_empty() {
+            return;
+        }
+        let _ = self.tx.send(RerankRequest {
+            revision,
+            context,
+            candidates,
+        });
+    }
+
+    /// 非阻塞嘗試接收重排結果，僅採納與預期 revision 相符的有效結果
+    pub fn try_get_result(&self, expected_revision: u64) -> Option<String> {
+        let mut best = None;
+        while let Ok(res) = self.rx.try_recv() {
+            if res.revision == expected_revision {
+                best = Some(res.chosen);
+            }
+        }
+        best
+    }
+}
+
+fn worker_loop(
+    rx: Receiver<RerankRequest>,
+    tx: Sender<RerankResult>,
+    latest_rev: Arc<AtomicU64>,
+) {
+    while let Ok(req) = rx.recv() {
+        // 若使用者在背景等待期間又按了下一個鍵，該請求已被廢棄，直接略過
+        if req.revision < latest_rev.load(Ordering::Relaxed) {
+            continue;
+        }
+
+        if let Some(chosen) = query_ollama(&req.context, &req.candidates) {
+            // 再次檢查版本是否過期
+            if req.revision == latest_rev.load(Ordering::Relaxed) {
+                let _ = tx.send(RerankResult {
+                    revision: req.revision,
+                    chosen,
+                });
+            }
+        }
+    }
+}
+
+/// 發送極簡 HTTP POST 到本機 127.0.0.1:11434/api/chat
+fn query_ollama(context: &str, candidates: &[String]) -> Option<String> {
+    let addr: SocketAddr = "127.0.0.1:11434".parse().ok()?;
+    let mut stream = TcpStream::connect_timeout(&addr, Duration::from_millis(80)).ok()?;
+    stream.set_read_timeout(Some(Duration::from_millis(200))).ok()?;
+    stream.set_write_timeout(Some(Duration::from_millis(80))).ok()?;
+
+    let cands_str = candidates.join("、");
+    let user_prompt = format!(
+        "前文是「{context}」，接下來從候選字【{cands_str}】選出最合適的一個字。請只輸出該字，不要任何多餘標點或解釋："
+    );
+
+    // 構造 Ollama /api/chat JSON
+    let body = format!(
+        r#"{{"model":"qwen2.5:1.5b","messages":[{{"role":"user","content":{:?}}}],"stream":false,"options":{{"temperature":0.0,"num_predict":4}}}}"#,
+        user_prompt
+    );
+
+    let req_data = format!(
+        "POST /api/chat HTTP/1.1\r\n\
+         Host: 127.0.0.1:11434\r\n\
+         Content-Type: application/json; charset=utf-8\r\n\
+         Content-Length: {}\r\n\
+         Connection: close\r\n\r\n{}",
+        body.as_bytes().len(),
+        body
+    );
+
+    if stream.write_all(req_data.as_bytes()).is_err() {
+        return None;
+    }
+
+    let mut response_bytes = Vec::with_capacity(1024);
+    let _ = stream.read_to_end(&mut response_bytes);
+    let response_str = String::from_utf8_lossy(&response_bytes);
+
+    // 解析 JSON 中的 "content":"..."
+    let resp_text = extract_content_field(&response_str)?;
+
+    // 嚴格白名單檢驗：回傳之字元必須在候選清單中
+    for cand in candidates {
+        if resp_text.contains(cand.as_str()) {
+            debug!(cand; "Ollama AI selected candidate");
+            return Some(cand.clone());
+        }
+    }
+
+    None
+}
+
+/// 極簡 JSON 解析，提取 "content":"..." 欄位值
+fn extract_content_field(raw_http: &str) -> Option<String> {
+    let json_start = raw_http.find("\r\n\r\n")? + 4;
+    let json_body = &raw_http[json_start..];
+    let key = "\"content\":\"";
+    let key_pos = json_body.find(key)?;
+    let val_start = key_pos + key.len();
+    let val_end = json_body[val_start..].find('"')? + val_start;
+    Some(json_body[val_start..val_end].trim().to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_extract_content_field() {
+        let raw_http = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{\"message\":{\"role\":\"assistant\",\"content\":\"再\"},\"done\":true}";
+        assert_eq!(extract_content_field(raw_http), Some("再".to_string()));
+    }
+
+    #[test]
+    fn test_ai_reranker_revision() {
+        let client = AiRerankerClient::new();
+        let r1 = client.next_revision();
+        let r2 = client.next_revision();
+        assert_eq!(r2, r1 + 1);
+    }
+}
