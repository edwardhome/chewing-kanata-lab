+// SPDX-License-Identifier: GPL-3.0-or-later
+//! One-shot timers owned by the activating TSF thread. No cross-thread COM calls.
+use std::{cell::RefCell, collections::HashMap, sync::atomic::{AtomicU32, Ordering}, marker::PhantomData, rc::Rc};
+use windows::Win32::{Foundation::HWND, UI::WindowsAndMessaging::{KillTimer, SetTimer}};
+use super::{CommandType, IFnRunCommand};
+
+struct Target { command: IFnRunCommand, generation: u32 }
+thread_local! { static TARGETS: RefCell<HashMap<usize, Target>> = RefCell::new(HashMap::new()); }
+static NEXT: AtomicU32 = AtomicU32::new(1);
+
+pub(super) struct HoldTimer { id: usize, pub generation: u32, _thread: PhantomData<Rc<()>> }
+impl HoldTimer {
+    pub fn start(command: IFnRunCommand, delay_ms: u32) -> Option<Self> {
+        let generation = NEXT.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| n.checked_add(1)).ok()?;
+        let id = unsafe { SetTimer(None, 0, delay_ms.clamp(100, 1000), Some(tick)) };
+        if id == 0 { return None; }
+        TARGETS.with(|targets| targets.borrow_mut().insert(id, Target {command, generation}));
+        Some(Self {id, generation, _thread: PhantomData})
+    }
+}
+impl Drop for HoldTimer {
+    fn drop(&mut self) {
+        let removed = TARGETS.with(|targets| {
+            let mut targets = targets.borrow_mut();
+            if targets.get(&self.id).is_some_and(|target| target.generation == self.generation) {
+                targets.remove(&self.id)
+            } else { None }
+        });
+        if removed.is_some() { let _ = unsafe { KillTimer(None, self.id) }; }
+        // Release COM references outside the map borrow; release may reenter TSF.
+        drop(removed);
+    }
+}
+unsafe extern "system" fn tick(_: HWND, _: u32, id: usize, _: u32) {
+    let _ = unsafe { KillTimer(None, id) };
+    let target = TARGETS.with(|targets| targets.borrow_mut().remove(&id));
+    if let Some(target) = target {
+        unsafe { target.command.on_command(target.generation, CommandType::InitialHoldTick); }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{cell::Cell, time::{Duration, Instant}};
+    use windows::Win32::UI::WindowsAndMessaging::{DispatchMessageW, MSG, PM_REMOVE, PeekMessageW};
+    use windows_core::{ComObject, implement};
+    use crate::text_service::IFnRunCommand_Impl;
+    #[implement(IFnRunCommand)]
+    struct Probe { calls: Rc<Cell<u32>>, generation: Rc<Cell<u32>> }
+    impl IFnRunCommand_Impl for Probe_Impl {
+        unsafe fn on_command(&self, id: u32, _: CommandType) {
+            self.calls.set(self.calls.get()+1);
+            self.generation.set(id);
+        }
+    }
+    fn pump(duration: Duration) {
+        let until=Instant::now()+duration;
+        while Instant::now()<until {
+            let mut msg=MSG::default();
+            while unsafe { PeekMessageW(&mut msg,None,0,0,PM_REMOVE) }.as_bool() {
+                unsafe { DispatchMessageW(&msg); }
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        }
+    }
+    #[test]
+    fn actual_thread_timer_delivers_once_with_generation() {
+        let calls=Rc::new(Cell::new(0));let generation=Rc::new(Cell::new(0));
+        let probe=ComObject::new(Probe {calls:calls.clone(),generation:generation.clone()});
+        let timer=HoldTimer::start(probe.into_interface(),100).unwrap();
+        pump(Duration::from_millis(350));
+        assert_eq!(calls.get(),1);assert_eq!(generation.get(),timer.generation);
+        drop(timer);assert!(TARGETS.with(|t|t.borrow().is_empty()));
+    }
+    #[test]
+    fn cancelled_thread_timer_never_delivers() {
+        let calls=Rc::new(Cell::new(0));let generation=Rc::new(Cell::new(0));
+        let probe=ComObject::new(Probe {calls:calls.clone(),generation});
+        let timer=HoldTimer::start(probe.into_interface(),100).unwrap();drop(timer);
+        pump(Duration::from_millis(200));assert_eq!(calls.get(),0);
+        assert!(TARGETS.with(|t|t.borrow().is_empty()));
+    }
+}
