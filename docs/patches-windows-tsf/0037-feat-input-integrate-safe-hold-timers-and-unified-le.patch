+    fn cancel_initial_hold(&mut self) {
+        self.initial_hold.cancel();
+        self.initial_timer = None;
+        self.initial_target = None;
+    }
+
+    fn start_initial_hold(&mut self, vk: u16) {
+        self.cancel_initial_hold();
+        if !(0x41..=0x5A).contains(&vk) || vk == 0x46 { return; }
+        let Some(target) = self.pending_state.clone().filter(|s| s.is_active() && !s.is_failed()) else { return; };
+        let delay = self.cfg.chewing_tsf.initial_letter_hold_delay_ms.clamp(100, 1000) as u32;
+        self.initial_hold.set_delay(Duration::from_millis(delay as u64));
+        self.initial_hold.start(vk, vk as u8 as char, Instant::now());
+        self.initial_invalidated.set(false);
+        self.initial_target = Some(target);
+        // A failed timer allocation leaves the event-driven elapsed-time fallback available.
+        if let Ok(command) = self.composition_sink.cast::<super::IFnRunCommand>() {
+            self.initial_timer = HoldTimer::start(command, delay);
+        }
+    }
+
+    fn initial_target_valid(&self, context: &ITfContext) -> bool {
+        !self.initial_invalidated.get() && self.has_focus && self.lang_mode.get() == TsfLangMode::Chinese
+            && self.f_buffer.is_none() && self.is_context_mutable(context).unwrap_or(false)
+            && self.initial_target.as_ref().zip(self.pending_state.as_ref()).is_some_and(|(a,b)|
+                Rc::ptr_eq(a,b) && a.same_context(context) && a.is_active() && !a.is_failed() && !a.is_ending())
+            && self.shift_session.as_ref().is_some_and(|s|
+                matches!(s.mode, ShiftMode::Initial | ShiftMode::Word) && s.composition.raw.len() == 1
+                && s.composition.cursor == 1 && s.composition.selected_index == 0)
+    }
+
+    fn apply_initial_effect(&mut self, context: &ITfContext, effect: HoldEffect) -> Result<()> {
+        if let HoldEffect::TransformToLowercase { uppercase, lowercase } = effect {
+            if !self.initial_target_valid(context) { self.cancel_initial_hold(); return Ok(()); }
+            let next = self.shift_session.as_ref().and_then(|session|
+                lowered_initial_session(session, uppercase, lowercase, &self.lexicon));
+            let Some(next) = next else { self.cancel_initial_hold(); return Ok(()); };
+            self.shift_session = Some(next);
+            self.render_ascii(context)?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn on_initial_hold_tick(&mut self, generation: u32) -> Result<()> {
+        if !self.initial_timer.as_ref().is_some_and(|timer| timer.generation == generation) { return Ok(()); }
