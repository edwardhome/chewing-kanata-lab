diff --git a/crates/chewing_tip_core/src/f_layer.rs b/crates/chewing_tip_core/src/f_layer.rs
new file mode 100644
index 0000000..ea1d205
--- /dev/null
+++ b/crates/chewing_tip_core/src/f_layer.rs
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// One authoritative table for native F-layer lookup and the preferences form.
+use std::collections::BTreeMap;
+use serde::Serialize;
+
+#[derive(Debug, Serialize)]
+pub struct Mapping { pub key: u16, pub label: &'static str, pub output: &'static str }
+pub const DEFAULTS: &[Mapping] = &[
+    Mapping { key: 27, label: "Esc", output: "`" },
+    Mapping { key: 192, label: "`", output: "`" },
+    Mapping { key: 49, label: "1", output: "!" },
+    Mapping { key: 50, label: "2", output: "@" },
+    Mapping { key: 51, label: "3", output: "#" },
+    Mapping { key: 52, label: "4", output: "$" },
+    Mapping { key: 53, label: "5", output: "%" },
+    Mapping { key: 54, label: "6", output: "^" },
+    Mapping { key: 55, label: "7", output: "&" },
+    Mapping { key: 56, label: "8", output: "~" },
+    Mapping { key: 57, label: "9", output: "(" },
+    Mapping { key: 48, label: "0", output: ")" },
+    Mapping { key: 189, label: "-", output: "_" },
+    Mapping { key: 187, label: "=", output: "'" },
+    Mapping { key: 81, label: "Q", output: "/" },
+    Mapping { key: 87, label: "W", output: "*" },
+    Mapping { key: 69, label: "E", output: "-" },
+    Mapping { key: 82, label: "R", output: "+" },
+    Mapping { key: 89, label: "Y", output: "7" },
+    Mapping { key: 85, label: "U", output: "8" },
+    Mapping { key: 73, label: "I", output: "9" },
+    Mapping { key: 79, label: "O", output: "{" },
+    Mapping { key: 80, label: "P", output: "}" },
+    Mapping { key: 219, label: "[", output: "[" },
+    Mapping { key: 221, label: "]", output: "]" },
+    Mapping { key: 220, label: "\\", output: "\\" },
+    Mapping { key: 65, label: "A", output: "<" },
+    Mapping { key: 83, label: "S", output: ">" },
+    Mapping { key: 68, label: "D", output: "=" },
+    Mapping { key: 71, label: "G", output: ">" },
+    Mapping { key: 72, label: "H", output: "4" },
+    Mapping { key: 74, label: "J", output: "5" },
+    Mapping { key: 75, label: "K", output: "6" },
+    Mapping { key: 76, label: "L", output: ":" },
+    Mapping { key: 186, label: ";", output: ";" },
+    Mapping { key: 222, label: "'", output: "\"" },
+    Mapping { key: 90, label: "Z", output: "'" },
+    Mapping { key: 88, label: "X", output: "|" },
+    Mapping { key: 66, label: "B", output: "°" },
+    Mapping { key: 78, label: "N", output: "1" },
+    Mapping { key: 77, label: "M", output: "2" },
+    Mapping { key: 188, label: ",", output: "3" },
+    Mapping { key: 190, label: ".", output: "." },
+    Mapping { key: 191, label: "/", output: "?" },
+    Mapping { key: 32, label: "Space", output: "0" },
+    Mapping { key: 84, label: "T", output: "" },
+    Mapping { key: 67, label: "C", output: "" },
+    Mapping { key: 86, label: "V", output: "" },
+];
+pub fn default_output(key: u16) -> Option<&'static str> {
+    DEFAULTS.iter().find(|row| row.key == key).map(|row| row.output).filter(|s| !s.is_empty())
+}
+pub fn validate(overrides: &BTreeMap<String, String>) -> Result<(), String> {
+    for (key, output) in overrides {
+        if !DEFAULTS.iter().any(|row| row.key.to_string() == *key) {
+            return Err(format!("F 分層不支援按鍵代碼 {key}。"));
+        }
+        if output.chars().count() > 1 || output.chars().any(char::is_control) {
+            return Err("F 分層每個按鍵只能設定一個可顯示字元，或留空使用原按鍵。".into());
+        }
+    }
+    Ok(())
+}
+pub fn resolve(overrides: &BTreeMap<String, String>, key: u16) -> Option<&str> {
+    if !DEFAULTS.iter().any(|row| row.key == key) { return None; }
+    match overrides.get(&key.to_string()) {
+        Some(value) => (!value.is_empty()).then_some(value.as_str()),
+        None => default_output(key),
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn defaults_and_overrides_are_independent() {
+        let mut map=BTreeMap::new();
+        assert_eq!(resolve(&map,0x4a),Some("5"));
+        map.insert(0x4au16.to_string(),"λ".into()); assert!(validate(&map).is_ok());
+        assert_eq!(resolve(&map,0x4a),Some("λ")); assert_eq!(resolve(&map,0x4b),Some("6"));
+        map.insert(0x4au16.to_string(),String::new()); assert_eq!(resolve(&map,0x4a),None);
+        map.remove(&0x4au16.to_string());assert_eq!(resolve(&map,0x4a),Some("5"));
+        map.insert(0x54u16.to_string(),"7".into());assert_eq!(resolve(&map,0x54),Some("7"));
+    }
+    #[test] fn rejects_modifiers_controls_and_multiple_characters() {
+        for (key,value) in [(0x46u16,"a"),(0x08,"b"),(0x10,"c"),(0x4a,"ab"),(0x4a,"\n"),(0x4a,"\0")] {
+            assert!(validate(&BTreeMap::from([(key.to_string(),value.into())])).is_err());
+        }
+        assert!(validate(&BTreeMap::from([("74".into(),"𠀀".into())])).is_ok());
+        assert!(validate(&BTreeMap::from([("074".into(),"x".into())])).is_err());
+    }
+    #[test] fn table_has_unique_non_modifier_keys() {
+        let mut keys=std::collections::BTreeSet::new();
+        for row in DEFAULTS {assert!(keys.insert(row.key));assert_ne!(row.key,0x46);assert!(row.output.chars().count()<=1);}
+        assert_eq!(default_output(0x1b),Some("`"));assert_eq!(default_output(0x20),Some("0"));
+    }
+    #[test] fn serialized_overrides_roundtrip_and_empty_restores_defaults() {
+        let map=BTreeMap::from([(0x4au16.to_string(),"λ".to_string()),(0x4bu16.to_string(),String::new())]);
+        let parsed:BTreeMap<String,String>=serde_json::from_str(&serde_json::to_string(&map).unwrap()).unwrap();
+        assert_eq!(parsed,map);assert!(validate(&parsed).is_ok());
+        let restored:BTreeMap<String,String>=serde_json::from_str("{}").unwrap();assert_eq!(resolve(&restored,0x4b),Some("6"));
+    }
+}
