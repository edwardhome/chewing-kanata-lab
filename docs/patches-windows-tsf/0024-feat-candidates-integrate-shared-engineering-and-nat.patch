+        assert_eq!(geometry.indexes(), [0, 10, 20]);
+        assert_eq!(geometry.range(), 20..23);
+        assert_eq!(geometry.global_selection(2), Some(22));
+        assert_eq!(geometry.global_selection(3), None);
+        assert_eq!(geometry.global_selection(usize::MAX), None);
+        assert!(geometry.accepts_indexes(&[0, 10, 20]));
+        assert!(!geometry.accepts_indexes(&[0, 8, 16]));
+        assert!(!geometry.accepts_indexes(&[0, 10]));
+    }
+    #[test]
+    fn empty_and_invalid_geometry_are_safe() {
+        let empty = PageGeometry::new(0, 10, 0).unwrap();
