+struct CompleteTable {
+    items: Vec<String>,
+    geometry: PageGeometry,
+}
+
+/// Canonical full-table paging, shared by the rendering projection and UI-less API.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct PageGeometry { count: usize, page_size: usize, current_page: usize }
+impl PageGeometry {
+    fn new(count: usize, page_size: usize, current_page: usize) -> Option<Self> {
+        if page_size == 0 || count > u32::MAX as usize { return None; }
+        let geometry = Self { count, page_size, current_page };
+        if (count == 0 && current_page != 0) || (count != 0 && current_page >= geometry.page_count()) { return None; }
+        Some(geometry)
+    }
+    fn page_count(self) -> usize {
+        self.count / self.page_size + usize::from(self.count % self.page_size != 0)
+    }
+    fn range(self) -> std::ops::Range<usize> {
+        let start = self.current_page * self.page_size;
+        start..start.saturating_add(self.page_size).min(self.count)
+    }
+    fn global_selection(self, slot: usize) -> Option<usize> {
+        let range = self.range();
+        if slot >= range.len() { return None; }
+        range.start.checked_add(slot)
+    }
+    fn indexes(self) -> Vec<u32> {
+        (0..self.page_count()).map(|page| (page * self.page_size) as u32).collect()
+    }
+    fn accepts_indexes(self, indexes: &[u32]) -> bool { self.indexes() == indexes }
+}
+
+fn copy_page_indexes(geometry: PageGeometry, output: *mut u32, capacity: u32,
+    page_count: *mut u32) -> WindowsResult<()> {
+    if page_count.is_null() || (page_count as usize) % align_of::<u32>() != 0 { return Err(E_INVALIDARG.into()); }
+    let indexes = geometry.indexes();
+    // COM permits NULL pIndex for the initial page-count query.
+    unsafe { page_count.write(indexes.len() as u32); }
+    if output.is_null() { return Ok(()); }
+    if (output as usize) % align_of::<u32>() != 0 || (capacity as usize) < indexes.len() { return Err(E_INVALIDARG.into()); }
+    if !indexes.is_empty() {
+        // Caller guarantees capacity writable UINTs as required by the COM interface.
+        unsafe { std::ptr::copy_nonoverlapping(indexes.as_ptr(), output, indexes.len()); }
+    }
+    Ok(())
+}
