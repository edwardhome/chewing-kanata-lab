+#[cfg(test)]
+mod f_and_shift_handoff_tests {
+    use super::*;
+    use chewing_policy_core::shift_letter::{CompositionAction, SessionResult, ShiftLetterSession, ShiftMode};
+
+    #[test]
+    fn test_f_gesture_state_lifecycle() {
+        let mut f_state = kanata_layer::FKeyState::Up;
+        assert_eq!(f_state, kanata_layer::FKeyState::Up);
+
+        // F KeyDown
+        f_state = kanata_layer::FKeyState::Down(Instant::now());
+        assert!(matches!(f_state, kanata_layer::FKeyState::Down(_)));
+
+        // Layer symbol confirmed: transitions to Held
+        f_state = kanata_layer::FKeyState::Held;
+        assert_eq!(f_state, kanata_layer::FKeyState::Held);
+
+        // F KeyUp
+        f_state = kanata_layer::FKeyState::Up;
+        assert_eq!(f_state, kanata_layer::FKeyState::Up);
+    }
+
+    #[test]
+    fn test_f_buffer_layer_accumulation_and_backspace() {
+        let lexicon = TechnicalLexicon::default();
+        let mut buffer = FCompositionBuffer::new(None, &lexicon);
+        assert_eq!(buffer.symbols(), "");
+
+        // Appending layer symbols: '5' (VK_J), '6' (VK_K)
+        let s1 = kanata_layer::map_kanata_number_layer(0x4A).expect("J maps to 5");
+        buffer.append(s1);
+        assert_eq!(buffer.symbols(), "5");
+
+        let s2 = kanata_layer::map_kanata_number_layer(0x4B).expect("K maps to 6");
+        buffer.append(s2);
+        assert_eq!(buffer.symbols(), "56");
+
+        // Backspace removes last symbol
+        buffer.backspace();
+        assert_eq!(buffer.symbols(), "5");
+
+        // Backspace to empty
+        buffer.backspace();
+        assert_eq!(buffer.symbols(), "");
+    }
+
+    #[test]
+    fn test_ordered_chinese_commit_then_layer_symbols() {
+        let mut queue = PendingTransitionQueue::new();
+
+        // 1. Chinese composition was active: resolved Chinese is "組字".
+        // When first F layer symbol '1' is confirmed, "組字" is committed and '1' is preedit.
+        queue.enqueue("組字", "1", vec![(0, 1)], 1);
+        assert_eq!(queue.pending_commit_str(), "組字");
+        assert_eq!(queue.preedit_str(), "1");
+
+        // 2. Second layer symbol '2' is typed while F is still held:
+        // Chinese is NOT committed again (commit is ""). Preedit updates to "12".
+        queue.enqueue("", "12", vec![(0, 2)], 2);
+        assert_eq!(queue.pending_commit_str(), "組字");
+        assert_eq!(queue.preedit_str(), "12");
+
+        // 3. Edit session runs: pulls snapshot.
+        let sub = queue.begin_submission().expect("sub");
+        assert_eq!(sub.commit, "組字");
+        assert_eq!(sub.preedit, "12");
+        assert!(queue.acknowledge_success(sub.generation));
+
+        // 4. On F keyup, symbols "12" are committed!
+        queue.enqueue("12", "", vec![], 0);
+        let sub2 = queue.begin_submission().expect("sub2");
+        assert_eq!(sub2.commit, "12");
+        assert_eq!(sub2.preedit, "");
+        assert!(queue.acknowledge_success(sub2.generation));
+        assert_eq!(queue.pending_commit_str(), "");
+    }
+
+    #[test]
+    fn test_shift_letter_handoff_atomic_commit_and_preedit() {
+        let mut queue = PendingTransitionQueue::new();
+        let lexicon = TechnicalLexicon::default();
+
+        // Chinese composition was active: resolved Chinese is "中文".
+        // User presses Shift + 'A' (VK 0x41).
+        let initial_char = 'A';
+        let session = ShiftLetterSession::start_with_letter(initial_char, &lexicon);
+        assert_eq!(session.mode, ShiftMode::Initial);
+
+        // Atomic transition: "中文" committed, "A" is English preedit
+        let preedit = session.composition.display();
+        queue.enqueue("中文", preedit, vec![(0, 1)], 1);
+        assert_eq!(queue.pending_commit_str(), "中文");
+        assert_eq!(queue.preedit_str(), "A");
+
+        let sub1 = queue.begin_submission().expect("sub1");
+        assert_eq!(sub1.commit, "中文");
+        assert_eq!(sub1.preedit, "A");
+        assert!(queue.acknowledge_success(sub1.generation));
+
+        // Shift is released -> transitions to Word mode
+        let word_session = session;
+        if let SessionResult::Updated(next) = word_session.releasing_shift() {
+            assert_eq!(next.mode, ShiftMode::Word);
+            // User types lowercase 'p'
+            let after_p = next.applying(CompositionAction::Insert("p".into()), false, false, &lexicon);
+            if let SessionResult::Updated(p_session) = after_p {
+                assert_eq!(p_session.composition.display(), "Ap");
+                queue.enqueue("", p_session.composition.display(), vec![(0, 2)], 2);
+                let sub2 = queue.begin_submission().expect("sub2");
+                assert_eq!(sub2.commit, "");
+                assert_eq!(sub2.preedit, "Ap");
+                assert!(queue.acknowledge_success(sub2.generation));
+            }
+        }
+    }
+
+    #[test]
+    fn test_shift_modifier_alone_no_commit() {
+        let mut state = ShiftKeyState::Down(Instant::now());
+        assert!(!state.reconcile(false, true));
+        let released = state.release();
+        assert!(released.is_some());
+        assert_eq!(state, ShiftKeyState::Up);
+    }
+
+    #[test]
+    fn test_lifecycle_epoch_advances_and_prevents_stale_draining() {
+        let epoch = Rc::new(Cell::new(1u64));
+        let session_epoch = epoch.get();
+        let queue = Rc::new(RefCell::new(PendingTransitionQueue::new()));
+
+        // Queue has new composition data
+        queue.borrow_mut().enqueue("新字", "pre", vec![], 0);
+
+        // Composition ended / focus killed -> epoch advanced to 2
+        epoch.set(epoch.get().wrapping_add(1));
+        assert_ne!(epoch.get(), session_epoch);
+
+        // If stale session runs with session_epoch, it detects mismatch and leaves queue intact
+        if epoch.get() != session_epoch {
+            // Skips DoEditSession without draining
+        } else {
+            panic!("epoch should have mismatched!");
+        }
+
+        // Verify queue was NOT touched or drained by the stale session
+        assert_eq!(queue.borrow().pending_commit_str(), "新字");
+        assert!(queue.borrow().has_unsubmitted_changes());
+        assert!(!queue.borrow().is_in_flight());
+    }
+
+    #[test]
+    fn test_pre_write_failure_preserves_pending_queue() {
+        let mut queue = PendingTransitionQueue::new();
+        queue.enqueue("重要文字", "pre", vec![], 0);
+
+        // Pre-write snapshot begins
+        let sub = queue.begin_submission().expect("sub ready");
+        assert_eq!(sub.commit, "重要文字");
+        assert!(queue.is_in_flight());
+
+        // Pre-write failure occurs (e.g. SetText error)
+        assert!(queue.acknowledge_failure(sub.generation));
+
+        // State is not stuck: in_flight is cleared, unsubmitted changes and commit text are retained
+        assert!(!queue.is_in_flight());
+        assert!(queue.has_unsubmitted_changes());
+        assert_eq!(queue.pending_commit_str(), "重要文字");
+
+        // Retry succeeds cleanly
+        let retry_sub = queue.begin_submission().expect("retry ready");
+        assert_eq!(retry_sub.commit, "重要文字");
+        assert!(queue.acknowledge_success(retry_sub.generation));
+        assert_eq!(queue.pending_commit_str(), "");
+    }
+
+    #[test]
+    fn test_durable_commit_success_prevents_duplicate_commit_on_later_failures() {
+        let mut queue = PendingTransitionQueue::new();
+        queue.enqueue("永久提交", "pre", vec![], 0);
+
+        let sub = queue.begin_submission().expect("sub");
+        assert_eq!(sub.commit, "永久提交");
+
+        // Durable commit (SetText + ShiftStart) succeeds: acknowledge_success called immediately
+        assert!(queue.acknowledge_success(sub.generation));
+        assert_eq!(queue.pending_commit_str(), "");
+
+        // Later best-effort decoration (e.g. SetValue or SetSelection) fails:
+        // Crucial invariant: we DO NOT call acknowledge_failure for an already-committed generation!
+        // Queue remains clean with no duplicate pending commits
+        assert_eq!(queue.pending_commit_str(), "");
+        assert!(!queue.has_unsubmitted_changes());
+        assert!(!queue.is_in_flight());
+    }
+
+    #[test]
+    fn test_reentrant_enqueue_survives_in_flight_acknowledgement() {
+        let mut queue = PendingTransitionQueue::new();
+
+        // Keystroke 1: "前"
+        queue.enqueue("前", "a", vec![], 0);
+        let sub1 = queue.begin_submission().expect("sub1");
+
+        // While in-flight, reentrant keystroke 2 arrives: "後"
+        queue.enqueue("後", "b", vec![], 0);
+        assert_eq!(queue.pending_commit_str(), "前後");
+        assert!(queue.has_unsubmitted_changes());
+
+        // Sub1 durable commit succeeds
+        assert!(queue.acknowledge_success(sub1.generation));
+
+        // Sub1 commit retired, reentrant edit 2 ("後") is preserved and pending!
+        assert_eq!(queue.pending_commit_str(), "後");
+        assert_eq!(queue.preedit_str(), "b");
+        assert!(queue.has_unsubmitted_changes());
+
+        // Immediate follow-up dispatch handles remaining edit
+        let sub2 = queue.begin_submission().expect("sub2 follow-up");
+        assert_eq!(sub2.commit, "後");
+        assert_eq!(sub2.preedit, "b");
+        assert!(queue.acknowledge_success(sub2.generation));
+        assert_eq!(queue.pending_commit_str(), "");
+        assert!(!queue.has_unsubmitted_changes());
+    }
+}
