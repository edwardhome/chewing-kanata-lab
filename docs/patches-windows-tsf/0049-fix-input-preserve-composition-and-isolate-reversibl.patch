--- /dev/null
+++ b/tip/src/text_service/f_preview.rs
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Pure display/time helpers used by the native F gesture adapter.
+use std::time::Duration;
+
+/// Cursor is a Unicode scalar offset from the editor; TSF caret is UTF-16.
+/// Returns a display copy, without changing the original composition.
+pub(super) fn insert_marked(base: &str, cursor: usize, preview: &str) -> (String, usize) {
+    let head: String = base.chars().take(cursor).collect();
+    let tail: String = base.chars().skip(cursor).collect();
+    let caret = head.encode_utf16().count() + preview.encode_utf16().count();
+    (format!("{head}{preview}{tail}"), caret)
+}
+
+/// A timer may arrive early; equality is still normal typing, never a layer.
+pub(super) fn remaining_delay(elapsed: Duration, delay: Duration) -> Option<u32> {
+    (elapsed <= delay).then(|| (delay.saturating_sub(elapsed).as_millis() + 1).min(u32::MAX as u128) as u32)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn native_prefix_suffix_and_source_survive_preview() {
+        let base="中文輸入";
+        assert_eq!(insert_marked(base,2,"ㄑ"),("中文ㄑ輸入".into(),3));
+        assert_eq!(insert_marked(base,2,"·"),("中文·輸入".into(),3));
+        assert_eq!(base,"中文輸入");
+    }
+    #[test]
+    fn ascii_middle_preview_is_not_appended_or_committed() {
+        assert_eq!(insert_marked("abcd",2,"f"),("abfcd".into(),3));
+        assert_eq!(insert_marked("",0,"f"),("f".into(),1));
+    }
+    #[test]
+    fn supplementary_characters_use_utf16_caret() {
+        assert_eq!(insert_marked("𠀀文",1,"ㄑ"),("𠀀ㄑ文".into(),3));
+    }
+    #[test]
+    fn deadline_is_strict_and_early_tick_is_rescheduled() {
+        let d=Duration::from_millis(150);
+        assert_eq!(remaining_delay(Duration::from_millis(149),d),Some(2));
+        assert_eq!(remaining_delay(d,d),Some(1));
+        assert_eq!(remaining_delay(d+Duration::from_nanos(1),d),None);
+    }
+}
