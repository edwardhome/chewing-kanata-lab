 }
+
+#[cfg(test)]
+mod recovery_shift_tests {
+    use super::*;
+
+    #[test]
+    fn missing_shift_up_does_not_make_later_letters_english() {
+        for mut state in [ShiftKeyState::Down(Instant::now()), ShiftKeyState::Consumed] {
+            assert!(!state.reconcile(false, false));
+            assert_eq!(state, ShiftKeyState::Up);
+            assert!(state.release().is_none());
+        }
+    }
+
+    #[test]
+    fn physical_shift_still_handles_uppercase_and_shift_f() {
+        for mut state in [ShiftKeyState::Up, ShiftKeyState::Consumed] {
+            assert!(state.reconcile(true, false));
+        }
+    }
+
+    #[test]
+    fn shift_event_keeps_release_timing_for_double_shift() {
+        let mut state = ShiftKeyState::Down(Instant::now());
+        assert!(!state.reconcile(false, true));
+        assert!(state.release().is_some());
+        assert_eq!(state, ShiftKeyState::Up);
+    }
+}
