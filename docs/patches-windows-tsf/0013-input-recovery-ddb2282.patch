@@ -375,13 +388,89 @@ impl ChewingTextService {
     pub(super) fn on_focus(&mut self) -> Result<()> {
         debug!("on_focus");
         self.has_focus = true;
+        self.reset_shift_gesture();
+        self.recover_focused_context();
         Ok(())
     }
 
+    pub(super) fn reset_shift_gesture(&mut self) {
+        self.shift_key_state = ShiftKeyState::Up;
+        self.double_shift.reset();
+    }
+
     pub(super) fn on_thread_focus(&mut self) -> Result<()> {
-        let _ = self.cfg.reload_if_needed();
-        self.apply_runtime_config()?;
-        self.sync_lang_mode(true)?;
+        self.reset_shift_gesture();
+        // Focus changes must not rebuild an editor that still owns uncommitted text.
+        if !self.has_pending_input() {
+            self.apply_config_if_changed()?;
+            self.sync_lang_mode(true)?;
+            self.chewing_editor.set_editor_options(|opt| opt.language_mode = self.lang_mode.get().into());
+        }
+        self.recover_focused_context();
+        Ok(())
+    }
+
+    fn has_pending_input(&self) -> bool {
+        self.is_composing() || !self.chewing_editor.is_empty()
+            || !self.chewing_editor.syllable_buffer_display().is_empty()
+            || self.chewing_editor.is_selecting() || self.shift_session.is_some()
+            || self.f_buffer.is_some() || self.pending_edit.upgrade().is_some()
+    }
+
+    fn recovery_time_ms() -> Result<u64> {
+        Ok(u64::try_from(SystemTime::now().duration_since(UNIX_EPOCH)?.as_millis())?)
+    }
+
+    fn request_input_recovery(&mut self) -> Result<()> {
+        let key = windows_registry::CURRENT_USER.options().create().write()
+            .open("Software\\ChewingDev")?;
+        key.set_u64("InputRecoveryRequest", Self::recovery_time_ms()?)?;
+        self.recover_focused_context();
+        Ok(())
+    }
+
+    fn recover_focused_context(&mut self) {
+        if let Ok(context) = unsafe { self.thread_mgr.GetFocus().and_then(|doc| doc.GetTop()) } {
+            if self.try_recover_input(&context).is_err() {
+                error!("input recovery could not complete; retry from settings");
+            }
+        }
+    }
+
+    fn try_recover_input(&mut self, context: &ITfContext) -> Result<()> {
+        let request = windows_registry::CURRENT_USER.open("Software\\ChewingDev")
+            .and_then(|key| key.get_u64("InputRecoveryRequest")).unwrap_or(0);
+        if request == 0 { return Ok(()); }
+        let now = Self::recovery_time_ms()?;
+        let safe = self.has_focus && self.is_context_mutable(context).unwrap_or(false);
+        // Unlike normal key conversion, a failed snapshot must defer recovery.
+        let mut keys = [0u8; 256];
+        let snapshot_ok = unsafe { GetKeyboardState(&mut keys) }.is_ok();
+        let held = [0x10usize, 0x11, 0x12, 0x5b, 0x5c, 0x46]
+            .iter().any(|&vk| keys[vk] & 0x80 != 0);
+        let caps_forces_english = self.cfg.chewing_tsf.enable_caps_lock
+            && ((keys[0x14] & 1 != 0) != self.cfg.chewing_tsf.lock_chinese_on_caps_lock);
+        let busy = self.has_pending_input() || held || caps_forces_english;
+        if !self.recovery_gate.consider(request, now, safe && snapshot_ok, busy) {
+            return Ok(());
+        }
+        // Construct first so a failure cannot discard the working editor.
+        let form = self.chewing_editor.editor_options().character_form;
+        let mut editor = Self::build_editor_from_cfg(&self.cfg.chewing_tsf)?;
+        editor.set_editor_options(|opt| {
+            opt.language_mode = LanguageMode::Chinese;
+            opt.character_form = form;
+        });
+        self.reset_shift_gesture();
+        self.f_key_state = kanata_layer::FKeyState::Up;
+        self.f_event = None;
+        self.chewing_editor = editor;
+        self.lang_mode.set(TsfLangMode::Chinese);
+        self.pending_lang_mode_change.set(true);
+        self.recovery_open_pending.set(true);
+        self.hide_candidates();
+        self.hide_message();
+        self.update_lang_buttons()?;
         Ok(())
     }
 
