+    // A remembered key-down is not evidence that Shift is still physically held.
+    fn reconcile(&mut self, physical_shift: bool, shift_event: bool) -> bool {
+        if !physical_shift && !shift_event { *self = Self::Up; }
+        physical_shift
+    }
