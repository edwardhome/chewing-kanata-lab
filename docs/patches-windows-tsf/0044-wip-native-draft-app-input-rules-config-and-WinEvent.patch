+    fn check_and_apply_app_rule(&mut self) -> Result<bool> {
+        let safe = !self.has_pending_input();
+        let active = self.has_focus;
+        let secure = false; // TSF normal thread focus; secure desktop is handled fail-closed
+
+        let target_mode = {
+            let mgr = self.app_rules_mgr.borrow();
+            mgr.target(safe, active, secure)
+        };
+
+        let Some(rule_mode) = target_mode else {
+            return Ok(false);
+        };
+
+        let desired_lang = match rule_mode {
+            chewing_policy_core::app_input_rules::RuleMode::English => TsfLangMode::English,
+            chewing_policy_core::app_input_rules::RuleMode::Bopomofo => TsfLangMode::Chinese,
+        };
+
+        if self.lang_mode.get() != desired_lang && !self.lang_mode.get().is_disabled() {
+            debug!("Applying app input rule: {:?} -> {:?}", self.lang_mode.get(), desired_lang);
+            self.lang_mode.set(desired_lang);
+            self.pending_lang_mode_change.set(true);
+            self.sync_lang_mode(true)?;
+            return Ok(true);
+        }
+
+        Ok(false)
+    }
