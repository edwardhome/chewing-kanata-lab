@@ -0,0 +1,216 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Windows 前景應用程式追蹤與規則管理 (WinEvent Hook + AppInputRulesTracker)
+//!
+//! 規範與安全要求：
+//! 1. WinEventHook 由啟用線程在同一訊息迴圈線程安裝與反安裝，模組卸載或停用時確保 UnhookWinEvent，絕不殘留活體回呼。
+//! 2. 前景事件僅觀察視窗代號 (HWND) 與行程 (PID)，由行程查詢可執行檔路徑並快取，絕不攔截全域按鍵、字元或視窗標題。
+//! 3. 不在按鍵路徑 (OnKeyDown / OnTestKeyDown) 執行 Win32 行程路徑查詢或 Registry 讀取，完全使用快取。
+//! 4. 使用 `policy_core::app_input_rules::AppInputRulesTracker` 進行世代與造訪追蹤。
+//! 5. 跨行程局限性：本 TSF 為 in-process DLL 模組，各自運行於各宿主行程（如 Notepad, Explorer, Terminal）中。
+//!    在單一行程模式下，各行程內的 TSF 實例透過 WinEvent 獨立監聽全系統前景視窗切換事件，
+//!    當使用者切換至該行程視窗時能即時偵測到自己成為前景，並透過全域註冊表讀取最新規則設定。
+//!    非同行程之間不強求跨行程共用記憶體，若有無法存取之特權行程則 fail-closed 回退，誠實回報限制。
+
+use chewing_policy_core::app_input_rules::{
+    parse_and_validate_rules, AppInputRulesTracker, RuleMode,
+};
+use log::{debug, error};
+use std::cell::RefCell;
+use std::rc::Rc;
+use windows::Win32::Foundation::{CloseHandle, HWND, MAX_PATH};
+use windows::Win32::System::LibraryLoader::GetModuleFileNameW;
+use windows::Win32::System::Threading::{
+    GetCurrentProcessId, OpenProcess, QueryFullProcessImageNameW, PROCESS_NAME_FORMAT,
+    PROCESS_QUERY_LIMITED_INFORMATION,
+};
+use windows::Win32::UI::Accessibility::{SetWinEventHook, UnhookWinEvent, HWINEVENTHOOK};
+use windows::Win32::UI::WindowsAndMessaging::{
+    GetWindowThreadProcessId, EVENT_SYSTEM_FOREGROUND, WINEVENT_OUTOFCONTEXT,
+};
+use windows_core::PWSTR;
+
+thread_local! {
+    static ACTIVE_HOOKS: RefCell<Vec<HWINEVENTHOOK>> = RefCell::new(Vec::new());
+    static GLOBAL_TRACKER: RefCell<Option<Rc<RefCell<AppInputRulesManager>>>> = RefCell::new(None);
+}
+
+pub struct AppInputRulesManager {
+    pub tracker: AppInputRulesTracker,
+    cached_app_id: Option<String>,
+    current_pid: u32,
+    hook: Option<HWINEVENTHOOK>,
+}
+
+impl AppInputRulesManager {
+    pub fn new(enabled: bool, rules_json: &str) -> Rc<RefCell<Self>> {
+        let rules = parse_and_validate_rules(rules_json);
+        let tracker = AppInputRulesTracker::new(enabled, &rules);
+        let current_pid = unsafe { GetCurrentProcessId() };
+
+        // 查詢自己行程的 EXE 路徑作為初始路徑
+        let initial_path = get_current_process_image_path();
+
+        let mut mgr = Self {
+            tracker,
+            cached_app_id: initial_path.clone(),
+            current_pid,
+            hook: None,
+        };
+
+        if let Some(ref path) = initial_path {
+            mgr.tracker.on_foreground_app_changed(Some(path));
+        }
+
+        let rc = Rc::new(RefCell::new(mgr));
+
+        // 註冊為目前線程的全域實例
+        GLOBAL_TRACKER.with(|gt| {
+            *gt.borrow_mut() = Some(rc.clone());
+        });
+
+        // 安裝 EVENT_SYSTEM_FOREGROUND 監聽
+        let hook = unsafe {
+            SetWinEventHook(
+                EVENT_SYSTEM_FOREGROUND,
+                EVENT_SYSTEM_FOREGROUND,
+                None,
+                Some(win_event_proc),
+                0,
+                0,
+                WINEVENT_OUTOFCONTEXT,
+            )
+        };
+
+        if !hook.is_invalid() {
+            rc.borrow_mut().hook = Some(hook);
+            ACTIVE_HOOKS.with(|hooks| hooks.borrow_mut().push(hook));
+            debug!("AppInputRulesManager: WinEventHook installed: {:?}", hook);
+        } else {
+            error!("AppInputRulesManager: failed to install WinEventHook");
+        }
+
+        rc
+    }
+
+    /// 重新載入或更新規則組態（Next-visit-only）
+    pub fn update_config(&mut self, enabled: bool, rules_json: &str) {
+        let rules = parse_and_validate_rules(rules_json);
+        self.tracker.update_config(enabled, &rules);
+    }
+
+    /// 當前景視窗切換時呼叫
+    pub fn on_foreground_window_changed(&mut self, hwnd: HWND) {
+        let mut pid: u32 = 0;
+        unsafe {
+            GetWindowThreadProcessId(hwnd, Some(&mut pid));
+        }
+
+        if pid == 0 {
+            return;
+        }
+
+        // 若 PID 改變或是首次獲取，查詢並正規化執行檔路徑
+        let exe_path = if pid == self.current_pid {
+            get_current_process_image_path()
+        } else {
+            get_process_image_path(pid)
+        };
+
+        if let Some(path) = exe_path {
+            self.cached_app_id = Some(path.clone());
+            self.tracker.on_foreground_app_changed(Some(&path));
+        }
+    }
+
+    /// 目前快取的前景應用程式路徑
+    pub fn current_app_id(&self) -> Option<&str> {
+        self.cached_app_id.as_deref()
+    }
+
+    /// 取得目前 visit 的目標模式
+    pub fn target(&self, safe: bool, active: bool, secure: bool) -> Option<RuleMode> {
+        let generation = self.tracker.current_visit().map(|v| v.generation)?;
+        self.tracker.target(generation, self.cached_app_id.as_deref(), safe, active, secure)
+    }
+
+    /// 使用者手動切換中英文模式
+    pub fn manual_toggle(&mut self, mode: RuleMode) -> bool {
+        if let Some(visit) = self.tracker.current_visit() {
+            let generation = visit.generation;
+            self.tracker.manual(generation, self.cached_app_id.as_deref(), mode)
+        } else {
+            false
+        }
+    }
+}
+
+impl Drop for AppInputRulesManager {
+    fn drop(&mut self) {
+        if let Some(hook) = self.hook.take() {
+            unsafe {
+                let _ = UnhookWinEvent(hook);
+            }
+            ACTIVE_HOOKS.with(|hooks| {
+                hooks.borrow_mut().retain(|&h| h != hook);
+            });
+            debug!("AppInputRulesManager: WinEventHook unhooked: {:?}", hook);
+        }
+        GLOBAL_TRACKER.with(|gt| {
+            *gt.borrow_mut() = None;
+        });
+    }
+}
+
+/// WinEvent 回呼函式
+unsafe extern "system" fn win_event_proc(
+    _h_win_event_hook: HWINEVENTHOOK,
+    event: u32,
+    hwnd: HWND,
+    _id_object: i32,
+    _id_child: i32,
+    _id_event_thread: u32,
+    _dwms_event_time: u32,
+) {
+    if event == EVENT_SYSTEM_FOREGROUND && !hwnd.is_invalid() {
+        GLOBAL_TRACKER.with(|gt| {
+            if let Some(mgr_rc) = gt.borrow().as_ref() {
+                if let Ok(mut mgr) = mgr_rc.try_borrow_mut() {
+                    mgr.on_foreground_window_changed(hwnd);
+                }
+            }
+        });
+    }
+}
+
+/// 取得當前模組/行程的執行檔絕對路徑
+fn get_current_process_image_path() -> Option<String> {
+    let mut buffer = [0u16; MAX_PATH as usize * 2];
+    let len = unsafe { GetModuleFileNameW(None, &mut buffer) as usize };
+    if len == 0 {
+        return None;
+    }
+    String::from_utf16(&buffer[..len]).ok()
+}
+
+/// 透過 PID 查詢該行程的完整執行檔路徑（QueryFullProcessImageNameW）
+fn get_process_image_path(pid: u32) -> Option<String> {
+    unsafe {
+        let handle = match OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) {
+            Ok(h) => h,
+            Err(_) => return None, // 權限不足或系統行程，fail-closed
+        };
+
+        let mut buffer = [0u16; MAX_PATH as usize * 2];
+        let mut size = buffer.len() as u32;
+        let pwpath = PWSTR::from_raw(buffer.as_mut_ptr());
+
+        let res = QueryFullProcessImageNameW(handle, PROCESS_NAME_FORMAT(0), pwpath, &mut size);
+        let _ = CloseHandle(handle);
+
+        if res.is_ok() && size > 0 {
+            String::from_utf16(&buffer[..size as usize]).ok()
+        } else {
+            None
+        }
+    }
+}
