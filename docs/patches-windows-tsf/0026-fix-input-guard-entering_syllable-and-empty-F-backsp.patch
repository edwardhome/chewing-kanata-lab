+    #[test]
+    fn test_production_handoff_with_real_editor_states() {
+        let lexicon = TechnicalLexicon::default();
+
+        // Case 1: Incomplete syllable active (user typed 'h' -> 'ㄘ')
+        // In this state, editor.entering_syllable() is true!
+        let mut editor_incomplete = Editor::fallback();
+        let ev_h = KeyboardEvent {
+            code: chewing::input::keycode::KEY_H,
+            ksym: chewing::input::keysym::SYM_LOWER_H,
+            state: 0,
+        };
+        editor_incomplete.process_keyevent(ev_h);
+        assert!(editor_incomplete.entering_syllable(), "entering_syllable must be true after typing 'h'");
+        assert_eq!(editor_incomplete.syllable_buffer_display(), "ㄘ");
+
+        // Production helper refuses transition:
+        let refused_f = evaluate_f_layer_handoff(
+            &mut editor_incomplete,
+            0x4A, // VK_J ('5')
+            None,
+            false,
+        );
+        assert_eq!(refused_f, HandoffDecision::Refuse, "F handoff MUST be refused when incomplete syllable is active");
+        // Verify syllable buffer was NOT swallowed
+        assert_eq!(editor_incomplete.syllable_buffer_display(), "ㄘ");
+
+        let refused_shift = evaluate_shift_letter_handoff(
+            &mut editor_incomplete,
+            'A',
+            false,
+            &lexicon,
+        );
+        assert_eq!(refused_shift, HandoffDecision::Refuse, "Shift handoff MUST be refused when incomplete syllable is active");
+        assert_eq!(editor_incomplete.syllable_buffer_display(), "ㄘ");
+
+        // Case 2: Resolved Chinese phrase (clean editor or committed phrase)
+        // With an empty or fully resolved editor, entering_syllable() is false.
+        let mut editor_resolved = Editor::fallback();
+        assert!(!editor_resolved.entering_syllable());
+
+        let accepted_f = evaluate_f_layer_handoff(
+            &mut editor_resolved,
+            0x4A, // VK_J ('5')
+            None,
+            false,
+        );
+        let HandoffDecision::Accept { commit, preedit } = accepted_f else {
+            panic!("expected Accept for valid F symbol on resolved editor, got {accepted_f:?}");
+        };
+        assert_eq!(commit, "");
+        assert_eq!(preedit, "5");
+
+        // Case 3: Empty F + Backspace produces NO symbol and MUST NOT confirm Chinese
+        let mut editor_for_bs = Editor::fallback();
+        let empty_f_bs = evaluate_f_layer_handoff(
+            &mut editor_for_bs,
+            0x08, // Backspace
+            None, // empty buffer
+            false,
+        );
+        assert_eq!(empty_f_bs, HandoffDecision::Refuse, "F+Backspace on empty layer MUST be refused and not commit Chinese");
+
+        // Case 4: Shift letter produces valid English session without silent if-let
+        let mut editor_shift = Editor::fallback();
+        let accepted_shift = evaluate_shift_letter_handoff(
+            &mut editor_shift,
+            'A',
+            false,
+            &lexicon,
+        );
+        let HandoffDecision::Accept { commit: s_commit, preedit: s_preedit } = accepted_shift else {
+            panic!("expected Accept for Shift+'A', got {accepted_shift:?}");
+        };
+        assert_eq!(s_commit, "");
+        assert_eq!(s_preedit, "A");
+
+        // Case 5: Short Shift+F handoff when resolved
+        let accepted_shift_f = evaluate_replay_f_tap(
+            &mut editor_shift,
+            true, // shifted
+            false, // shift_released
+            &lexicon,
+        );
+        let HandoffDecision::Accept { commit: f_commit, preedit: f_preedit } = accepted_shift_f else {
+            panic!("expected Accept for Short Shift+F, got {accepted_shift_f:?}");
+        };
+        assert_eq!(f_commit, "");
+        assert_eq!(f_preedit, "F");
+
+        // Case 6: Short Shift+F handoff when incomplete syllable is active -> MUST refuse
+        let mut editor_f_incomplete = Editor::fallback();
+        editor_f_incomplete.process_keyevent(ev_h);
+        assert!(editor_f_incomplete.entering_syllable());
+        let refused_shift_f = evaluate_replay_f_tap(
+            &mut editor_f_incomplete,
+            true,
+            false,
+            &lexicon,
+        );
+        assert_eq!(refused_shift_f, HandoffDecision::Refuse, "Short Shift+F MUST refuse handoff when incomplete syllable is active");
+        assert_eq!(editor_f_incomplete.syllable_buffer_display(), "ㄘ");
+    }
+
