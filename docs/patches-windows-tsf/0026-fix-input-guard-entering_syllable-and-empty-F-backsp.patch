+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) enum HandoffDecision {
+    Refuse,
+    Accept { commit: String, preedit: String },
+}
+
+pub(super) fn evaluate_f_layer_handoff(
+    editor: &mut Editor,
+    vk: u16,
+    existing_f_buffer: Option<&FCompositionBuffer>,
+    was_held: bool,
+) -> HandoffDecision {
+    if editor.entering_syllable() {
+        return HandoffDecision::Refuse;
+    }
+    let is_backspace = vk == 0x08;
+    let mapped_symbol = kanata_layer::map_kanata_number_layer(vk);
+    let has_existing = existing_f_buffer.is_some_and(|b| !b.symbols().is_empty());
+    if is_backspace && !has_existing {
+        return HandoffDecision::Refuse;
+    }
+
+    let mut commit = String::new();
+    if !was_held && !editor.is_empty() {
+        if editor.commit().is_ok() {
+            commit = editor.display_commit().to_owned();
+            if !commit.is_empty() {
+                editor.ack();
+            }
+        }
+    }
+    let preedit = mapped_symbol.unwrap_or("").to_string();
+    HandoffDecision::Accept { commit, preedit }
+}
+
+pub(super) fn evaluate_shift_letter_handoff(
+    editor: &mut Editor,
+    letter: char,
+    _shift_released: bool,
+    lexicon: &TechnicalLexicon,
+) -> HandoffDecision {
+    if editor.entering_syllable() {
+        return HandoffDecision::Refuse;
+    }
+    let mut commit = String::new();
+    if !editor.is_empty() {
+        if editor.commit().is_ok() {
+            commit = editor.display_commit().to_owned();
+            if !commit.is_empty() {
+                editor.ack();
+            }
+        }
+    }
+    let session = ShiftLetterSession::start_with_letter(letter, lexicon);
+    let preedit = session.composition.display().to_string();
+    HandoffDecision::Accept { commit, preedit }
+}
+
+pub(super) fn evaluate_replay_f_tap(
+    editor: &mut Editor,
+    shifted: bool,
+    shift_released: bool,
+    lexicon: &TechnicalLexicon,
+) -> HandoffDecision {
+    if shifted {
+        if editor.entering_syllable() {
+            return HandoffDecision::Refuse;
+        }
+        let mut commit = String::new();
+        if !editor.is_empty() {
+            if editor.commit().is_ok() {
+                commit = editor.display_commit().to_owned();
+                if !commit.is_empty() {
+                    editor.ack();
+                }
+            }
+        }
+        let mut session = ShiftLetterSession::start_with_letter('F', lexicon);
+        if shift_released {
+            session.mode = ShiftMode::Word;
+        }
+        let preedit = session.composition.display().to_string();
+        HandoffDecision::Accept { commit, preedit }
+    } else {
+        HandoffDecision::Refuse
+    }
+}
