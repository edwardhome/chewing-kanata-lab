 //!
 //! 1. 純 Rust 標準庫實作 (std::net::TcpStream)，不依賴龐大 async runtime，確保 TSF DLL 輕量穩定。
 //! 2. 獨立背景 Worker 執行緒，透過非同步 mpsc channel 傳遞，絕不阻塞輸入法打字按鍵主迴圈。
-//! 3. 嚴格白名單檢驗：AI 僅允許在既有合法候選字中推薦，若包含非法或捏造字元一律丟棄。
-//! 4. 版本戳記保護 (Revision Guard)：逾時 (預設 120ms) 或使用者繼續打字時，自動丟棄過期預測結果。
+//! 3. 沙盒環境安全守護 (Sandbox Detection Guard)：若當前宿主為 Chromium/Electron 沙盒程序
+//!    (如 Antigravity, Chrome, VSCode)，嚴禁發起 In-Process 網路連線，徹底根除 0xc0000409 崩潰。
+//! 4. 嚴格白名單檢驗：AI 僅允許在既有合法候選字中推薦，若包含非法或捏造字元一律丟棄。
+//! 5. 版本戳記保護 (Revision Guard)：逾時 (預設 120ms) 或使用者繼續打字時，自動丟棄過期預測結果。
 
 use std::io::{Read, Write};
 use std::net::{SocketAddr, TcpStream};
+use std::panic::catch_unwind;
 use std::sync::atomic::{AtomicU64, Ordering};
 use std::sync::mpsc::{self, Receiver, Sender};
 use std::sync::Arc;
 use std::thread;
 use std::time::Duration;
 use log::debug;
+use windows::Win32::System::LibraryLoader::GetModuleFileNameW;
 
 #[derive(Debug, Clone)]
 pub(crate) struct RerankRequest {
@@ -32,26 +36,51 @@ pub(crate) struct AiRerankerClient {
     tx: Sender<RerankRequest>,
     rx: Receiver<RerankResult>,
     current_revision: Arc<AtomicU64>,
+    is_sandboxed: bool,
+}
+
+/// 偵測當前載入 DLL 之宿主程式是否為受限制的沙盒環境
+pub(crate) fn is_sandboxed_or_restricted_process() -> bool {
+    let mut buf = [0u16; 512];
+    let len = unsafe { GetModuleFileNameW(None, &mut buf) };
+    if len > 0 {
+        let path = String::from_utf16_lossy(&buf[..len as usize]).to_lowercase();
+        if path.contains("antigravity")
+            || path.contains("chrome")
+            || path.contains("msedge")
+            || path.contains("electron")
+            || path.contains("code.exe")
+        {
+            return true;
+        }
+    }
+    false
 }
 
 impl AiRerankerClient {
     pub fn new() -> Self {
+        let is_sandboxed = is_sandboxed_or_restricted_process();
         let (req_tx, req_rx) = mpsc::channel::<RerankRequest>();
         let (res_tx, res_rx) = mpsc::channel::<RerankResult>();
         let current_revision = Arc::new(AtomicU64::new(0));
-        let rev_clone = Arc::clone(&current_revision);
 
-        thread::Builder::new()
-            .name("chewing-ai-reranker".into())
-            .spawn(move || {
-                worker_loop(req_rx, res_tx, rev_clone);
-            })
-            .expect("Failed to spawn ai reranker thread");
+        // 僅在非沙盒安全環境下啟動背景連線執行緒，防止 Antigravity/Chrome 觸發 0xc0000409 閃退
+        if !is_sandboxed {
+            let rev_clone = Arc::clone(&current_revision);
+            let _ = thread::Builder::new()
+                .name("chewing-ai-reranker".into())
+                .spawn(move || {
+                    let _ = catch_unwind(move || {
+                        worker_loop(req_rx, res_tx, rev_clone);
+                    });
+                });
+        }
 
         Self {
             tx: req_tx,
             rx: res_rx,
             current_revision,
+            is_sandboxed,
         }
     }
 
