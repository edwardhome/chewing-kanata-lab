-    pending_edit: Weak<RefCell<Option<CompositionString>>>,
+    pending_queue: Rc<RefCell<PendingTransitionQueue>>,
+    pending_session: Weak<()>,
 }
 
 impl ChewingTextService {
@@ -333,7 +329,8 @@ impl ChewingTextService {
             notification: Default::default(),
             candidate_list: Default::default(),
             composition: Default::default(),
-            pending_edit: Weak::new(),
+            pending_queue: Rc::new(RefCell::new(PendingTransitionQueue::new())),
+            pending_session: Weak::new(),
             pending_lang_mode_change: Cell::new(false),
             recovery_gate: RecoveryGate::default(),
             recovery_open_pending: Cell::new(false),
@@ -416,7 +413,10 @@ impl ChewingTextService {
         self.is_composing() || !self.chewing_editor.is_empty()
             || !self.chewing_editor.syllable_buffer_display().is_empty()
             || self.chewing_editor.is_selecting() || self.shift_session.is_some()
-            || self.f_buffer.is_some() || self.pending_edit.upgrade().is_some()
+            || self.f_buffer.is_some()
+            || self.pending_session.upgrade().is_some()
+            || self.pending_queue.borrow().has_pending_commits()
+            || self.pending_queue.borrow().has_unsubmitted_changes()
     }
 
     fn recovery_time_ms() -> Result<u64> {
@@ -1201,11 +1201,8 @@ impl ChewingTextService {
         }
         editor.clear_syllable_editor();
         editor.clear_composition_editor();
-        if let Some(cell) = self.pending_edit.upgrade() {
-            debug!("Clear pending edits to avoid double commits");
-            cell.replace(None);
-        }
-        self.pending_edit = Weak::new();
+        self.pending_queue.borrow_mut().reset();
+        self.pending_session = Weak::new();
         self.composition.replace(None);
         Ok(())
     }
@@ -1558,7 +1555,7 @@ impl ChewingTextService {
     fn end_composition(&mut self, context: &ITfContext) -> Result<()> {
         // Transfer the ownership of this composition to the EndComposition edit session.
         let composition = mem::replace(&mut self.composition, Rc::new(RefCell::new(None)));
-        self.pending_edit = Weak::new();
+        self.pending_session = Weak::new();
         let session = EndComposition::new(context.clone(), composition).into_object();
         request_edit_session(
             context,
@@ -1578,40 +1575,34 @@ impl ChewingTextService {
         cursor: usize,
     ) -> Result<()> {
         debug!("set composition string");
-        let commit = if self.output_simp_chinese {
-            zhconv(commit, Variant::ZhHans).into()
+        let commit: String = if self.output_simp_chinese {
+            zhconv(commit, Variant::ZhHans)
         } else {
-            commit.into()
+            commit.to_string()
         };
-        let preedit = if self.output_simp_chinese {
-            zhconv(preedit, Variant::ZhHans).into()
+        let preedit: String = if self.output_simp_chinese {
+            zhconv(preedit, Variant::ZhHans)
         } else {
-            preedit.into()
+            preedit.to_string()
         };
-        if let Some(cell) = self.pending_edit.upgrade() {
+        self.pending_queue
+            .borrow_mut()
+            .enqueue(&commit, &preedit, segments, cursor);
+
+        if self.pending_session.upgrade().is_some() {
             debug!("Reuse existing edit session");
-            cell.replace(Some(CompositionString {
-                commit,
-                preedit,
-                segments,
-                cursor,
-            }));
         } else {
-            let pending = Rc::new(RefCell::new(Some(CompositionString {
-                commit,
-                preedit,
-                segments,
-                cursor,
-            })));
+            let session_token = Rc::new(());
             let session = SetCompositionString::new(
                 context.clone(),
                 self.composition.clone(),
                 self.composition_sink.clone(),
                 self.input_da_atom.clone(),
-                pending.clone(),
+                self.pending_queue.clone(),
+                session_token.clone(),
             )
             .into_object();
-            self.pending_edit = Rc::downgrade(&pending);
+            self.pending_session = Rc::downgrade(&session_token);
             request_edit_session(
                 context,
                 self.tid,
diff --git a/tip/src/text_service/edit_session.rs b/tip/src/text_service/edit_session.rs
index dc76f77..23f9608 100644
--- a/tip/src/text_service/edit_session.rs
+++ b/tip/src/text_service/edit_session.rs
@@ -18,7 +18,7 @@ use windows::Win32::UI::TextServices::{
 };
 use windows_core::{BOOL, HSTRING, Interface, Param, Result, implement};
 
-use super::chewing::CompositionString;
+use super::pending_transition::PendingTransitionQueue;
 
 pub(crate) fn request_edit_session(
     context: &ITfContext,
@@ -88,7 +88,8 @@ pub(super) struct SetCompositionString {
     composition: Rc<RefCell<Option<ITfComposition>>>,
     composition_sink: ITfCompositionSink,
     da_atom: [VARIANT; 2],
-    pending: Rc<RefCell<Option<CompositionString>>>,
+    pending_queue: Rc<RefCell<PendingTransitionQueue>>,
+    _session_token: Rc<()>,
 }
 
 impl SetCompositionString {
@@ -97,14 +98,16 @@ impl SetCompositionString {
         composition: Rc<RefCell<Option<ITfComposition>>>,
         composition_sink: ITfCompositionSink,
         da_atom: [VARIANT; 2],
-        pending: Rc<RefCell<Option<CompositionString>>>,
+        pending_queue: Rc<RefCell<PendingTransitionQueue>>,
