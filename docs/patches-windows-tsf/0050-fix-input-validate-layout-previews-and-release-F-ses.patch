     // Display only. Neither the native editor nor the ASCII base is modified.
     fn render_f_preview(&mut self, context: &ITfContext) -> Result<()> {
         let Some(event) = self.f_event else { return Ok(()); };
         let (base,cursor,insert) = if let Some(session) = self.f_buffer.as_ref().and_then(|b| b.base.as_ref()) {
             (session.composition.raw.clone(),session.composition.cursor,"f".to_string())
         } else if self.lang_mode.get() == TsfLangMode::Chinese {
-            let mut syllable = syl_editor_from_kbtype(self.kbtype);
-            syllable.key_press(event.to_keyboard_event(self.keymap));
-            let text = syllable.to_string();
-            // Layouts where F is not a phonetic key retain its literal preview.
-            let text = if text.is_empty() { (event.ascii_code as char).to_string() } else { text };
+            let text = phonetic_f_preview(self.kbtype,event.to_keyboard_event(self.keymap)).unwrap_or_default();
             (self.chewing_editor.intervals().map(|i| i.text).collect::<String>(),self.chewing_editor.cursor(),text)
         } else {
             (String::new(),0,if event.ascii_code == b'F' { "F" } else { "f" }.to_string())
@@ -2808,6 +2822,13 @@ fn can_handle_configured_f_layer(editor: &Editor, vk: u16, has_symbols: bool, ma
             || (vk == 0x08 && has_symbols))
 }
 
+fn phonetic_f_preview(kbtype: KeyboardLayoutCompat, event: KeyboardEvent) -> Option<String> {
+    let mut syllable = syl_editor_from_kbtype(kbtype);
+    syllable.key_press(event);
+    let text = syllable.to_string();
+    (!text.is_empty()).then_some(text)
+}
