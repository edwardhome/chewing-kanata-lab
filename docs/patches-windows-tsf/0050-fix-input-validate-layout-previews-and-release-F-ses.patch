+
+#[cfg(test)]
+mod reversible_f_native_tests {
+    use super::*;
+    fn f_event() -> SystemKeyboardEvent {
+        SystemKeyboardEvent { vk:0x46, repeating:false, scan_code:0x21, ascii_code:b'f', key_state:[0;256] }
+    }
+    #[test]
+    fn standard_f_preview_uses_native_reading_without_editing_original() {
+        let editor=Editor::fallback();
+        assert_eq!(phonetic_f_preview(KeyboardLayoutCompat::Default,f_event().to_keyboard_event(KeymapOp::None)),Some("ㄑ".into()));
+        assert!(editor.is_empty());
+        assert!(editor.syllable_buffer_display().is_empty());
+    }
+    #[test]
+    fn alternative_layout_preview_matches_native_engine() {
+        for layout in [KeyboardLayoutCompat::Hsu,KeyboardLayoutCompat::Ibm,KeyboardLayoutCompat::Et,KeyboardLayoutCompat::GinYieh] {
+            let event=f_event().to_keyboard_event(keymap_from_kbtype(layout));
+            let mut editor=Editor::fallback();
+            editor.set_syllable_editor(syl_editor_from_kbtype(layout));
+            editor.process_keyevent(event);
+            let actual=editor.syllable_buffer_display();
+            assert_eq!(phonetic_f_preview(layout,event).unwrap_or_default(),actual,"{layout:?}");
+        }
+    }
