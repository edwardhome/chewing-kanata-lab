 fn syl_editor_from_kbtype(kbtype: KeyboardLayoutCompat) -> Box<dyn SyllableEditor> {
     use zhuyin_layout::*;
     match kbtype {
@@ -3238,3 +3259,29 @@ mod f_and_shift_handoff_tests {
