+        assert!(editor.is_selecting());
+        assert_eq!(editor.cursor(), 1);
+        assert_eq!(full_composition_reading(&editor).as_deref(), Some("ㄘㄜˋ-ㄘㄜˋ"));
+    }
+
+    #[test]
+    fn actual_editor_rejects_unfinished_syllable_after_completed_text() {
+        let mut editor = fixture_editor();
+        type_keys(&mut editor, b"hk4h");
+        assert_eq!(editor.display(), "冊");
+        assert!(editor.entering_syllable());
+        assert_eq!(full_composition_reading(&editor), None);
+    }
+
+    #[test]
+    fn actual_editor_rejects_mixed_symbols_even_when_scalar_count_matches() {
+        let mut editor = fixture_editor();
+        type_keys(&mut editor, b"`1hk4");
+        assert_eq!(editor.display(), "@冊");
+        assert_eq!(editor.symbols().len(), 2);
+        assert_eq!(full_composition_reading(&editor), None);
+    }
+
+    fn client() -> SharedLexicon {
+        let (reply, incoming) = mpsc::sync_channel(1);
+        SharedLexicon { requests: None, reply, incoming, in_flight: false,
+            last_request: None, pending: IdleGate::default(), active: Loaded::default() }
+    }
+
+    #[test]
+    fn received_snapshot_and_failure_wait_until_next_idle_boundary() {
+        let mut client = client();
+        client.in_flight = true;
+        assert!(client.reply.try_send(Loaded { identity: Some(("revision-1".into(), "checksum".into(), true)), index: None }).is_ok());
+        assert!(!client.poll(false));
+        assert!(client.active.identity.is_none());
+        assert!(!client.in_flight);
+        assert!(client.poll(true));
+        assert_eq!(client.active.identity.as_ref().unwrap().0, "revision-1");
+        assert!(client.reply.try_send(Loaded::default()).is_ok());
+        assert!(!client.poll(false));
+        assert!(client.active.identity.is_some());
+        assert!(client.poll(true));
+        assert!(client.active.identity.is_none());
+    }
+
+    #[test]
+    fn requests_are_bounded_and_never_duplicated_in_flight() {
+        let mut client = client();
+        let (requests, incoming) = mpsc::sync_channel(1);
+        client.requests = Some(requests);
+        client.request_refresh();
+        client.request_refresh();
+        let request = incoming.try_recv().unwrap();
+        assert!(incoming.try_recv().is_err());
+        assert!(request.reply.try_send(Loaded::default()).is_ok());
+        assert!(!client.poll(true));
+        client.request_refresh();
+        assert!(incoming.try_recv().is_err());
+    }
+
+    #[test]
+    fn busy_global_worker_can_retry_without_blocking() {
+        let mut client = client();
+        let (requests, incoming) = mpsc::sync_channel(1);
+        assert!(requests.try_send(Request { reply: client.reply.clone() }).is_ok());
+        client.requests = Some(requests);
+        client.request_refresh();
+        assert!(!client.in_flight);
+        assert!(client.last_request.is_none());
+        incoming.try_recv().unwrap();
+        client.request_refresh();
+        assert!(client.in_flight);
+    }
+
+    #[test]
+    fn pending_snapshot_waits_for_idle_and_keeps_latest() {
+        let mut gate = IdleGate::default();
+        gate.receive(1);
+        assert_eq!(gate.take_if_idle(false), None);
+        gate.receive(2);
+        assert_eq!(gate.take_if_idle(false), None);
+        assert_eq!(gate.take_if_idle(true), Some(2));
+        assert_eq!(gate.take_if_idle(true), None);
+    }
+
+    #[test]
+    fn invalid_or_disabled_snapshot_clears_only_at_idle() {
+        let mut gate = IdleGate::default();
+        gate.receive(None::<Arc<LexiconIndex>>);
+        assert!(gate.take_if_idle(false).is_none());
+        assert!(matches!(gate.take_if_idle(true), Some(None)));
+    }
+
