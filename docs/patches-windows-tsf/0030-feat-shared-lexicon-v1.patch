+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 AI-Chewing contributors
+
+//! Read-only deployment reader. No keystrokes or composition text enter the worker.
+//! A single worker pins this DLL until its host application exits. This is required
+//! because its code may still be running after TSF deactivates an individual service.
+//! There is no timer, blocking join on deactivation, or filesystem access on a key path.
+
+use std::sync::{Arc, OnceLock, mpsc::{self, Receiver, SyncSender}};
+use std::time::{Duration, Instant};
+
+use chewing::editor::Editor;
+use chewing::zhuyin::{Bopomofo, Syllable};
+use chewing_policy_core::shared_lexicon::LexiconIndex;
+use chewing_policy_core::shared_lexicon_store::SharedStore;
+use windows::Win32::Foundation::HMODULE;
+use windows::Win32::System::LibraryLoader::{
+    GetModuleHandleExW, GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, GET_MODULE_HANDLE_EX_FLAG_PIN,
+};
+use windows_core::PCWSTR;
+
+const REFRESH_INTERVAL: Duration = Duration::from_secs(5);
+
+#[derive(Clone, Default)]
+struct Loaded {
+    identity: Option<(String, String, bool)>,
+    index: Option<Arc<LexiconIndex>>,
+}
+
+struct Request { reply: SyncSender<Loaded> }
+
+static WORKER: OnceLock<Option<SyncSender<Request>>> = OnceLock::new();
+
+fn load() -> Loaded {
+    let result = (|| -> anyhow::Result<Loaded> {
+        let path = chewing_tip_core::shell::user_dir()?.join("SharedLexicon");
+        let Some(snapshot) = SharedStore::new(path).load()? else { return Ok(Loaded::default()); };
+        let index = if snapshot.enabled {
+            Some(Arc::new(LexiconIndex::new(&snapshot.document)?))
+        } else { None };
+        Ok(Loaded { identity: Some((snapshot.revision, snapshot.checksum, snapshot.enabled)), index })
+    })();
+    result.unwrap_or_else(|_| {
+        // Do not log document contents, private paths, or parser excerpts.
+        log::warn!("shared lexicon unavailable; native candidates remain active");
+        Loaded::default()
+    })
+}
+
+fn start_worker() -> Option<SyncSender<Request>> {
+    let (requests, incoming) = mpsc::sync_channel::<Request>(1);
+    let (start, ready) = mpsc::sync_channel::<bool>(1);
+    // Spawn before pinning so a failed spawn does not leave an unnecessary pin.
+    // Activation still owns the DLL while this startup handshake is in progress.
+    let thread = std::thread::Builder::new().name("shared-lexicon-reader".into()).spawn(move || {
+        if ready.recv() != Ok(true) { return; }
+        while let Ok(request) = incoming.recv() {
+            let _ = request.reply.try_send(load());
+        }
+    }).ok()?;
+    let mut module = HMODULE::default();
+    // FROM_ADDRESS treats this value as an address inside our module, not a string.
+    let pinned = unsafe { GetModuleHandleExW(
+        GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+        PCWSTR(start_worker as *const () as *const u16), &mut module,
+    ) }.is_ok();
+    if !pinned {
+        let _ = start.send(false);
+        // Startup only: the thread cannot have started any I/O yet.
+        let _ = thread.join();
+        return None;
+    }
+    let _ = start.send(true);
+    Some(requests)
+}
+
+/// A pending deployment can be received during composition but never applied then.
+#[derive(Default)]
+struct IdleGate<T> { pending: Option<T> }
+impl<T> IdleGate<T> {
+    fn receive(&mut self, value: T) { self.pending = Some(value); }
+    fn take_if_idle(&mut self, idle: bool) -> Option<T> {
+        if idle { self.pending.take() } else { None }
+    }
+}
+
+pub(super) struct SharedLexicon {
+    requests: Option<SyncSender<Request>>,
+    reply: SyncSender<Loaded>,
+    incoming: Receiver<Loaded>,
+    in_flight: bool,
+    last_request: Option<Instant>,
+    pending: IdleGate<Loaded>,
+    active: Loaded,
+}
+
+impl SharedLexicon {
+    /// Called only at activation, outside the key callback.
+    pub(super) fn new() -> Self {
+        let requests = WORKER.get_or_init(start_worker).clone();
+        let (reply, incoming) = mpsc::sync_channel(1);
+        let mut this = Self { requests, reply, incoming, in_flight: false,
+            last_request: None, pending: IdleGate::default(), active: Loaded::default() };
+        this.request_refresh();
+        this
+    }
+
+    /// Bounded, nonblocking notification; no per-instance polling thread or timer.
+    pub(super) fn request_refresh(&mut self) {
+        if self.in_flight || self.last_request.is_some_and(|at| at.elapsed() < REFRESH_INTERVAL) { return; }
+        let Some(requests) = &self.requests else { return; };
+        if requests.try_send(Request { reply: self.reply.clone() }).is_ok() {
+            self.in_flight = true;
+            self.last_request = Some(Instant::now());
+        }
+    }
+
+    /// Cheap channel poll. A changed index is adopted only before a new composition.
+    pub(super) fn poll(&mut self, idle: bool) -> bool {
+        if let Ok(loaded) = self.incoming.try_recv() {
+            self.in_flight = false;
+            self.pending.receive(loaded);
+        }
+        let Some(loaded) = self.pending.take_if_idle(idle) else { return false; };
+        if loaded.identity == self.active.identity { return false; }
+        self.active = loaded;
+        true
+    }
+
+    pub(super) fn index(&self) -> Option<Arc<LexiconIndex>> { self.active.index.clone() }
+}
+
+fn canonical_syllable(mut syllable: Syllable) -> String {
+    // Some layouts encode an explicit first tone. Shared schema uses no tone mark
+    // for that tone; all other tones (including final neutral tone) are retained.
+    if syllable.tone() == Some(Bopomofo::TONE1) { syllable.remove_tone(); }
+    syllable.to_string()
+}
+
+/// Exact whole-composition readings only; never infer pronunciation from Han text.
+pub(super) fn full_composition_reading(editor: &Editor) -> Option<String> {
+    if editor.entering_syllable() { return None; }
+    let symbols = editor.symbols();
+    if !(1..=8).contains(&symbols.len()) || editor.display().chars().count() != symbols.len() {
+        return None;
+    }
+    let syllables: Option<Vec<_>> = symbols.iter().map(|symbol| symbol.to_syllable()).collect();
+    Some(syllables?.into_iter().map(canonical_syllable).collect::<Vec<_>>().join("-"))
+}
+
