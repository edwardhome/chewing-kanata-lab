+        EditorBuilder::new().string_table(strings).static_dict(dictionary.build())
+            .symbol_selector(SymbolSelector::new("@\n".as_bytes()).unwrap()).build()
+    }
+
+    fn type_keys(editor: &mut Editor, keys: &[u8]) {
+        for &key in keys { editor.process_keyevent(map_ascii(&QWERTY_MAP, key)); }
+    }
+
