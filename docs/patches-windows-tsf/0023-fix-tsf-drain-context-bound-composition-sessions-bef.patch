+// SPDX-License-Identifier: GPL-3.0-or-later
+//! State belonging to exactly one TSF context/composition lifetime.
+use std::cell::RefCell;
+use std::rc::Rc;
+use windows::Win32::UI::TextServices::{ITfComposition, ITfContext, ITfRange};
+use windows_core::{Interface, IUnknown};
+use super::pending_transition::{PendingTransitionQueue, SubmissionSnapshot};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum ApplyPhase { Idle, BeforeWrite, WriteAttempted, Written, Retired, Ending, Ended }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum SessionFailure { BeforeWrite, UncertainWrite, EndFailed, Interrupted, Invariant }
+
+/// This is the production lifecycle adapter; tests run without COM mocks or host text.
+pub(super) struct SessionControl {
+    pub queue: PendingTransitionQueue,
+    active: bool,
+    scheduled: bool,
+    running: bool,
+    end_requested: bool,
+    phase: ApplyPhase,
+    failed: Option<SessionFailure>,
+    snapshot: Option<SubmissionSnapshot>,
+}
+impl SessionControl {
+    pub fn new() -> Self {
+        Self { queue: PendingTransitionQueue::new(), active: true, scheduled: false,
+            running: false, end_requested: false, phase: ApplyPhase::Idle, failed: None, snapshot: None }
+    }
+    pub fn enqueue(&mut self, commit: &str, preedit: &str, segments: Vec<(usize, usize)>, cursor: usize) -> bool {
+        if !self.active { return false; }
+        // Preserve incoming text even in quarantine. Failure is reported to the caller,
+        // but text is never silently discarded or applied to a different context.
+        self.end_requested = false;
+        self.queue.enqueue(commit, preedit, segments, cursor);
+        self.failed.is_none()
+    }
+    pub fn request_end(&mut self) { if self.active { self.end_requested = true; } }
+    pub fn has_work(&self) -> bool {
+        self.queue.has_unsubmitted_changes() || self.end_requested || self.queue.is_in_flight()
+            || self.queue.has_pending_commits() || self.failed.is_some()
+    }
+    pub fn schedule(&mut self) -> bool {
+        if !self.active || self.failed.is_some() || self.scheduled || self.running || !self.has_work() { return false; }
+        self.scheduled = true;
+        true
+    }
+    pub fn request_failed(&mut self) {
+        // A request may execute synchronously. Do not roll back a completed callback.
+        if self.scheduled && !self.running {
+            self.scheduled = false;
+            self.failed = Some(SessionFailure::BeforeWrite);
+        }
+    }
+    pub fn begin_callback(&mut self) -> bool {
+        if !self.scheduled || self.running || !self.active || self.failed.is_some() { return false; }
+        self.scheduled = false;
+        self.running = true;
+        true
+    }
+    pub fn begin_submission(&mut self) -> Option<SubmissionSnapshot> {
+        if !self.active || self.failed.is_some() { return None; }
+        let snapshot = self.queue.begin_submission();
+        if let Some(value) = &snapshot {
+            self.snapshot = Some(value.clone());
+            self.phase = ApplyPhase::BeforeWrite;
+        } else if self.queue.has_unsubmitted_changes() && !self.queue.is_in_flight() {
+            self.failed = Some(SessionFailure::Invariant); // exhausted generation; never spin
+        }
+        snapshot
+    }
+    pub fn mark_write_attempted(&mut self) { self.phase = ApplyPhase::WriteAttempted; }
+    pub fn mark_written(&mut self) { self.phase = ApplyPhase::Written; }
+    pub fn retire(&mut self, generation: u64) -> bool {
+        if !self.active || self.failed.is_some() || !self.queue.acknowledge_success(generation) {
+            self.failed = Some(SessionFailure::Invariant);
+            return false;
+        }
+        self.snapshot = None;
+        self.phase = ApplyPhase::Retired;
+        true
+    }
+    pub fn fail(&mut self) {
+        if self.failed.is_some() { return; }
+        self.failed = Some(match self.phase {
+            ApplyPhase::Idle | ApplyPhase::BeforeWrite => {
+                if let Some(snapshot) = &self.snapshot { self.queue.acknowledge_failure(snapshot.generation); }
+                SessionFailure::BeforeWrite
+            }
+            ApplyPhase::WriteAttempted | ApplyPhase::Written => SessionFailure::UncertainWrite,
+            ApplyPhase::Ending => SessionFailure::EndFailed,
+            ApplyPhase::Retired | ApplyPhase::Ended => return,
+        });
+    }
+    pub fn invalidate(&mut self) {
+        self.active = false;
+        self.scheduled = false;
+        if self.queue.is_in_flight() || self.queue.has_pending_commits() || self.queue.has_unsubmitted_changes() {
+            self.failed = Some(SessionFailure::Interrupted);
+        }
+        // Preserve pending text and exact submission phase; never recycle into another context.
+    }
+    pub fn begin_end(&mut self) -> bool {
+        if !self.active || self.failed.is_some() || !self.end_requested || self.queue.is_in_flight()
+            || self.queue.has_unsubmitted_changes() || self.queue.has_pending_commits() { return false; }
+        self.end_requested = false;
+        self.phase = ApplyPhase::Ending;
+        true
+    }
+    pub fn complete_end(&mut self) {
+        if !self.active { return; }
+        self.scheduled = false;
+        // New input may have arrived reentrantly while EndComposition was executing.
+        self.active = self.queue.has_unsubmitted_changes() || self.end_requested;
+        self.phase = if self.active { ApplyPhase::Idle } else { ApplyPhase::Ended };
+    }
+    pub fn finish_callback(&mut self) { self.running = false; }
+    pub fn retry_before_write(&mut self) -> bool {
+        if self.active && !self.running && self.failed == Some(SessionFailure::BeforeWrite) {
+            self.failed = None;
+            self.snapshot = None;
+            self.phase = ApplyPhase::Idle;
+            return true;
+        }
+        false
+    }
+}
+
+pub(super) struct CompositionSession {
+    pub context: ITfContext,
+    pub composition: Rc<RefCell<Option<ITfComposition>>>,
+    pub control: RefCell<SessionControl>,
+    notifications: Rc<RefCell<Vec<(ITfComposition, Option<IUnknown>)>>>,
+    context_identity: Option<IUnknown>,
+    composition_identity: RefCell<Option<(ITfComposition, Option<IUnknown>)>>,
+    // Retain the written range if a later operation failed. It must never be replayed blindly.
+    pub written_range: RefCell<Option<ITfRange>>,
+}
+impl CompositionSession {
+    pub fn new(context: ITfContext, composition: Rc<RefCell<Option<ITfComposition>>>,
+        notifications: Rc<RefCell<Vec<(ITfComposition, Option<IUnknown>)>>>) -> Rc<Self> {
+        let context_identity = context.cast::<IUnknown>().ok();
+        let initial = composition.borrow().clone();
+        let composition_identity = initial.map(|value| {
+            let identity = value.cast::<IUnknown>().ok();
+            (value, identity)
+        });
+        let state = Rc::new(Self { context, composition, control: RefCell::new(SessionControl::new()), notifications,
+            context_identity, composition_identity: RefCell::new(composition_identity),
+            written_range: RefCell::new(None) });
+        // QueryInterface above may have delivered synchronous termination notifications.
+        state.is_active();
+        state
+    }
+    pub fn same_context(&self, context: &ITfContext) -> bool {
+        if self.context.as_raw() == context.as_raw() { return true; }
+        let other = context.cast::<IUnknown>().ok();
+        self.is_active();
+        self.context_identity.as_ref().zip(other.as_ref()).is_some_and(|(a, b)| a == b)
+    }
+    pub fn owns_composition(&self, composition: &ITfComposition) -> bool {
+        let current = self.composition.borrow().clone();
+        let Some(current) = current else { return false; };
+        if current.as_raw() == composition.as_raw() { return true; }
+        let identity = self.composition_identity.borrow().clone();
+        let other = composition.cast::<IUnknown>().ok();
+        self.is_active();
+        identity.as_ref().and_then(|(_, identity)| identity.as_ref())
+            .zip(other.as_ref()).is_some_and(|(a, b)| a == b)
+    }
+    pub fn observe_composition(&self, composition: &ITfComposition) -> bool {
+        // Cache identity once before publishing a newly created composition. Read notifications
+        // AFTER QueryInterface so a synchronous termination during that call is not missed.
+        let identity = composition.cast::<IUnknown>().ok();
+        self.composition_identity.replace(Some((composition.clone(), identity.clone())));
+        if self.was_terminated(composition, identity.as_ref()) { self.invalidate(); }
+        self.control.borrow().active
+    }
+    fn was_terminated(&self, composition: &ITfComposition, identity: Option<&IUnknown>) -> bool {
+        let notifications = self.notifications.borrow().clone();
+        notifications.iter().any(|(ended, ended_identity)| {
+            ended.as_raw() == composition.as_raw()
+                || identity.zip(ended_identity.as_ref()).is_some_and(|(a, b)| a == b)
+        })
+    }
+    pub fn is_active(&self) -> bool {
+        // This validity check never invokes COM. It is safe immediately before a write.
+        let composition = self.composition.borrow().clone();
+        let cached = self.composition_identity.borrow().clone();
+        if let Some(composition) = composition {
+            let identity = cached.as_ref().filter(|(cached, _)| cached.as_raw() == composition.as_raw())
+                .and_then(|(_, identity)| identity.as_ref());
+            if self.was_terminated(&composition, identity) { self.invalidate(); }
+        }
+        self.control.borrow().active
+    }
+    pub fn is_failed(&self) -> bool { self.control.borrow().failed.is_some() }
+    pub fn is_busy(&self) -> bool {
+        let state = self.control.borrow();
+        state.scheduled || state.running || state.has_work() || state.queue.is_in_flight() || state.failed.is_some()
+    }
+    pub fn has_work(&self) -> bool { self.control.borrow().has_work() }
+    pub fn is_ending(&self) -> bool { self.control.borrow().phase == ApplyPhase::Ending }
+    pub fn enqueue(&self, commit: &str, preedit: &str, segments: Vec<(usize, usize)>, cursor: usize) -> bool {
+        self.is_active() && self.control.borrow_mut().enqueue(commit, preedit, segments, cursor)
+    }
+    pub fn request_end(&self) { self.control.borrow_mut().request_end(); }
+    pub fn invalidate(&self) { self.control.borrow_mut().invalidate(); }
+    pub fn retry_before_write(&self) -> bool {
+        self.is_active() && self.control.borrow_mut().retry_before_write()
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn pending() -> SessionControl {
+        let mut state = SessionControl::new();
+        assert!(state.enqueue("中文", "", vec![], 0));
+        state
+    }
+    #[test]
+    fn commit_then_end_drains_before_ending_in_same_callback() {
+        let mut state = pending(); state.request_end();
+        assert!(state.schedule()); assert!(state.begin_callback());
+        assert!(!state.begin_end());
+        let snapshot = state.begin_submission().unwrap();
+        state.mark_write_attempted(); state.mark_written();
+        assert!(state.retire(snapshot.generation));
+        assert!(state.begin_end()); state.complete_end(); state.finish_callback();
+        assert!(!state.active); assert!(!state.schedule()); assert!(!state.queue.has_pending_commits());
+    }
+    #[test]
+    fn queued_next_preedit_keeps_commit_and_cancels_not_yet_started_end() {
+        let mut state = pending(); state.request_end();
+        assert!(state.enqueue("", "下一字", vec![], 3));
+        state.schedule(); state.begin_callback();
+        let snapshot = state.begin_submission().unwrap();
