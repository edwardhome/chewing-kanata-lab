+    pub(super) fn on_f_hold_tick(&mut self, generation: u32) -> Result<()> {
+        if !self.f_timer.as_ref().is_some_and(|timer| timer.generation == generation) { return Ok(()); }
+        self.f_timer = None;
+        let kanata_layer::FKeyState::Down { started_at, delay, mappings } = self.f_key_state.clone() else { return Ok(()); };
+        // Only elapsed time strictly greater than configured delay enters layer
+        if started_at.elapsed() <= delay { return Ok(()); }
+        let context = match unsafe { self.thread_mgr.GetFocus().and_then(|doc| doc.GetTop()) } {
+            Ok(context) => context,
+            Err(_) => {
+                self.f_key_state = kanata_layer::FKeyState::Cancelled;
+                return Ok(());
+            }
+        };
+        if !self.is_context_mutable(&context).unwrap_or(false) {
+            self.f_key_state = kanata_layer::FKeyState::Cancelled;
+            return Ok(());
+        }
+
+        // Retract preview if active
+        if self.f_preview_active {
+            self.f_preview_active = false;
+            self.update_preedit(&context, String::new())?;
+        }
+
+        self.f_key_state = kanata_layer::FKeyState::Held { delay, mappings };
+        Ok(())
+    }
+
+    fn f_hold_zhuyin_preview(&self) -> String {
