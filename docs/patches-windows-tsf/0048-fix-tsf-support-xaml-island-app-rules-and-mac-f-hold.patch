+            KeyboardLayoutCompat::Default
+            | KeyboardLayoutCompat::Dvorak
+            | KeyboardLayoutCompat::Carpalx
+            | KeyboardLayoutCompat::ColemakDhAnsi
+            | KeyboardLayoutCompat::ColemakDhOrth
+            | KeyboardLayoutCompat::Workman
+            | KeyboardLayoutCompat::Colemak => "ㄑ".to_string(),
+            KeyboardLayoutCompat::Ibm => "ㄑ".to_string(),
+            KeyboardLayoutCompat::GinYieh => "ㄑ".to_string(),
+            KeyboardLayoutCompat::Et => "ㄑ".to_string(),
+            KeyboardLayoutCompat::Et26 => "ㄑ".to_string(),
+            KeyboardLayoutCompat::DachenCp26 => "ㄑ".to_string(),
+            _ => "ㄑ".to_string(),
+        }
+    }
+
