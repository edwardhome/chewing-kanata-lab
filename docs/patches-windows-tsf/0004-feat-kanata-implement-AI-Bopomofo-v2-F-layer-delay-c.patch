+[package]
+name = "chewing_preferences"
+version = "26.9.0"
+edition = "2024"
+description = "AI新酷音輸入法設定"
+
+[[bin]]
+name = "ChewingPreferences"
+path = "src/main.rs"
+
+[dependencies]
+windows = { version = "0.62.2", features = [
+  "Win32_Foundation",
+  "Win32_Graphics_Gdi",
+  "Win32_UI_Controls",
+  "Win32_UI_HiDpi",
+  "Win32_UI_WindowsAndMessaging",
+  "Win32_System_LibraryLoader",
+] }
+windows-core = "0.62.2"
+windows-registry = "0.6.1"
diff --git a/crates/chewing_preferences/src/main.rs b/crates/chewing_preferences/src/main.rs
new file mode 100644
index 0000000..e1675ab
--- /dev/null
+++ b/crates/chewing_preferences/src/main.rs
@@ -0,0 +1,514 @@
+#![windows_subsystem = "windows"]
+
+use std::process::Command;
+use std::sync::Mutex;
+use windows::core::{HSTRING, PCWSTR, w};
+use windows::Win32::Foundation::{COLORREF, HINSTANCE, HWND, LPARAM, LRESULT, WPARAM};
+use windows::Win32::Graphics::Gdi::{
+    COLOR_WINDOW, CreateFontW, CreateSolidBrush, DeleteObject, FW_BOLD, FW_NORMAL,
+    GetSysColorBrush, HBRUSH, HDC, HFONT, SetBkMode, SetTextColor, SYS_COLOR_INDEX, TRANSPARENT,
+    FONT_CHARSET, FONT_CLIP_PRECISION, FONT_OUTPUT_PRECISION, FONT_QUALITY,
+};
+use windows::Win32::System::LibraryLoader::GetModuleHandleW;
+use windows::Win32::UI::Controls::{
+    InitCommonControlsEx, ICC_STANDARD_CLASSES, ICC_UPDOWN_CLASS, TBM_SETPOS, TBM_SETRANGE,
+    TRACKBAR_CLASSW,
+};
+use windows::Win32::UI::HiDpi::{
+    DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2, SetProcessDpiAwarenessContext,
+};
+use windows::Win32::UI::WindowsAndMessaging::{
+    BM_GETCHECK, BM_SETCHECK, CreateWindowExW, DefWindowProcW, DispatchMessageW, GetMessageW,
+    LoadCursorW, MessageBoxW, PostQuitMessage, RegisterClassW, SendMessageW, SetWindowTextW,
+    ShowWindow, TranslateMessage, CS_HREDRAW, CS_VREDRAW, HMENU, IDC_ARROW, MB_ICONINFORMATION,
+    MB_OK, MSG, SW_SHOW, WINDOW_STYLE, WM_COMMAND, WM_CREATE, WM_CTLCOLORBTN, WM_CTLCOLORSTATIC,
+    WM_DESTROY, WM_HSCROLL, WM_SETFONT, WNDCLASSW, WS_CHILD, WS_OVERLAPPEDWINDOW, WS_TABSTOP,
+    WS_VISIBLE,
+};
+use windows_registry::CURRENT_USER;
+
+const REG_KEY: &str = r"Software\ChewingTextService";
+
+// Win32 constants
+const TBM_GETPOS: u32 = 1024;
+const TBS_AUTOTICKS: u32 = 1;
+const BS_PUSHBUTTON: u32 = 0;
+const BS_AUTOCHECKBOX: u32 = 3;
+const BS_GROUPBOX: u32 = 7;
+const BST_UNCHECKED: usize = 0;
+const BST_CHECKED: usize = 1;
+const COLOR_BTNFACE: i32 = 15;
+
+// Control IDs
+const IDC_SLIDER_F: isize = 101;
+const IDC_LABEL_F_VAL: isize = 102;
+const IDC_CHK_AI: isize = 103;
+const IDC_CHK_DEFAULT_ZH: isize = 104;
+const IDC_BTN_OPEN_DICT: isize = 105;
+const IDC_BTN_OPEN_EDITOR: isize = 106;
+const IDC_BTN_SAVE: isize = 107;
+const IDC_BTN_RESET: isize = 108;
+const IDC_BTN_CLOSE: isize = 109;
+
+struct AppState {
+    f_delay_ms: i32,
+    h_slider: HWND,
+    h_lbl_f_val: HWND,
+    h_chk_ai: HWND,
+    h_chk_default_zh: HWND,
+    font_title: HFONT,
+    font_bold: HFONT,
+    font_normal: HFONT,
+    font_mono: HFONT,
+    bg_brush: HBRUSH,
+}
+
+unsafe impl Send for AppState {}
+
+static APP_STATE: Mutex<Option<AppState>> = Mutex::new(None);
+
+#[inline]
+unsafe fn send_msg(hwnd: HWND, msg: u32, wparam: usize, lparam: isize) -> LRESULT {
+    unsafe { SendMessageW(hwnd, msg, Some(WPARAM(wparam)), Some(LPARAM(lparam))) }
+}
+
+unsafe fn make_font(height: i32, bold: bool, name: PCWSTR) -> HFONT {
+    unsafe {
+        CreateFontW(
+            height,
+            0,
+            0,
+            0,
+            if bold { FW_BOLD.0 as i32 } else { FW_NORMAL.0 as i32 },
+            0,
+            0,
+            0,
+            FONT_CHARSET(1),
+            FONT_OUTPUT_PRECISION(0),
+            FONT_CLIP_PRECISION(0),
+            FONT_QUALITY(0),
+            0,
+            name,
+        )
+    }
+}
+
+unsafe fn create_ctrl(
+    class_name: PCWSTR,
+    text: PCWSTR,
+    style: u32,
+    x: i32,
+    y: i32,
+    width: i32,
+    height: i32,
+    parent: HWND,
+    id: isize,
+    hinst: HINSTANCE,
+) -> windows::core::Result<HWND> {
+    unsafe {
+        CreateWindowExW(
+            Default::default(),
+            class_name,
+            text,
+            WINDOW_STYLE(style),
+            x,
+            y,
+            width,
+            height,
+            Some(parent),
+            if id != 0 { Some(HMENU(id as *mut _)) } else { None },
+            Some(hinst),
+            None,
+        )
+    }
+}
+
+fn load_registry_config() -> (i32, bool, bool) {
+    let f_delay = CURRENT_USER
+        .open(REG_KEY)
+        .and_then(|k| k.get_u32("FHoldDelayMs"))
+        .map(|v| (v as i32).clamp(100, 1000))
+        .unwrap_or(350);
+
+    let enable_ai = CURRENT_USER
+        .open(REG_KEY)
+        .and_then(|k| k.get_u32("EnableAI"))
+        .map(|v| v != 0)
+        .unwrap_or(false);
+
+    let default_english = CURRENT_USER
+        .open(REG_KEY)
+        .and_then(|k| k.get_u32("DefaultEnglish"))
+        .map(|v| v != 0)
+        .unwrap_or(false);
+
+    (f_delay, enable_ai, !default_english)
+}
+
+fn save_registry_config(f_delay: i32, enable_ai: bool, default_chinese: bool) {
+    if let Ok(key) = CURRENT_USER.create(REG_KEY) {
+        let _ = key.set_u32("FHoldDelayMs", f_delay as u32);
+        let _ = key.set_u32("EnableAI", if enable_ai { 1 } else { 0 });
+        let _ = key.set_u32("DefaultEnglish", if default_chinese { 0 } else { 1 });
+    }
+}
+
+unsafe extern "system" fn wnd_proc(
+    hwnd: HWND,
+    msg: u32,
+    wparam: WPARAM,
+    lparam: LPARAM,
+) -> LRESULT {
+    match msg {
+        WM_CREATE => {
+            let (f_delay, enable_ai, default_chinese) = load_registry_config();
+            let hinst = unsafe { HINSTANCE(GetModuleHandleW(None).unwrap().0) };
+
+            // Create fonts
+            let font_title = unsafe { make_font(24, true, w!("Microsoft JhengHei UI")) };
+            let font_bold = unsafe { make_font(18, true, w!("Microsoft JhengHei UI")) };
+            let font_normal = unsafe { make_font(16, false, w!("Microsoft JhengHei UI")) };
+            let font_mono = unsafe { make_font(15, false, w!("Consolas")) };
+            let bg_brush = unsafe { CreateSolidBrush(COLORREF(0x00F8F8F8)) };
+
+            // 1. GroupBox: F 鍵分層延遲設定
+            let grp1 = unsafe {
+                create_ctrl(
+                    w!("BUTTON"),
+                    w!("【1】F 鍵長按延遲設定 (F-Hold Delay)"),
+                    WS_CHILD.0 | WS_VISIBLE.0 | WS_TABSTOP.0 | BS_GROUPBOX,
+                    20, 20, 640, 140,
+                    hwnd, 0, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(grp1, WM_SETFONT, font_bold.0 as usize, 1) };
+
+            // Slider
+            let h_slider = unsafe {
+                create_ctrl(
+                    TRACKBAR_CLASSW,
+                    w!(""),
+                    WS_CHILD.0 | WS_VISIBLE.0 | TBS_AUTOTICKS | WS_TABSTOP.0,
+                    40, 55, 380, 40,
+                    hwnd, IDC_SLIDER_F, hinst,
+                ).unwrap()
+            };
+            unsafe {
+                send_msg(h_slider, TBM_SETRANGE, 1, ((1000 << 16) | 100) as isize);
+                send_msg(h_slider, TBM_SETPOS, 1, f_delay as isize);
+            }
+
+            // Label F Value
+            let val_str = HSTRING::from(format!("當前延遲：{} 毫秒", f_delay));
+            let h_lbl_f_val = unsafe {
+                create_ctrl(
+                    w!("STATIC"),
+                    PCWSTR(val_str.as_ptr()),
+                    WS_CHILD.0 | WS_VISIBLE.0,
+                    440, 60, 200, 25,
+                    hwnd, IDC_LABEL_F_VAL, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(h_lbl_f_val, WM_SETFONT, font_bold.0 as usize, 1) };
+
+            // Slider Hint
+            let h_lbl_hint = unsafe {
+                create_ctrl(
+                    w!("STATIC"),
+                    w!("💡 說明：預設 350ms。快速連續打注音 (如「ㄑㄧ」、「ㄑㄩ」) 自動保留注音，絕不輸出數字；按住 F 鍵超過此時間後即啟動右側九宮格數字層。"),
+                    WS_CHILD.0 | WS_VISIBLE.0,
+                    40, 100, 600, 45,
+                    hwnd, 0, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(h_lbl_hint, WM_SETFONT, font_normal.0 as usize, 1) };
+
+            // 2. GroupBox: F 分層功能展示
+            let grp2 = unsafe {
+                create_ctrl(
+                    w!("BUTTON"),
+                    w!("【2】F 分層輸入功能展示 (右手九宮格與算術鍵盤)"),
+                    WS_CHILD.0 | WS_VISIBLE.0 | WS_TABSTOP.0 | BS_GROUPBOX,
+                    20, 175, 640, 205,
+                    hwnd, 0, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(grp2, WM_SETFONT, font_bold.0 as usize, 1) };
+
+            let cheatsheet_text = w!(
+                "┌── 按住 F 鍵 ──┬── 符號與運算 ──┬────── 數字九宮格 ──────┐\n\
+                 │  F + Esc ➜ `  │  F + Q ➜ /     │  F + Y ➜ 7  |  F + U ➜ 8  |  F + I ➜ 9 │\n\
+                 │  F + [   ➜ [  │  F + W ➜ *     │  F + H ➜ 4  |  F + J ➜ 5  |  F + K ➜ 6 │\n\
+                 │  F + ]   ➜ ]  │  F + E ➜ -     │  F + N ➜ 1  |  F + M ➜ 2  |  F + , ➜ 3 │\n\
+                 │  F + O   ➜ {  │  F + R ➜ +     │             |  F + Space ➜ 0          │\n\
+                 └───────────────┴────────────────┴────────────────────────────────────────┘"
+            );
+            let h_lbl_cheat = unsafe {
+                create_ctrl(
+                    w!("STATIC"),
+                    cheatsheet_text,
+                    WS_CHILD.0 | WS_VISIBLE.0,
+                    40, 205, 600, 130,
+                    hwnd, 0, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(h_lbl_cheat, WM_SETFONT, font_mono.0 as usize, 1) };
+
+            let h_lbl_cheat_tip = unsafe {
+                create_ctrl(
+                    w!("STATIC"),
+                    w!("✨ 智慧保護：長按 F 打數字時雙手不離主鍵區；中文模式鍵入「去 (ㄑㄩ)」自動攔截優先，零衝突！"),
+                    WS_CHILD.0 | WS_VISIBLE.0,
+                    40, 345, 600, 25,
+                    hwnd, 0, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(h_lbl_cheat_tip, WM_SETFONT, font_normal.0 as usize, 1) };
+
+            // 3. GroupBox: AI 智慧與詞庫設定
+            let grp3 = unsafe {
+                create_ctrl(
+                    w!("BUTTON"),
+                    w!("【3】AI 智慧組詞與詞庫選項"),
+                    WS_CHILD.0 | WS_VISIBLE.0 | WS_TABSTOP.0 | BS_GROUPBOX,
+                    20, 395, 640, 160,
+                    hwnd, 0, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(grp3, WM_SETFONT, font_bold.0 as usize, 1) };
+
+            let h_chk_ai = unsafe {
+                create_ctrl(
+                    w!("BUTTON"),
+                    w!("啟用 Ollama 本機 AI 智慧組詞 (僅在英文單字組詞時介入，預設關閉)"),
+                    WS_CHILD.0 | WS_VISIBLE.0 | BS_AUTOCHECKBOX | WS_TABSTOP.0,
+                    40, 425, 600, 25,
+                    hwnd, IDC_CHK_AI, hinst,
+                ).unwrap()
+            };
+            unsafe {
+                send_msg(h_chk_ai, WM_SETFONT, font_normal.0 as usize, 1);
+                send_msg(h_chk_ai, BM_SETCHECK, if enable_ai { BST_CHECKED } else { BST_UNCHECKED }, 0);
+            }
+
+            let h_chk_default_zh = unsafe {
+                create_ctrl(
+                    w!("BUTTON"),
+                    w!("開機與切換視窗時預設為「中文注音模式」[中] (雙擊 Shift 可瞬切中英)"),
+                    WS_CHILD.0 | WS_VISIBLE.0 | BS_AUTOCHECKBOX | WS_TABSTOP.0,
+                    40, 455, 600, 25,
+                    hwnd, IDC_CHK_DEFAULT_ZH, hinst,
+                ).unwrap()
+            };
+            unsafe {
+                send_msg(h_chk_default_zh, WM_SETFONT, font_normal.0 as usize, 1);
+                send_msg(h_chk_default_zh, BM_SETCHECK, if default_chinese { BST_CHECKED } else { BST_UNCHECKED }, 0);
+            }
+
+            let h_btn_dict = unsafe {
+                create_ctrl(
+                    w!("BUTTON"),
+                    w!("📖 開啟英文專業名詞詞庫 (technical-terms.txt)"),
+                    WS_CHILD.0 | WS_VISIBLE.0 | BS_PUSHBUTTON | WS_TABSTOP.0,
+                    40, 495, 290, 35,
+                    hwnd, IDC_BTN_OPEN_DICT, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(h_btn_dict, WM_SETFONT, font_normal.0 as usize, 1) };
+
+            let h_btn_editor = unsafe {
+                create_ctrl(
+                    w!("BUTTON"),
+                    w!("🛠️ 開啟使用者詞庫編輯器 (chewing-editor.exe)"),
+                    WS_CHILD.0 | WS_VISIBLE.0 | BS_PUSHBUTTON | WS_TABSTOP.0,
+                    340, 495, 300, 35,
+                    hwnd, IDC_BTN_OPEN_EDITOR, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(h_btn_editor, WM_SETFONT, font_normal.0 as usize, 1) };
+
+            // Bottom Buttons
+            let h_btn_save = unsafe {
+                create_ctrl(
+                    w!("BUTTON"),
+                    w!("💾 套用儲存設定"),
+                    WS_CHILD.0 | WS_VISIBLE.0 | BS_PUSHBUTTON | WS_TABSTOP.0,
+                    300, 570, 150, 40,
+                    hwnd, IDC_BTN_SAVE, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(h_btn_save, WM_SETFONT, font_bold.0 as usize, 1) };
+
+            let h_btn_reset = unsafe {
+                create_ctrl(
+                    w!("BUTTON"),
+                    w!("🔄 恢復預設"),
+                    WS_CHILD.0 | WS_VISIBLE.0 | BS_PUSHBUTTON | WS_TABSTOP.0,
+                    460, 570, 100, 40,
+                    hwnd, IDC_BTN_RESET, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(h_btn_reset, WM_SETFONT, font_normal.0 as usize, 1) };
+
+            let h_btn_close = unsafe {
+                create_ctrl(
+                    w!("BUTTON"),
+                    w!("關閉"),
+                    WS_CHILD.0 | WS_VISIBLE.0 | BS_PUSHBUTTON | WS_TABSTOP.0,
+                    570, 570, 90, 40,
+                    hwnd, IDC_BTN_CLOSE, hinst,
+                ).unwrap()
+            };
+            unsafe { send_msg(h_btn_close, WM_SETFONT, font_normal.0 as usize, 1) };
+
+            *APP_STATE.lock().unwrap() = Some(AppState {
+                f_delay_ms: f_delay,
+                h_slider,
+                h_lbl_f_val,
+                h_chk_ai,
+                h_chk_default_zh,
+                font_title,
+                font_bold,
+                font_normal,
+                font_mono,
+                bg_brush,
+            });
+
+            LRESULT(0)
+        }
+        WM_HSCROLL => {
+            if let Ok(mut guard) = APP_STATE.lock() {
+                if let Some(state) = guard.as_mut() {
+                    let pos = unsafe { send_msg(state.h_slider, TBM_GETPOS, 0, 0) }.0 as i32;
+                    state.f_delay_ms = pos;
+                    let val_str = HSTRING::from(format!("當前延遲：{} 毫秒", pos));
+                    let _ = unsafe { SetWindowTextW(state.h_lbl_f_val, PCWSTR(val_str.as_ptr())) };
+                }
+            }
+            LRESULT(0)
+        }
+        WM_COMMAND => {
+            let id = (wparam.0 & 0xFFFF) as isize;
+            if let Ok(mut guard) = APP_STATE.lock() {
+                if let Some(state) = guard.as_mut() {
+                    match id {
+                        IDC_BTN_SAVE => {
+                            let ai_checked = unsafe { send_msg(state.h_chk_ai, BM_GETCHECK, 0, 0) }.0 == BST_CHECKED as isize;
+                            let zh_checked = unsafe { send_msg(state.h_chk_default_zh, BM_GETCHECK, 0, 0) }.0 == BST_CHECKED as isize;
+                            save_registry_config(state.f_delay_ms, ai_checked, zh_checked);
+                            let _ = unsafe {
+                                MessageBoxW(
+                                    Some(hwnd),
+                                    w!("✅ 設定已成功套用並儲存至 Windows 登錄表！\n新設定已即時生效。"),
+                                    w!("AI新酷音輸入法設定"),
+                                    MB_OK | MB_ICONINFORMATION,
+                                )
+                            };
+                        }
+                        IDC_BTN_RESET => {
+                            state.f_delay_ms = 350;
+                            unsafe {
+                                send_msg(state.h_slider, TBM_SETPOS, 1, 350);
+                                let _ = SetWindowTextW(state.h_lbl_f_val, w!("當前延遲：350 毫秒"));
+                                send_msg(state.h_chk_ai, BM_SETCHECK, BST_UNCHECKED, 0);
+                                send_msg(state.h_chk_default_zh, BM_SETCHECK, BST_CHECKED, 0);
+                            }
+                        }
+                        IDC_BTN_OPEN_DICT => {
+                            let appdata = std::env::var("APPDATA").unwrap_or_default();
+                            let p = format!(r"{}\Chewing\technical-terms.txt", appdata);
+                            let _ = Command::new("notepad.exe").arg(p).spawn();
+                        }
+                        IDC_BTN_OPEN_EDITOR => {
+                            let localappdata = std::env::var("LOCALAPPDATA").unwrap_or_default();
+                            let p = format!(r"{}\Programs\ChewingDev\chewing-editor.exe", localappdata);
+                            let _ = Command::new(p).spawn();
+                        }
+                        IDC_BTN_CLOSE => {
+                            unsafe { PostQuitMessage(0) };
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            LRESULT(0)
+        }
+        WM_CTLCOLORSTATIC | WM_CTLCOLORBTN => {
+            let hdc = HDC(wparam.0 as _);
+            unsafe {
+                SetBkMode(hdc, TRANSPARENT);
+                SetTextColor(hdc, COLORREF(0x00202020));
+            }
+            if let Ok(guard) = APP_STATE.lock() {
+                if let Some(state) = guard.as_ref() {
+                    return LRESULT(state.bg_brush.0 as isize);
+                }
+            }
+            LRESULT(unsafe { GetSysColorBrush(SYS_COLOR_INDEX(COLOR_BTNFACE)) }.0 as isize)
+        }
+        WM_DESTROY => {
+            if let Ok(mut guard) = APP_STATE.lock() {
+                if let Some(state) = guard.take() {
+                    unsafe {
+                        let _ = DeleteObject(state.font_title.into());
+                        let _ = DeleteObject(state.font_bold.into());
+                        let _ = DeleteObject(state.font_normal.into());
+                        let _ = DeleteObject(state.font_mono.into());
+                        let _ = DeleteObject(state.bg_brush.into());
+                    }
+                }
+            }
+            unsafe { PostQuitMessage(0) };
+            LRESULT(0)
+        }
+        _ => unsafe { DefWindowProcW(hwnd, msg, wparam, lparam) },
+    }
+}
+
+fn main() -> windows::core::Result<()> {
+    unsafe {
+        let _ = SetProcessDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+        let icce = windows::Win32::UI::Controls::INITCOMMONCONTROLSEX {
+            dwSize: std::mem::size_of::<windows::Win32::UI::Controls::INITCOMMONCONTROLSEX>() as u32,
+            dwICC: ICC_STANDARD_CLASSES | ICC_UPDOWN_CLASS,
+        };
+        let _ = InitCommonControlsEx(&icce);
+
+        let hinstance = HINSTANCE(GetModuleHandleW(None)?.0);
+        let class_name = w!("AiChewingPreferencesClass");
+
+        let wc = WNDCLASSW {
+            style: CS_HREDRAW | CS_VREDRAW,
+            lpfnWndProc: Some(wnd_proc),
+            hInstance: hinstance,
+            hCursor: LoadCursorW(None, IDC_ARROW)?,
+            hbrBackground: HBRUSH(COLOR_WINDOW.0 as *mut _),
+            lpszClassName: class_name,
+            ..Default::default()
+        };
+
+        RegisterClassW(&wc);
+
+        let hwnd = CreateWindowExW(
+            Default::default(),
+            class_name,
+            w!("AI新酷音輸入法設定"),
+            WS_OVERLAPPEDWINDOW & !windows::Win32::UI::WindowsAndMessaging::WS_MAXIMIZEBOX,
+            150, 150, 695, 665,
+            None,
+            None,
+            Some(hinstance),
+            None,
+        )?;
+
+        let _ = ShowWindow(hwnd, SW_SHOW);
+
+        let mut msg = MSG::default();
+        while GetMessageW(&mut msg, None, 0, 0).as_bool() {
+            let _ = TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+
+        Ok(())
+    }
+}
