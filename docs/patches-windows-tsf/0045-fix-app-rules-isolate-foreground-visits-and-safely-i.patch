+pub struct AppInputRulesManager { hook:Option<Rc<Hook>> }
+impl AppInputRulesManager {
+    pub fn new()->Self {
+        let existing=HOOK.with(|h|h.borrow().upgrade());
+        if let Some(hook)=existing{return Self{hook:Some(hook)};}
+        let mutex=unsafe{CreateMutexW(None,false,w!("Local\\AI-Chewing-AppRules-v1"))};
+        let Ok(mutex)=mutex else{return Self{hook:None};};
+        let reset=unsafe{GetLastError()}!=ERROR_ALREADY_EXISTS;
+        let hook=unsafe{SetWinEventHook(EVENT_SYSTEM_FOREGROUND,EVENT_SYSTEM_FOREGROUND,None,Some(win_event_proc),0,0,WINEVENT_OUTOFCONTEXT)};
+        if hook.is_invalid(){unsafe{let _=CloseHandle(mutex);}return Self{hook:None};}
+        let hook=Rc::new(Hook{hook,mutex});
+        HOOK.with(|slot|*slot.borrow_mut()=Rc::downgrade(&hook));
+        hook.refresh(unsafe{GetForegroundWindow()},unsafe{GetTickCount()},reset,None);
+        Self{hook:Some(hook)}
     }
-}
