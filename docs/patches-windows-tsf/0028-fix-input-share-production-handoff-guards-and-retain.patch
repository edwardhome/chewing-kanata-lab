+// Handoff only resolved text; an unfinished syllable remains owned by the engine.
+// These guards are shared by interception, execution, and real-Editor tests.
+fn can_handoff_to_ascii(editor: &Editor) -> bool {
+    !editor.entering_syllable() && !editor.is_selecting()
 }
 
-pub(super) fn evaluate_replay_f_tap(
-    editor: &mut Editor,
-    shifted: bool,
-    shift_released: bool,
-    lexicon: &TechnicalLexicon,
-) -> HandoffDecision {
-    if shifted {
-        if editor.entering_syllable() {
-            return HandoffDecision::Refuse;
-        }
-        let mut commit = String::new();
-        if !editor.is_empty() {
-            if editor.commit().is_ok() {
-                commit = editor.display_commit().to_owned();
-                if !commit.is_empty() {
-                    editor.ack();
-                }
-            }
-        }
-        let mut session = ShiftLetterSession::start_with_letter('F', lexicon);
-        if shift_released {
-            session.mode = ShiftMode::Word;
-        }
-        let preedit = session.composition.display().to_string();
-        HandoffDecision::Accept { commit, preedit }
-    } else {
-        HandoffDecision::Refuse
-    }
+fn can_handle_f_layer(editor: &Editor, vk: u16, has_symbols: bool) -> bool {
+    can_handoff_to_ascii(editor)
+        && (kanata_layer::map_kanata_number_layer(vk).is_some()
+            || (vk == 0x08 && has_symbols))
 }
 
