+fn open_file_in_notepad(path_str: &str, default_content: &str) {
+    let path = std::path::Path::new(path_str);
+    if let Some(parent) = path.parent() {
+        let _ = std::fs::create_dir_all(parent);
+    }
+    if !path.exists() {
+        let _ = std::fs::write(path, default_content);
