From c545fdbf4e2f9cb3b63758361411a778110425e4 Mon Sep 17 00:00:00 2001
From: Defu <edward61221@gmail.com>
Date: Sun, 8 Nov 2026 20:31:35 +0800
Subject: [PATCH] fix(release): update and track native Windows version
 resources

---
 tip/build.rs      |  1 +
 tip/rc/version.rc | 14 +++++++-------
 2 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/tip/build.rs b/tip/build.rs
index 50d5c08..42f4159 100644
--- a/tip/build.rs
+++ b/tip/build.rs
@@ -4,6 +4,7 @@
 use std::error::Error;
 
 fn main() -> Result<(), Box<dyn Error>> {
+    println!("cargo:rerun-if-changed=rc/version.rc");
     embed_resource::compile_for_everything("rc/ChewingTextService.rc", embed_resource::NONE)
         .manifest_optional()?;
     Ok(())
diff --git a/tip/rc/version.rc b/tip/rc/version.rc
index 38609ec..f07446c 100644
--- a/tip/rc/version.rc
+++ b/tip/rc/version.rc
@@ -1,8 +1,8 @@
-#define VER_FILEVERSION             1,1,0,0
-#define VER_FILEVERSION_STR         "1.1.0.0\0"
-#define VER_PRODUCTVERSION          1,1,0,0
-#define VER_PRODUCTVERSION_STR      "1.1.0.0\0"
-#define ABOUT_CAPTION_WITH_VER      "關於AI新酷音輸入法 (1.1.0.0)\0"
-#define ABOUT_VERSION_STR           "版本：1.1.0.0\0"
+#define VER_FILEVERSION             1,1,1,0
+#define VER_FILEVERSION_STR         "1.1.1.0\0"
+#define VER_PRODUCTVERSION          1,1,1,0
+#define VER_PRODUCTVERSION_STR      "1.1.1.0\0"
+#define ABOUT_CAPTION_WITH_VER      "關於AI新酷音輸入法 (1.1.1.0)\0"
+#define ABOUT_VERSION_STR           "版本：1.1.1.0\0"
 #define ABOUT_RELEASE_DATE_STR      "發行日期：2026 年 11 月 07 日\0"
-#define PREFS_TITLE_WITH_VER        "設定AI新酷音輸入法 (1.1.0.0)\0"
+#define PREFS_TITLE_WITH_VER        "設定AI新酷音輸入法 (1.1.1.0)\0"
