+#[derive(Debug, PartialEq, Eq)]
+enum Command { Register(String), Unregister, Enable, Disable, Stop }
+
+fn parse_command(args: &[String]) -> Option<Command> {
+    match args {
+        [flag, path] if flag == "-r" && !path.is_empty() => Some(Command::Register(path.clone())),
+        [flag] if flag == "-u" => Some(Command::Unregister),
+        [flag] if flag == "-i" => Some(Command::Enable),
+        [flag] if flag == "-d" => Some(Command::Disable),
+        [flag] if flag == "-s" => Some(Command::Stop),
+        _ => None,
+    }
+}
+
