+/// Resolve this module, never the executable of the application hosting the IME.
 pub fn program_dir() -> Result<PathBuf, ShellError> {
-    expect_error("Failed to determine Program Files path", || {
-        Ok(PathBuf::from(
-            std::env::var("ProgramW6432")
-                .or_else(|_| std::env::var("ProgramFiles"))
-                .or_else(|_| std::env::var("ProgramFiles(x86)"))?,
-        )
-        .join("ChewingTextService"))
+    expect_error("Failed to locate the current ChewingDev module", || {
+        use windows::Win32::Foundation::HMODULE;
+        use windows::Win32::System::LibraryLoader::{GetModuleHandleExW, GetModuleFileNameW,
+            GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT};
+        use windows::core::PCWSTR;
+        let mut module = HMODULE::default();
+        unsafe {
+            GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                PCWSTR(program_dir as *const () as *const u16), &mut module)?;
+            let mut buffer = vec![0u16; 32768];
+            let length = GetModuleFileNameW(Some(module), &mut buffer) as usize;
+            if length == 0 || length >= buffer.len() { return Err("Unable to resolve module filename".into()); }
+            let path = PathBuf::from(String::from_utf16(&buffer[..length])?);
+            Ok(path.parent().ok_or("Module has no parent directory")?.to_path_buf())
+        }
+    })
+}
+
+/// Supplying both paths prevents libchewing from consulting the official user's
+/// dictionary or the CHEWING_PATH environment variable inside a host process.
+pub fn isolated_editor() -> Result<chewing::editor::Editor, ShellError> {
+    expect_error("Failed to create isolated ChewingDev editor", || {
+        let user = user_dir()?;
+        let dictionaries = format!("{};{}", user.display(), program_dir()?.join("Dictionary").display());
+        Ok(chewing::editor::Editor::chewing(Some(dictionaries), Some(user.join("chewing.dat").to_string_lossy().into_owned()))?)
     })
 }
 
