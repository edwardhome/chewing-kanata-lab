diff --git a/tip/src/text_service/f_preview.rs b/tip/src/text_service/f_preview.rs
index 162722b..ede5103 100644
--- a/tip/src/text_service/f_preview.rs
+++ b/tip/src/text_service/f_preview.rs
@@ -43,3 +43,37 @@ mod tests {
         assert_eq!(remaining_delay(d+Duration::from_nanos(1),d),None);
     }
 }
+
+/// Keyboard message timestamps share the same wrapping millisecond clock.
+/// A late-dispatched key can precede an already-delivered timer deadline.
+/// Do not compare this clock against Instant or revive an already-used layer.
+pub(super) fn ordinary_key_before_deadline(
+    held: bool, received_elapsed: Duration, delay: Duration,
+    press_time: Option<u32>, key_time: Option<u32>, used: bool,
+) -> bool {
+    if used { return false; }
+    if let Some(elapsed) = press_time.zip(key_time).map(|(start,end)|end.wrapping_sub(start)) {
+        if elapsed <= i32::MAX as u32 {
+            return Duration::from_millis(elapsed as u64) <= delay;
+        }
+    }
+    !held && received_elapsed <= delay
+}
+
+#[cfg(test)]
+mod delivery_order_tests {
+    use super::*;
+    #[test]
+    fn timer_first_does_not_reclassify_earlier_keyboard_message() {
+        for elapsed in [149,150] {
+            assert!(ordinary_key_before_deadline(true,Duration::from_millis(250),Duration::from_millis(150),Some(1000),Some(1000+elapsed),false));
+        }
+        assert!(!ordinary_key_before_deadline(true,Duration::from_millis(250),Duration::from_millis(150),Some(1000),Some(1151),false));
+    }
+    #[test]
+    fn wrapping_clock_and_used_layer_do_not_replay_twice() {
+        assert!(ordinary_key_before_deadline(true,Duration::from_secs(1),Duration::from_millis(150),Some(u32::MAX-100),Some(49),false));
+        assert!(!ordinary_key_before_deadline(true,Duration::from_secs(1),Duration::from_millis(150),Some(1000),Some(1100),true));
+        assert!(!ordinary_key_before_deadline(true,Duration::from_secs(1),Duration::from_millis(150),Some(1000),Some(900),false));
+    }
+}
