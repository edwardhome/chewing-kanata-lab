                 let has_symbols = self.f_buffer.as_ref().is_some_and(|b| !b.symbols().is_empty());
 
                 if !pending && can_handle_configured_f_layer(&self.chewing_editor, ev.vk, has_symbols, &mappings) {
@@ -3275,7 +3278,7 @@ mod f_and_shift_handoff_tests {
 mod reversible_f_native_tests {
     use super::*;
     fn f_event() -> SystemKeyboardEvent {
-        SystemKeyboardEvent { vk:0x46, repeating:false, scan_code:0x21, ascii_code:b'f', key_state:[0;256] }
