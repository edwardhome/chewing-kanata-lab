+++ b/tip/src/text_service/chewing.rs
@@ -932,7 +932,10 @@ impl ChewingTextService {
                     kanata_layer::FKeyState::Held { delay, mappings } => (Instant::now(), delay, mappings, true),
                     _ => unreachable!(),
                 };
-                let pending = !is_held && started_at.elapsed() <= delay;
+                let pending = super::f_preview::ordinary_key_before_deadline(
+                    is_held, started_at.elapsed(), delay,
+                    self.f_event.and_then(|event|event.message_time), ev.message_time,
