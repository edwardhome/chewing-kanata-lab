         }
         SystemKeyboardEvent {
             repeating: lparam & (1 << 30) != 0,
+            message_time: Some(unsafe { windows::Win32::UI::WindowsAndMessaging::GetMessageTime() } as u32),
             vk,
             scan_code,
             ascii_code: code,
