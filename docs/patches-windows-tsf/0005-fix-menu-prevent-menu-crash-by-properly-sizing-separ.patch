 fn register(icon_path: String) -> Result<()> {
     unsafe {
+        let _ = unregister();
+
         let input_processor_profile_mgr: ITfInputProcessorProfileMgr =
             CoCreateInstance(&CLSID_TF_InputProcessorProfiles, None, CLSCTX_INPROC_SERVER)?;
 
         let pw_icon_path = icon_path.encode_utf16().collect::<Vec<_>>();
+        let desc_zh_tw = "AI新酷音".encode_utf16().collect::<Vec<_>>();
+        let desc_zh_cn = "AI新酷音 (简体)".encode_utf16().collect::<Vec<_>>();
 
         // Register for zh_TW
         let mut lcid = LocaleNameToLCID(w!("zh-TW"), 0);
         if matches!(lcid, 0 | 0x0C00 | 0x1000) {
             lcid = 0x404;
         }
-        input_processor_profile_mgr.RegisterProfile(
+        let _ = input_processor_profile_mgr.RegisterProfile(
             &CHEWING_TSF_CLSID,
             lcid as u16,
             &CHEWING_ZH_TW_PROFILE_GUID,
-            w!("AI新酷音").as_wide(),
+            &desc_zh_tw,
             &pw_icon_path,
             0,
             HKL::default(),
             0,
-            false,
+            true,
             0,
-        )?;
+        );
         // Register for zh_CN
         let mut lcid = LocaleNameToLCID(w!("zh-CN"), 0);
         if matches!(lcid, 0 | 0x0C00 | 0x1000) {
             lcid = 0x804;
         }
-        input_processor_profile_mgr.RegisterProfile(
+        let _ = input_processor_profile_mgr.RegisterProfile(
             &CHEWING_TSF_CLSID,
             lcid as u16,
             &CHEWING_ZH_CN_PROFILE_GUID,
-            w!("AI新酷音 (简体)").as_wide(),
+            &desc_zh_cn,
             &pw_icon_path,
             0,
             HKL::default(),
             0,
             false,
             0,
-        )?;
+        );
 
         let category_manager: ITfCategoryMgr =
             CoCreateInstance(&CLSID_TF_CategoryMgr, None, CLSCTX_INPROC_SERVER)?;
         for tfcat in &CATEGORIES {
-            category_manager.RegisterCategory(&CHEWING_TSF_CLSID, tfcat, &CHEWING_TSF_CLSID)?;
+            let _ = category_manager.RegisterCategory(&CHEWING_TSF_CLSID, tfcat, &CHEWING_TSF_CLSID);
+        }
+
+        // Direct registry write fallback to ensure "AI新酷音" is always visible
+        if let Ok(key) = CURRENT_USER.create(r"Software\Microsoft\CTF\TIP\{13F2EF08-575C-4D8C-88E0-F67BB8052B84}\LanguageProfile\0x00000404\{CE45F71D-CE79-41D1-967D-640B65A380E3}") {
+            let _ = key.set_string("Description", "AI新酷音");
+        }
+        if let Ok(key) = CURRENT_USER.create(r"Software\Classes\CLSID\{13F2EF08-575C-4D8C-88E0-F67BB8052B84}") {
+            let _ = key.set_string("", "AI新酷音");
+        }
+        if let Ok(key) = LOCAL_MACHINE.create(r"SOFTWARE\Microsoft\CTF\TIP\{13F2EF08-575C-4D8C-88E0-F67BB8052B84}\LanguageProfile\0x00000404\{CE45F71D-CE79-41D1-967D-640B65A380E3}") {
+            let _ = key.set_string("Description", "AI新酷音");
+        }
+        if let Ok(key) = LOCAL_MACHINE.create(r"SOFTWARE\Classes\CLSID\{13F2EF08-575C-4D8C-88E0-F67BB8052B84}") {
+            let _ = key.set_string("", "AI新酷音");
         }
     }
 
