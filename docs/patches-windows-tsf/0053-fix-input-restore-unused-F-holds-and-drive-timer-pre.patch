@@ -736,7 +736,7 @@ impl ChewingTextService {
             if self.shift_session.is_some() { return Ok(true); }
             // Leave upstream Ctrl keybindings to the normal handling below.
         }
-        if shift_held && ev.vk == 0x46 && self.f_buffer.as_ref().is_none_or(|b| b.symbols().is_empty()) {
+        if shift_held && ev.vk == 0x46 && self.f_buffer.as_ref().is_none_or(|b| !b.layer_used()) {
             // Shift+F belongs strictly to English casing (ShiftLetterSession), never F layer.
         } else {
             if ev.vk == 0x46 && self.f_key_state != kanata_layer::FKeyState::Up { return Ok(true); }
@@ -893,10 +893,10 @@ impl ChewingTextService {
         // NOTE: If shift is held and no F-layer buffer is currently accumulating,
         // user intends to type Shift+F (or start/continue ShiftLetterSession).
         // Let it fall through to ShiftLetterSession rather than hijacking into F-layer.
-        if evt.is_state_on(KeyState::Control) || evt.is_state_on(KeyState::Alt) || evt.is_state_on(KeyState::Super) {
+        if shift_held || evt.is_state_on(KeyState::Control) || evt.is_state_on(KeyState::Alt) || evt.is_state_on(KeyState::Super) {
             if self.f_target.is_some() { self.cancel_f_preview(context)?; }
         }
-        let is_shift_f = shift_held && ev.vk == 0x46 && self.f_buffer.as_ref().is_none_or(|b| b.symbols().is_empty());
+        let is_shift_f = shift_held && ev.vk == 0x46 && self.f_buffer.as_ref().is_none_or(|b| !b.layer_used());
         if !is_shift_f {
             if ev.vk == 0x46 && self.f_key_state != kanata_layer::FKeyState::Up { return Ok(true); }
             if ev.vk == 0x46 && !evt.is_state_on(KeyState::Control) && !evt.is_state_on(KeyState::Alt)
@@ -971,11 +971,7 @@ impl ChewingTextService {
                 // Normal typing replaces the marked preview in the same context.
                 self.f_preview_active = false;
                 self.f_timer = None;
-                if pending {
-                    self.replay_f_tap(context)?;
-                } else {
-                    self.finish_f_buffer(context)?;
-                }
+                self.resolve_f_gesture(context)?;
                 self.f_key_state = kanata_layer::FKeyState::Cancelled;
                 self.f_target = None;
                 self.f_mode = None;
@@ -1363,15 +1359,8 @@ impl ChewingTextService {
             self.f_timer = None;
             self.f_preview_active = false;
             match previous {
-                kanata_layer::FKeyState::Down { started_at, delay, .. } => {
-                    if started_at.elapsed() <= delay {
-                        self.replay_f_tap(context)?;
-                    } else {
-                        self.finish_f_buffer(context)?;
-                    }
-                }
-                kanata_layer::FKeyState::Held { .. } => {
-                    self.finish_f_buffer(context)?;
+                kanata_layer::FKeyState::Down { .. } | kanata_layer::FKeyState::Held { .. } => {
+                    self.resolve_f_gesture(context)?;
                 }
                 _ => {}
             }
@@ -1841,12 +1830,13 @@ impl ChewingTextService {
             Err(_) => { self.discard_f_gesture(); return Ok(()); }
         };
         if !self.f_target_valid(&context) { self.discard_f_gesture(); return Ok(()); }
-        let mut keys = [0u8;256];
-        if unsafe { GetKeyboardState(&mut keys) }.is_err() { return Ok(()); }
-        if [0x10,0x11,0x12,0x5b,0x5c].iter().any(|&k| keys[k] & 0x80 != 0) {
+        // The accepted keydown owns this gesture. GetKeyboardState is tied to
+        // queue consumption and must not silently drop a one-shot timer. Physical
+        // modifiers can still cancel it; release/focus/mode invalidate ownership.
+        if [0x10,0x11,0x12,0x5b,0x5c].iter().any(|&vk|
+            unsafe { windows::Win32::UI::Input::KeyboardAndMouse::GetAsyncKeyState(vk) } < 0) {
             return self.cancel_f_preview(&context);
         }
-        if keys[0x46] & 0x80 == 0 { return Ok(()); }
         if let Some(remaining)=super::f_preview::remaining_delay(started_at.elapsed(),delay) {
             self.schedule_f_tick(remaining);
             return Ok(());
@@ -1919,6 +1909,16 @@ impl ChewingTextService {
         Ok(())
     }
 
+    // Only explicit release/ordinary typing in the original valid context may
+    // restore F. Cancellation, focus/mode changes never call this path.
+    fn resolve_f_gesture(&mut self, context: &ITfContext) -> Result<()> {
+        if self.f_buffer.as_ref().is_some_and(|b| !b.layer_used()) {
+            self.replay_f_tap(context)
+        } else {
+            self.finish_f_buffer(context)
+        }
+    }
+
     fn finish_f_buffer(&mut self, context: &ITfContext) -> Result<()> {
         if let Some(buffer) = self.f_buffer.take() {
             let composition = buffer.preview(&self.lexicon);
