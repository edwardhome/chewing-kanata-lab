         }
     }
-    fn pump(duration: Duration) {
+    pub(super) fn pump(duration: Duration) {
         let until=Instant::now()+duration;
         while Instant::now()<until {
             let mut msg=MSG::default();
@@ -86,3 +86,35 @@ mod tests {
         assert!(TARGETS.with(|t|t.borrow().is_empty()));
     }
 }
+
+#[cfg(test)]
+mod f_deadline_tests {
+    use super::*;
+    use std::{cell::Cell, time::Duration};
+    use windows_core::{ComObject, implement};
+    use crate::text_service::{IFnRunCommand_Impl, composition_session::SessionControl};
+    #[implement(IFnRunCommand)]
+    struct FPreviewProbe { control: Rc<RefCell<SessionControl>>, generation: Rc<Cell<u32>> }
+    impl IFnRunCommand_Impl for FPreviewProbe_Impl {
+        unsafe fn on_command(&self, id: u32, _: CommandType) {
+            self.generation.set(id);
+            let mut control=self.control.borrow_mut();
+            assert!(control.enqueue("", "中文·", vec![(0,3)], 3));
+            assert!(control.schedule());
+        }
+    }
+    #[test]
+    fn f_timer_updates_production_queue_without_another_key() {
+        let control=Rc::new(RefCell::new(SessionControl::new()));
+        control.borrow_mut().enqueue("", "中文ㄑ", vec![(0,3)], 3);
+        let generation=Rc::new(Cell::new(0));
+        let probe=ComObject::new(FPreviewProbe{control:control.clone(),generation:generation.clone()});
+        let timer=HoldTimer::start_with_cmd(probe.into_interface(),151,CommandType::FHoldTick).unwrap();
+        super::tests::pump(Duration::from_millis(350));
+        assert_eq!(generation.get(),timer.generation);
+        assert!(control.borrow_mut().begin_callback());
+        let snapshot=control.borrow_mut().begin_submission().unwrap();
+        assert_eq!(snapshot.preedit,"中文·");
+        assert!(snapshot.commit.is_empty());
+    }
+}
