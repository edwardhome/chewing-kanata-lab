+    fn compartment_variants_distinguish_unset_closed_and_invalid() {
+        assert_eq!(compartment_flag(&VARIANT::default()).unwrap(), None);
+        assert_eq!(compartment_flag(&0i32.into()).unwrap(), Some(false));
+        assert_eq!(compartment_flag(&1i32.into()).unwrap(), Some(true));
+        assert!(compartment_flag(&2i32.into()).is_err());
+        assert!(compartment_flag(&1u32.into()).is_err());
+    }
+
+    #[test]
+    fn failed_or_unset_compartment_preserves_every_mode() {
+        for mode in [TsfLangMode::Chinese, TsfLangMode::English,
+                     TsfLangMode::DisabledChinese, TsfLangMode::DisabledEnglish] {
+            assert_eq!(mode_from_compartment(mode, compartment_flag(&VARIANT::default())), mode);
+            assert_eq!(mode_from_compartment(mode, Err(anyhow::anyhow!("COM read failed"))), mode);
+            assert_eq!(mode_from_compartment(mode, compartment_flag(&2i32.into())), mode);
+        }
+    }
+
+    #[test]
+    fn repeated_compartment_notifications_are_idempotent() {
+        for (enabled, disabled) in [(TsfLangMode::Chinese, TsfLangMode::DisabledChinese),
+                                    (TsfLangMode::English, TsfLangMode::DisabledEnglish)] {
+            let closed = mode_from_compartment(enabled, compartment_flag(&0i32.into()));
+            assert_eq!(closed, disabled);
+            assert_eq!(mode_from_compartment(closed, compartment_flag(&0i32.into())), disabled);
+            let opened = mode_from_compartment(closed, compartment_flag(&1i32.into()));
+            assert_eq!(opened, enabled);
+            assert_eq!(mode_from_compartment(opened, compartment_flag(&1i32.into())), enabled);
         }
     }
