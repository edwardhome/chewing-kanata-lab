+// Unknown/failed host reads are not an explicit request to close the IME.
+fn compartment_flag(value: &VARIANT) -> Result<Option<bool>> {
+    let kind = unsafe { value.Anonymous.Anonymous.vt };
+    if kind == VT_EMPTY { return Ok(None); }
+    if kind != VT_I4 { bail!("Unexpected compartment value type"); }
+    match i32::try_from(value)? {
+        0 => Ok(Some(false)),
+        1 => Ok(Some(true)),
+        _ => bail!("Unexpected compartment flag"),
+    }
+}
+
+fn mode_from_compartment(mode: TsfLangMode, value: Result<Option<bool>>) -> TsfLangMode {
+    match (value, mode) {
+        (Ok(Some(true)), TsfLangMode::DisabledChinese) => TsfLangMode::Chinese,
+        (Ok(Some(true)), TsfLangMode::DisabledEnglish) => TsfLangMode::English,
+        (Ok(Some(false)), TsfLangMode::Chinese) => TsfLangMode::DisabledChinese,
+        (Ok(Some(false)), TsfLangMode::English) => TsfLangMode::DisabledEnglish,
+        _ => mode,
+    }
+}
+
+fn toggled_lang_mode(mode: TsfLangMode) -> TsfLangMode {
+    match mode {
+        TsfLangMode::Chinese => TsfLangMode::English,
+        _ => TsfLangMode::Chinese,
+    }
+}
