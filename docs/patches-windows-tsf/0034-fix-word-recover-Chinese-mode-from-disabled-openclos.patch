@@ -2700,4 +2760,56 @@ mod f_and_shift_handoff_tests {
         assert_eq!(queue.pending_commit_str(), "");
         assert!(!queue.has_unsubmitted_changes());
     }
+
+    #[test]
+    fn test_disabled_mode_recovers_to_chinese_on_toggle() {
+        for initial in [TsfLangMode::DisabledEnglish, TsfLangMode::DisabledChinese] {
+            let mut mode = initial;
+            // Simulated toggle_lang_mode update logic
+            mode = match mode {
+                TsfLangMode::English => TsfLangMode::Chinese,
+                TsfLangMode::Chinese => TsfLangMode::English,
+                TsfLangMode::DisabledEnglish | TsfLangMode::DisabledChinese => TsfLangMode::Chinese,
+            };
+            assert_eq!(mode, TsfLangMode::Chinese);
+            assert!(!mode.is_disabled());
+        }
+    }
+
+    #[test]
+    fn test_compartment_openclose_status_transition() {
+        // When openclose != 0 (Open)
+        for (initial, expected) in [
+            (TsfLangMode::DisabledChinese, TsfLangMode::Chinese),
+            (TsfLangMode::DisabledEnglish, TsfLangMode::English),
+            (TsfLangMode::Chinese, TsfLangMode::Chinese),
+            (TsfLangMode::English, TsfLangMode::English),
+        ] {
+            let next = match (true, initial) {
+                (true, TsfLangMode::DisabledChinese) => TsfLangMode::Chinese,
+                (true, TsfLangMode::DisabledEnglish) => TsfLangMode::English,
+                (false, TsfLangMode::Chinese) => TsfLangMode::DisabledChinese,
+                (false, TsfLangMode::English) => TsfLangMode::DisabledEnglish,
+                _ => initial,
+            };
+            assert_eq!(next, expected);
+        }
+
+        // When openclose == 0 (Closed / Word document init)
+        for (initial, expected) in [
+            (TsfLangMode::Chinese, TsfLangMode::DisabledChinese),
+            (TsfLangMode::English, TsfLangMode::DisabledEnglish),
+            (TsfLangMode::DisabledChinese, TsfLangMode::DisabledChinese),
+            (TsfLangMode::DisabledEnglish, TsfLangMode::DisabledEnglish),
+        ] {
+            let next = match (false, initial) {
+                (true, TsfLangMode::DisabledChinese) => TsfLangMode::Chinese,
+                (true, TsfLangMode::DisabledEnglish) => TsfLangMode::English,
+                (false, TsfLangMode::Chinese) => TsfLangMode::DisabledChinese,
+                (false, TsfLangMode::English) => TsfLangMode::DisabledEnglish,
+                _ => initial,
+            };
+            assert_eq!(next, expected);
+        }
+    }
 }
