diff --git a/tip/src/quirk.rs b/tip/src/quirk.rs
index f737d78..877fc2e 100644
--- a/tip/src/quirk.rs
+++ b/tip/src/quirk.rs
@@ -12,12 +12,16 @@ impl Quirk {
     pub(crate) fn query() -> Option<Quirk> {
         let mut buffer = [0u16; MAX_PATH as usize];
         let len = unsafe { GetModuleFileNameW(None, &mut buffer[..]) as usize };
-        if len == 0 {
+        if len == 0 || len >= buffer.len() {
             return None;
         }
-        buffer[len - 1] = 0;
-        let exe_path = String::from_utf16_lossy(&buffer[..(len as usize)]);
-        if exe_path.ends_with(r"\MyAB.exe") {
+        let exe_path = String::from_utf16_lossy(&buffer[..len]).to_lowercase();
+        if exe_path.ends_with(r"\myab.exe")
+            || exe_path.ends_with(r"\winword.exe")
+            || exe_path.ends_with(r"\excel.exe")
+            || exe_path.ends_with(r"\powerpnt.exe")
+            || exe_path.ends_with(r"\outlook.exe")
+        {
             return Some(Quirk {
                 skip_imm32_patch: true,
             });
