-    fn toggle_keyboard_openclose(&self) {
-        self.lang_mode.update(|mode| match mode {
-            TsfLangMode::Chinese => TsfLangMode::DisabledChinese,
-            TsfLangMode::English => TsfLangMode::DisabledEnglish,
-            TsfLangMode::DisabledChinese => TsfLangMode::Chinese,
-            TsfLangMode::DisabledEnglish => TsfLangMode::English,
+    fn handle_keyboard_openclose_change(&self) {
+        let openclose = (|| -> Result<i32> {
+            let compartment_mgr: ITfCompartmentMgr = self.thread_mgr.cast()?;
+            let compartment = unsafe {
+                compartment_mgr.GetCompartment(&GUID_COMPARTMENT_KEYBOARD_OPENCLOSE)?
+            };
+            let val = unsafe { compartment.GetValue()? };
+            Ok(i32::try_from(&val)?)
+        })().unwrap_or(0);
+
+        self.lang_mode.update(|mode| match (openclose != 0, mode) {
+            (true, TsfLangMode::DisabledChinese) => TsfLangMode::Chinese,
+            (true, TsfLangMode::DisabledEnglish) => TsfLangMode::English,
+            (false, TsfLangMode::Chinese) => TsfLangMode::DisabledChinese,
+            (false, TsfLangMode::English) => TsfLangMode::DisabledEnglish,
+            _ => mode,
         });
     }
 
