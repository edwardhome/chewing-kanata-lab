         fs::create_dir_all(&dir).map_err(|_| "無法建立詞庫目錄。")?;
-        let mut text = ENGINEERING_TEXT_TEMPLATE.to_owned();
-        for term in snapshot.terms { text.push_str(&format!("{}\t{}\t{}\n", term.input, term.output, term.annotation)); }
+        let text = encode_user_terms_text(&snapshot.terms).map_err(terms_error)?;
         let mut file = tempfile::Builder::new().prefix("engineering-export-").suffix(".txt")
             .tempfile_in(&dir).map_err(|_| "無法建立匯出文本。")?;
-        file.write_all(text.as_bytes()).map_err(|_| "無法寫入匯出文本。")?;
+        file.write_all(&text).map_err(|_| "無法寫入匯出文本。")?;
         let (_, path) = file.keep().map_err(|_| "無法保留匯出文本。")?;
         let windows = std::env::var_os("SystemRoot").ok_or("無法取得記事本位置。")?;
         std::process::Command::new(PathBuf::from(windows).join("System32").join("notepad.exe"))
@@ -121,7 +136,7 @@ pub async fn export_engineering_text() -> Result<(), String> {
 mod tests {
     use super::*;
     fn terms() -> Vec<UserEngineeringTerm> {
-        vec![UserEngineeringTerm { input: "CH4".into(), output: "CH₄".into(), annotation: "甲烷".into() }]
+        vec![UserEngineeringTerm { input: "CH4".into(), output: "CH₄".into(), annotation: "甲烷".into(), zh_aliases: vec!["甲烷".into()] }]
     }
     #[test]
     fn create_edit_delete_and_restart_preserve_user_terms() {
@@ -143,6 +158,26 @@ mod tests {
         assert!(save_at(dir.path(), invalid, saved.revision).is_err());
         assert_eq!(fs::read(&path).unwrap(), before);
     }
+    #[test]
+    fn v1_migration_backs_up_exact_bytes_and_keeps_revision_guard() {
+        let dir = tempfile::tempdir().unwrap(); let path = dir.path().join(USER_TERMS_FILENAME);
+        let original = "{\n \"version\": 1, \"terms\": []\n}";
+        fs::write(&path, original.as_bytes()).unwrap();
+        let old = load_at(&path).unwrap();
+        assert_eq!(old.format_version, 1);
+        assert!(save_at(dir.path(), terms(), None).is_err());
+        assert_eq!(fs::read_dir(dir.path()).unwrap().filter_map(Result::ok)
+            .filter(|entry| entry.file_name().to_string_lossy().starts_with("engineering-terms-v1-backup-")).count(), 0);
+        let saved = save_at(dir.path(), terms(), old.revision).unwrap();
+        assert_eq!(saved.format_version, 2);
+        let backup = dir.path().join(saved.backup_file.unwrap());
+        assert_eq!(fs::read(&backup).unwrap(), original.as_bytes());
+        assert_eq!(saved.terms[0].zh_aliases, vec!["甲烷"]);
+        let saved_again = save_at(dir.path(), vec![], saved.revision).unwrap();
+        assert!(saved_again.backup_file.is_none());
+        assert_eq!(fs::read(&backup).unwrap(), original.as_bytes());
+    }
+
     #[test]
     fn malformed_file_is_not_silently_replaced() {
         let dir = tempfile::tempdir().unwrap(); let path = dir.path().join(USER_TERMS_FILENAME);
@@ -152,3 +187,19 @@ mod tests {
         assert_eq!(fs::read(&path).unwrap(), b"malformed");
     }
 }
+
+#[tauri::command]
+pub async fn open_engineering_template() -> Result<(), String> {
+    tauri::async_runtime::spawn_blocking(|| {
+        let dir = directory()?;
+        fs::create_dir_all(&dir).map_err(|_| "無法建立詞庫目錄。")?;
+        let mut file = tempfile::Builder::new().prefix("engineering-template-v2-").suffix(".txt")
+            .tempfile_in(&dir).map_err(|_| "無法建立新版範本。")?;
+        file.write_all(ENGINEERING_TEXT_TEMPLATE.as_bytes()).map_err(|_| "無法寫入新版範本。")?;
+        let (_, path) = file.keep().map_err(|_| "無法保留新版範本。")?;
+        let windows = std::env::var_os("SystemRoot").ok_or("無法取得記事本位置。")?;
+        std::process::Command::new(PathBuf::from(windows).join("System32").join("notepad.exe"))
+            .arg(path).spawn().map_err(|_| "無法開啟記事本。")?;
+        Ok(())
+    }).await.map_err(|_| "開啟新版範本未完成。")?
+}
