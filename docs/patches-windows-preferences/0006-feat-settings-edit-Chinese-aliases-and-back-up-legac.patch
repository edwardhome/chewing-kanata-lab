 // SPDX-License-Identifier: GPL-3.0-or-later
 
 use chewing_policy_core::user_engineering::{UserEngineeringTerm, UserTermsError,
-    parse_user_terms, encode_user_terms, parse_user_terms_text,
+    parse_user_terms, encode_user_terms, parse_user_terms_text, encode_user_terms_text,
     MAX_USER_TERMS_BYTES, USER_TERMS_FILENAME, ENGINEERING_TEXT_TEMPLATE};
 use serde::Serialize;
 use std::{fs, io::{Read, Write}, path::{Path, PathBuf}};
 
 #[derive(Serialize)]
-pub struct EngineeringSnapshot { terms: Vec<UserEngineeringTerm>, revision: Option<String> }
+pub struct EngineeringSnapshot { terms: Vec<UserEngineeringTerm>, revision: Option<String>, format_version: u32, backup_file: Option<String> }
 
 fn terms_error(error: UserTermsError) -> String {
     match error {
         UserTermsError::TooLarge => "詞條數量或檔案太大，最多 500 筆、256 KiB。",
-        UserTermsError::InvalidFormat => "詞庫格式不正確；文本請使用 Tab 分隔三欄，不要加入 Markdown 圍欄。",
+        UserTermsError::InvalidFormat => "詞庫格式不正確；文本請使用 Tab 分隔三欄或四欄，不要加入 Markdown 圍欄。",
         UserTermsError::InvalidTerm => "詞條格式不正確，請檢查輸入碼、長度與不可見字元。",
         UserTermsError::Duplicate => "有重複的輸入碼與候選文字，請刪除重複列後再儲存。",
     }.into()
@@ -36,11 +36,13 @@ fn read_bounded(path: &Path) -> Result<Option<Vec<u8>>, String> {
 }
 fn load_at(path: &Path) -> Result<EngineeringSnapshot, String> {
     match read_bounded(path)? {
-        None => Ok(EngineeringSnapshot { terms: vec![], revision: None }),
+        None => Ok(EngineeringSnapshot { terms: vec![], revision: None, format_version: 2, backup_file: None }),
         Some(bytes) => {
             let terms = parse_user_terms(&bytes).map_err(terms_error)?;
-            let revision = Some(String::from_utf8(bytes).map_err(|_| "詞庫不是 UTF-8。")?);
-            Ok(EngineeringSnapshot { terms, revision })
+            let revision = Some(String::from_utf8(bytes.clone()).map_err(|_| "詞庫不是 UTF-8。")?);
+            let format_version = serde_json::from_slice::<serde_json::Value>(&bytes).ok()
+                .and_then(|v| v.get("version").and_then(|x| x.as_u64())).unwrap_or(1) as u32;
+            Ok(EngineeringSnapshot { terms, revision, format_version, backup_file: None })
         }
     }
 }
@@ -51,14 +53,26 @@ fn save_at(directory: &Path, terms: Vec<UserEngineeringTerm>, expected: Option<S
         .open(directory.join("engineering-terms.lock")).map_err(|_| "無法開啟詞庫鎖定檔。")?;
     fs2::FileExt::try_lock_exclusive(&lock).map_err(|_| "另一個設定視窗正在儲存，請稍後重試。")?;
     let path = directory.join(USER_TERMS_FILENAME);
-    if load_at(&path)?.revision != expected {
+    let previous = load_at(&path)?;
+    if previous.revision != expected {
         return Err("詞庫已被另一個視窗修改，請重新載入後再編輯；您的編輯內容仍保留在本視窗。".into());
     }
+    let backup_file = if previous.format_version == 1 {
+        let original = previous.revision.as_ref().ok_or("無法取得舊詞庫備份內容。")?;
+        let mut backup = tempfile::Builder::new().prefix("engineering-terms-v1-backup-").suffix(".json")
+            .tempfile_in(directory).map_err(|_| "無法建立舊詞庫備份；原檔未變更。")?;
+        backup.write_all(original.as_bytes()).and_then(|_| backup.as_file().sync_all())
+            .map_err(|_| "無法寫入舊詞庫備份；原檔未變更。")?;
+        let (_, backup_path) = backup.keep().map_err(|_| "無法保留舊詞庫備份；原檔未變更。")?;
+        Some(backup_path.file_name().ok_or("備份檔名無效。")?.to_string_lossy().into_owned())
+    } else { None };
     let mut temp = tempfile::NamedTempFile::new_in(directory).map_err(|_| "無法建立暫存詞庫。")?;
     temp.write_all(&bytes).and_then(|_| temp.as_file().sync_all()).map_err(|_| "儲存失敗，原有詞庫未變更。")?;
     temp.persist(&path).map_err(|_| "無法替換詞庫，原有詞庫未變更。")?;
     // Return the bytes just persisted while the lock is still held.
-    load_at(&path)
+    let mut saved = load_at(&path)?;
+    saved.backup_file = backup_file;
+    Ok(saved)
 }
 
 #[tauri::command]
@@ -94,7 +108,9 @@ pub async fn read_engineering_text() -> Result<Vec<UserEngineeringTerm>, String>
     tauri::async_runtime::spawn_blocking(|| {
         let bytes = read_bounded(&directory()?.join("engineering-terms.draft.txt"))?
             .ok_or("請先開啟工程詞彙文本，編輯並儲存後再匯入。")?;
-        parse_user_terms_text(&bytes).map_err(terms_error)
+        if bytes.iter().copied().find(|b| !b.is_ascii_whitespace()) == Some(b'{') {
+            parse_user_terms(&bytes).map_err(terms_error)
+        } else { parse_user_terms_text(&bytes).map_err(terms_error) }
     }).await.map_err(|_| "匯入文本未完成。")?
 }
 
@@ -104,11 +120,10 @@ pub async fn export_engineering_text() -> Result<(), String> {
         let dir = directory()?;
