+// Physical QWERTY positions only; outputs always come from the shared backend.
+const keyboardRows: Array<Array<{ key?: number; label?: string; width?: number }>> = [
+  [{key:27}],
+  [...[192,49,50,51,52,53,54,55,56,57,48,189,187].map(key => ({key})), {label:"退格",width:90}],
+  [{label:"Tab",width:72}, ...[81,87,69,82,84,89,85,73,79,80,219,221,220].map(key => ({key}))],
+  [{label:"Caps",width:86}, ...[65,83,68].map(key => ({key})), {label:"F 分層",width:58}, ...[71,72,74,75,76,186,222].map(key => ({key})), {label:"Enter",width:86}],
+  [{label:"Shift",width:112}, ...[90,88,67,86,66,78,77,188,190,191].map(key => ({key})), {label:"Shift",width:112}],
+  [{label:"Ctrl",width:60}, {label:"Win",width:60}, {label:"Alt",width:60}, {key:32,width:360}, {label:"Alt",width:60}, {label:"Ctrl",width:60}],
+];
+
 interface Props {
   mappings: Record<string, string>;
   onChange: (next: Record<string, string>) => void;
@@ -104,6 +89,7 @@ export default function FLayerMappings({ mappings, onChange }: Props) {
   const [loadError, setLoadError] = useState<string | null>(null);
   const [loading, setLoading] = useState(true);
   const [retry, setRetry] = useState(0);
+  const [selectedKey, setSelectedKey] = useState(74);
 
   useEffect(() => {
     let active = true;
@@ -151,59 +137,44 @@ export default function FLayerMappings({ mappings, onChange }: Props) {
 
       {loading && <Text role="status">正在載入映射表…</Text>}
       {loadError && <div role="alert">{loadError} <Button onClick={() => setRetry((n) => n + 1)}>重試</Button></div>}
-      {!loading && !loadError && <table className={styles.table}>
-        <thead>
-          <tr>
-            <th className={styles.keyCol}>按鍵</th>
-            <th className={styles.defaultCol}>預設輸出</th>
-            <th className={styles.outputCol}>自訂輸出</th>
-            <th className={styles.actionCol}>重設</th>
-          </tr>
-        </thead>
-        <tbody>
-          {defaults.map((row) => {
-            const keyStr = String(row.key);
-            const isOverridden = Object.prototype.hasOwnProperty.call(mappings, keyStr);
-            const currentVal = isOverridden ? mappings[keyStr] : row.output;
-            const err = validateOutputScalar(currentVal).reason;
-
-            return (
-              <tr key={row.key}>
-                <td>
-                  <Text weight="medium">F + {row.label}</Text>
-                </td>
-                <td>
-                  <Text style={{ fontFamily: "monospace" }}>
-                    {row.output === "" ? "（原按鍵）" : row.output}
-                  </Text>
-                </td>
-                <td>
-                  <Field validationMessage={err} validationState={err ? "error" : "none"}>
-                    <Input
-                      className={styles.input}
-                      aria-label={`F + ${row.label} 的輸出`}
-                      value={currentVal}
-                      placeholder={row.output === "" ? "（原按鍵）" : row.output}
-                      onChange={(_e, data) => handleInputChange(keyStr, data.value)}
-                    />
-                  </Field>
-                </td>
-                <td>
-                  {isOverridden && (
-                    <Button
-                      size="small"
-                      appearance="subtle"
-                      onClick={() => handleResetRow(keyStr)}
-                    >
-                      還原預設
-                    </Button>
-                  )}
-                </td>
-              </tr>
-            );
-          })}
-        </tbody>
-      </table>}
+      {!loading && !loadError && <>
+        <Text>點選鍵盤上的按鍵修改輸出。上方是原鍵，下方是 F 層輸出；灰色按鍵保留原用途。</Text>
+        <div className={styles.keyboard} role="group" aria-label="QWERTY F 分層鍵盤">
+          {keyboardRows.map((keys, index) => <div className={styles.keyboardRow} key={index}>
+            {keys.map((key, column) => {
+              const row = defaults.find(item => item.key === key.key);
+              const value = row ? (mappings[String(row.key)] ?? row.output) : "";
+              const invalid = row ? !validateOutputScalar(value).ok : false;
+              return <Button key={column} className={styles.key}
+                style={{ width: key.width }} disabled={!row}
+                appearance={row?.key === selectedKey ? "primary" : "outline"}
+                aria-pressed={!!row && row.key === selectedKey}
+                aria-label={row ? `F + ${row.label}：${value || "原按鍵"}${invalid ? "，設定有誤" : ""}` : `${key.label}，保留原用途`}
+                onClick={() => row && setSelectedKey(row.key)}>
+                <span>{row?.label ?? key.label}</span>
+                {row && <Text weight="semibold">{invalid ? "待修正" : value || "原按鍵"}</Text>}
+              </Button>;
+            })}
+          </div>)}
+        </div>
+        {defaults.filter(row => row.key === selectedKey).map(row => {
+          const keyStr = String(row.key);
+          const currentVal = mappings[keyStr] ?? row.output;
+          const err = validateOutputScalar(currentVal).reason;
+          return <div className={styles.editor} key={row.key}>
+            <Text weight="semibold">F + {row.label}</Text>
+            <Text>預設：{row.output || "原按鍵"}</Text>
+            <Field label="自訂輸出" validationMessage={err} validationState={err ? "error" : "none"}>
+              <Input className={styles.input} aria-label={`F + ${row.label} 的輸出`}
+                value={currentVal} placeholder="留空使用原按鍵"
+                onChange={(_e, data) => handleInputChange(keyStr, data.value)} />
+            </Field>
+            <Button disabled={!Object.prototype.hasOwnProperty.call(mappings, keyStr)} onClick={() => handleResetRow(keyStr)}>還原此鍵</Button>
+          </div>;
+        })}
+        {defaults.some(row => !validateOutputScalar(mappings[String(row.key)] ?? row.output).ok) &&
+          <Text role="alert">有按鍵設定尚未完成，請點選標示「待修正」的按鍵修正後再儲存。</Text>}
+      </>}
     </div>
   );
 }
