diff --git a/tests/app-rules.test.mjs b/tests/app-rules.test.mjs
new file mode 100644
index 0000000..733efb9
--- /dev/null
+++ b/tests/app-rules.test.mjs
@@ -0,0 +1,21 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { decodeRules } from '../src/appRuleSettings.ts';
+const rule = { app_id: 'C:\\Apps\\Editor.exe', display_name: 'Editor', mode: 'english' };
+const decode = (rules, version=1) => decodeRules(JSON.stringify({version,rules}));
+test('fresh preferences are empty', () => assert.deepEqual(decodeRules(undefined), {rules:[],invalid:false}));
+test('duplicate program paths preserve first manual choice', () => {
+ const result=decode([{...rule,mode:'bopomofo'}, {...rule,app_id:rule.app_id.toLowerCase()}]);
+ assert.equal(result.rules.length,1);assert.equal(result.rules[0].mode,'bopomofo');
+});
+test('same names at different paths stay separate', () => assert.equal(decode([rule,{...rule,app_id:'D:\\Apps\\Editor.exe'}]).rules.length,2));
+test('malformed and future data fail closed', () => {
+ for(const value of ['{','null','[]',JSON.stringify({version:2,rules:[rule]})]) assert.equal(decodeRules(value).invalid,true);
+});
+test('invalid modes and nonlocal identities fail closed', () => {
+ for(const r of [{...rule,mode:'ai'}, {...rule,app_id:'Editor.exe'}, {...rule,app_id:'\\\\server\\a.exe'}, {...rule,app_id:'C:\\bad\n.exe'}]) assert.equal(decode([r]).invalid,true);
+});
+test('rule count and byte budget bounded', () => {
+ assert.equal(decode(Array(257).fill(rule)).invalid,true);
+ assert.equal(decodeRules(' '.repeat(1048577)).invalid,true);
+});
