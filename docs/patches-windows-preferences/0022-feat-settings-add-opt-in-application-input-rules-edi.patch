@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 AI Chewing contributors
+import { useState, useEffect, useRef } from "react";
+import { Button, Checkbox, Select, Text, makeStyles } from "@fluentui/react-components";
+import { open } from "@tauri-apps/plugin-dialog";
+import { invoke } from "@tauri-apps/api/core";
+import type { ChewingTsfConfig } from "./config";
+
+import { decodeRules, type AppRule } from "./appRuleSettings";
+const useStyles = makeStyles({
+  root: { padding: "16px", display: "flex", flexDirection: "column", gap: "14px", maxHeight: "65vh", overflowY: "auto" },
+  row: { display: "flex", alignItems: "center", gap: "12px", borderBottom: "1px solid #8885", padding: "10px 0" },
+  identity: { flex: 1, minWidth: 0, display: "flex", flexDirection: "column", gap: "4px", overflowWrap: "anywhere" },
+});
+
+
+export default function AppInputRules({ config, onChange }: { config: ChewingTsfConfig; onChange: (config: ChewingTsfConfig) => void }) {
+  const styles = useStyles();
+  const latest = useRef(config);
+  latest.current = config;
+  const mounted = useRef(true);
+  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+  const { rules, invalid } = decodeRules(config.app_input_rules_json);
+  const update = (next: AppRule[]) => onChange({ ...latest.current, app_input_rules_json: JSON.stringify({ version: 1, rules: next }) });
+  const add = async () => {
+    setBusy(true); setError("");
+    try {
+      const path = await open({ title: "選擇應用程式", multiple: false, directory: false, filters: [{ name: "Windows 應用程式", extensions: ["exe"] }] });
+      if (typeof path !== "string") return;
+      const rule = await invoke<AppRule>("resolve_app_input_rule", { path });
+      if (!mounted.current) return;
+      const current = decodeRules(latest.current.app_input_rules_json);
+      if (current.invalid) { setError("規則已變更，請先確認設定內容。"); return; }
+      const rules = current.rules;
+      if (rules.some(r => r.app_id.toLowerCase() === rule.app_id.toLowerCase())) {
+        setError("這個應用程式已在清單中，原本的模式保持不變。"); return;
+      }
+      if (rules.length >= 256) { setError("最多可加入 256 個應用程式。"); return; }
+      update([...rules, rule]);
+    } catch (e) { setError(String(e)); }
+    finally { setBusy(false); }
+  };
+  return <div className={styles.root}>
+    <Checkbox label="啟用應用程式輸入模式規則" checked={config.app_input_rules_enabled ?? false}
+      onChange={(_, data) => onChange({ ...config, app_input_rules_enabled: data.checked === true })} />
+    <Text>只切換 AI新酷音內部的英文／注音，不會搶回其他輸入法。同一 App 手動切換後會保留選擇；離開再返回才重新套用。</Text>
+    <Text>按下「套用」或「確定」儲存後，規則與開關從下一次切入 App 生效。組字、選字或按鍵手勢尚未結束時會延後切換。</Text>
+    <div><Button disabled={busy || invalid} onClick={add}>加入應用程式…</Button></div>
+    <Text size={200}>請選擇實際的 .exe，不是捷徑。辨識依完整程式路徑，程式搬移後請重新加入。不辨識網站、Vim、SSH 或終端機分頁。</Text>
+    {invalid && <div role="alert"><Text>儲存的規則格式無法辨識，暫不套用。可清空規則後重新加入。</Text> <Button onClick={() => update([])}>清空規則</Button></div>}
+    {error && <Text role="alert">{error}</Text>}
+    {!rules.length && !invalid && <Text>尚未加入應用程式，維持原本的輸入行為。</Text>}
+    {rules.map(rule => <div className={styles.row} key={rule.app_id}>
+      <div className={styles.identity}><Text weight="semibold">{rule.display_name}</Text><Text size={200}>{rule.app_id}</Text></div>
+      <Select aria-label={`${rule.display_name} 的預設模式`} value={rule.mode}
+        onChange={(_, data) => update(rules.map(r => r.app_id === rule.app_id ? { ...r, mode: data.value as AppRule["mode"] } : r))}>
+        <option value="english">預設英文</option><option value="bopomofo">預設注音</option>
+      </Select>
+      <Button aria-label={`移除 ${rule.display_name}`} onClick={() => update(rules.filter(r => r.app_id !== rule.app_id))}>移除</Button>
+    </div>)}
+  </div>;
+}
diff --git a/src/appRuleSettings.ts b/src/appRuleSettings.ts
new file mode 100644
index 0000000..23286db
--- /dev/null
+++ b/src/appRuleSettings.ts
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+export type AppRule = { app_id: string; display_name: string; mode: "english" | "bopomofo" };
+export function decodeRules(json: string | undefined): { rules: AppRule[]; invalid: boolean } {
+  if (!json) return { rules: [], invalid: false };
+  try {
+    if (new TextEncoder().encode(json).length > 1048576) throw Error();
+    const data = JSON.parse(json);
+    if (data.version !== 1 || !Array.isArray(data.rules) || data.rules.length > 256) throw Error();
+    const seen = new Set<string>();
+    const rules: AppRule[] = [];
+    for (const r of data.rules) {
+      if (typeof r.app_id !== "string" || typeof r.display_name !== "string" || !r.display_name || r.display_name.length > 256 ||
+          !/^[a-z]:\\/i.test(r.app_id) || r.app_id.length > 32767 || /[\x00-\x1f]/.test(r.app_id) ||
+          !["english", "bopomofo"].includes(r.mode)) throw Error();
+      const id = r.app_id.replaceAll("/", "\\").toLowerCase();
+      if (!seen.has(id)) { rules.push({ ...r, app_id: id }); seen.add(id); }
+    }
+    return { rules, invalid: false };
+  } catch { return { rules: [], invalid: true }; }
+}
+
