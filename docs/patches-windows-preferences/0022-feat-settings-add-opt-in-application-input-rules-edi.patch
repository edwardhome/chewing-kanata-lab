+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 AI Chewing contributors
+use serde::Serialize;
+use std::path::Path;
+
+#[derive(Serialize)]
+pub(crate) struct AppRule {
+    app_id: String,
+    display_name: String,
+    mode: &'static str,
+}
+
+/// Resolve only the explicitly selected program. Never execute it or scan user documents.
+#[tauri::command]
+pub(crate) fn resolve_app_input_rule(path: String) -> Result<AppRule, String> {
+    let selected = Path::new(&path);
+    if !selected.is_absolute() || !selected.extension().is_some_and(|e| e.eq_ignore_ascii_case("exe")) {
+        return Err("請選擇應用程式的完整 .exe 路徑。".into());
+    }
+    let canonical = selected.canonicalize().map_err(|_| "無法確認程式路徑，請選擇已安裝的應用程式。")?;
+    if !canonical.is_file() { return Err("選取的項目不是程式檔案。".into()); }
+    let raw = canonical.to_str().ok_or("程式路徑含有無法辨識的字元。")?;
+    let app_id = normalize_path(raw).ok_or("目前僅支援本機磁碟上的應用程式。")?;
+    let display_name = canonical.file_name().and_then(|s| s.to_str()).ok_or("無法辨識程式名稱。")?.to_string();
+    Ok(AppRule { app_id, display_name, mode: "english" })
+}
+
+fn normalize_path(path: &str) -> Option<String> {
+    let path = path.strip_prefix(r"\\?\").unwrap_or(path).replace('/', "\\");
+    let b = path.as_bytes();
+    if b.len() < 4 || !b[0].is_ascii_alphabetic() || b[1] != b':' || b[2] != b'\\'
+        || path.chars().any(char::is_control) || path.len() > 32767 { return None; }
+    Some(path.to_lowercase())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn local_identity_is_case_insensitive_and_accepts_extended_prefix() {
+        assert_eq!(normalize_path(r"\\?\C:\Apps\Editor.EXE"), Some(r"c:\apps\editor.exe".into()));
+        assert_eq!(normalize_path("C:/Apps/Editor.exe"), Some(r"c:\apps\editor.exe".into()));
+    }
+    #[test]
+    fn rejects_network_relative_device_and_control_paths() {
+        for p in [r"\\host\apps\a.exe", r"\\?\UNC\host\a.exe", r"a.exe", r"C:a.exe", r"\\.\device", "C:\\bad\n.exe"] {
+            assert!(normalize_path(p).is_none(), "{p}");
+        }
+    }
+}
