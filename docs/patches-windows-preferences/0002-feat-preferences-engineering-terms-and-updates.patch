diff --git a/src-tauri/src/updates.rs b/src-tauri/src/updates.rs
new file mode 100644
index 0000000..4f5110f
--- /dev/null
+++ b/src-tauri/src/updates.rs
@@ -0,0 +1,147 @@
+// SPDX-FileCopyrightText: 2026 AI Chewing contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use semver::Version;
+use serde::{Deserialize, Serialize};
+use std::time::Duration;
+
+const API: &str = "https://api.github.com/repos/edwardhome/chewing-kanata-lab/releases/latest";
+const REPOSITORY: &str = "https://github.com/edwardhome/chewing-kanata-lab/releases";
+const MAX_METADATA: u64 = 512 * 1024;
+
+#[derive(Deserialize)]
+struct Release {
+    tag_name: String,
+    draft: bool,
+    prerelease: bool,
+    html_url: String,
+    assets: Vec<Asset>,
+}
+
+#[derive(Deserialize)]
+struct Asset {
+    name: String,
+    browser_download_url: String,
+    size: u64,
+    state: String,
+}
+
+#[derive(Serialize)]
+pub struct UpdateStatus {
+    current_version: String,
+    latest_version: String,
+    update_available: bool,
+    release_url: String,
+    download_url: Option<String>,
+}
+
+fn parse_release(bytes: &[u8], current: &str) -> Result<UpdateStatus, String> {
+    if bytes.len() as u64 > MAX_METADATA { return Err("更新資料超過大小上限。".into()); }
+    let release: Release = serde_json::from_slice(bytes).map_err(|_| "GitHub 更新資料格式不正確。")?;
+    let latest = Version::parse(release.tag_name.strip_prefix('v').unwrap_or(&release.tag_name))
+        .map_err(|_| "GitHub 版本號格式不正確。")?;
+    let current = Version::parse(current).map_err(|_| "目前程式版本號格式不正確。")?;
+    if release.draft || release.prerelease || !latest.pre.is_empty() || !latest.build.is_empty()
+        || release.tag_name != format!("v{latest}")
+        || release.html_url != format!("{REPOSITORY}/tag/v{latest}")
+    { return Err("更新資料不是本專案的正式發布版本。".into()); }
+    let expected_name = format!("AI-Chewing-Windows-x64-{latest}.zip");
+    let expected_url = format!("{REPOSITORY}/download/v{latest}/{expected_name}");
+    let download_url = release.assets.iter().find(|asset| {
+        asset.name == expected_name && asset.browser_download_url == expected_url
+            && asset.size > 0 && asset.state == "uploaded"
+    }).map(|asset| asset.browser_download_url.clone());
+    Ok(UpdateStatus {
+        current_version: current.to_string(), latest_version: latest.to_string(),
+        update_available: latest > current, release_url: release.html_url, download_url,
+    })
+}
+
+fn fetch_update() -> Result<UpdateStatus, String> {
+    // Only an explicit button press invokes this request. No typing data or token.
+    let agent = ureq::Agent::config_builder()
+        .timeout_connect(Some(Duration::from_secs(3)))
+        .timeout_global(Some(Duration::from_secs(8)))
+        .max_redirects(0)
+        .max_response_header_size(16 * 1024)
+        .http_status_as_error(false)
+        .build().new_agent();
+    let mut response = agent.get(API)
+        .header("User-Agent", "AI-Chewing-Update-Check")
+        .header("Accept", "application/vnd.github+json")
+        .header("X-GitHub-Api-Version", "2022-11-28")
+        .call().map_err(|_| "無法連線至 GitHub 或連線逾時，請稍後重試。")?;
+    match response.status().as_u16() {
+        200 => {},
+        403 | 429 => return Err("GitHub 暫時限制查詢次數，請稍後再試。".into()),
+        404 => return Err("目前找不到正式發布版本。".into()),
+        _ => return Err("GitHub 暫時無法提供更新資訊。".into()),
+    }
+    let bytes = response.body_mut().with_config().limit(MAX_METADATA).read_to_vec()
+        .map_err(|_| "更新資料讀取失敗、逾時或超過大小上限。")?;
+    parse_release(&bytes, env!("CARGO_PKG_VERSION"))
+}
+
+#[tauri::command]
+pub async fn check_for_updates() -> Result<UpdateStatus, String> {
+    tauri::async_runtime::spawn_blocking(fetch_update).await
+        .map_err(|_| "更新查詢未完成，請稍後重試。")?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::{json, Value};
+    fn fixture(version: &str) -> Value {
+        let name = format!("AI-Chewing-Windows-x64-{version}.zip");
+        json!({"tag_name":format!("v{version}"),"draft":false,"prerelease":false,
+            "html_url":format!("{REPOSITORY}/tag/v{version}"),"assets":[{
+                "name":name,"browser_download_url":format!("{REPOSITORY}/download/v{version}/{name}"),
+                "size":100,"state":"uploaded"}]})
+    }
+    fn parse(value: Value, current: &str) -> Result<UpdateStatus, String> {
+        parse_release(&serde_json::to_vec(&value).unwrap(), current)
+    }
+    #[test]
+    fn semantic_order_no_downgrade_and_development_version() {
+        assert!(parse(fixture("1.0.10"), "1.0.2").unwrap().update_available);
+        assert!(!parse(fixture("1.0.1"), "1.0.2").unwrap().update_available);
+        assert!(!parse(fixture("1.0.2"), "1.0.2").unwrap().update_available);
+        assert!(parse(fixture("1.0.2"), "1.0.2-dev").unwrap().update_available);
+    }
+    #[test]
+    fn reject_preview_draft_invalid_version_and_foreign_page() {
+        for key in ["draft", "prerelease"] {
+            let mut value = fixture("1.0.2"); value[key] = json!(true);
+            assert!(parse(value, "1.0.1").is_err());
+        }
+        assert!(parse(fixture("1.0.2-preview"), "1.0.1").is_err());
+        assert!(parse(fixture("../../bad"), "1.0.1").is_err());
+        let mut value = fixture("1.0.2"); value["html_url"] = json!("https://example.invalid");
+        assert!(parse(value, "1.0.1").is_err());
+    }
+    #[test]
+    fn only_exact_uploaded_windows_asset_is_offered() {
+        assert!(parse(fixture("1.0.2"), "1.0.1").unwrap().download_url.is_some());
+        for (field, replacement) in [("name", json!("Source.zip")),
+            ("browser_download_url", json!("https://example.invalid/file.zip")),
+            ("size", json!(0)), ("state", json!("new"))] {
+            let mut value = fixture("1.0.2"); value["assets"][0][field] = replacement;
+            assert!(parse(value, "1.0.1").unwrap().download_url.is_none());
+        }
+        let mut value = fixture("1.0.2"); value["assets"] = json!([]);
+        assert!(parse(value, "1.0.1").unwrap().download_url.is_none());
+    }
+    #[test]
+    #[ignore = "Explicit read-only GitHub connectivity probe"]
+    fn live_github_release_metadata() {
+        let status = fetch_update().expect("GitHub release lookup failed");
+        assert!(status.release_url.starts_with(REPOSITORY));
+        assert!(!status.latest_version.is_empty());
+    }
+    #[test]
+    fn reject_invalid_or_oversized_metadata() {
+        assert!(parse_release(b"not json", "1.0.1").is_err());
+        assert!(parse_release(&vec![b' '; MAX_METADATA as usize + 1], "1.0.1").is_err());
+    }
+}
