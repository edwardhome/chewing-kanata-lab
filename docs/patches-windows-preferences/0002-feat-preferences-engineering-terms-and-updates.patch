index 0000000..1990215
--- /dev/null
+++ b/src-tauri/src/engineering.rs
@@ -0,0 +1,154 @@
+// SPDX-FileCopyrightText: 2026 AI Chewing contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use chewing_policy_core::user_engineering::{UserEngineeringTerm, UserTermsError,
+    parse_user_terms, encode_user_terms, parse_user_terms_text,
+    MAX_USER_TERMS_BYTES, USER_TERMS_FILENAME, ENGINEERING_TEXT_TEMPLATE};
+use serde::Serialize;
+use std::{fs, io::{Read, Write}, path::{Path, PathBuf}};
+
+#[derive(Serialize)]
+pub struct EngineeringSnapshot { terms: Vec<UserEngineeringTerm>, revision: Option<String> }
+
+fn terms_error(error: UserTermsError) -> String {
+    match error {
+        UserTermsError::TooLarge => "詞條數量或檔案太大，最多 500 筆、256 KiB。",
+        UserTermsError::InvalidFormat => "詞庫格式不正確；文本請使用 Tab 分隔三欄，不要加入 Markdown 圍欄。",
+        UserTermsError::InvalidTerm => "詞條格式不正確，請檢查輸入碼、長度與不可見字元。",
+        UserTermsError::Duplicate => "有重複的輸入碼與候選文字，請刪除重複列後再儲存。",
+    }.into()
+}
+fn directory() -> Result<PathBuf, String> {
+    std::env::var_os("APPDATA").map(|p| PathBuf::from(p).join("ChewingDev"))
+        .ok_or_else(|| "無法取得使用者資料目錄。".into())
+}
+fn read_bounded(path: &Path) -> Result<Option<Vec<u8>>, String> {
+    let file = match fs::File::open(path) {
+        Ok(file) => file,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err("無法讀取詞庫，原有檔案未變更。".into()),
+    };
+    let mut bytes = Vec::new();
+    file.take((MAX_USER_TERMS_BYTES + 1) as u64).read_to_end(&mut bytes)
+        .map_err(|_| "讀取詞庫失敗。")?;
+    if bytes.len() > MAX_USER_TERMS_BYTES { return Err(terms_error(UserTermsError::TooLarge)); }
+    Ok(Some(bytes))
+}
+fn load_at(path: &Path) -> Result<EngineeringSnapshot, String> {
+    match read_bounded(path)? {
+        None => Ok(EngineeringSnapshot { terms: vec![], revision: None }),
+        Some(bytes) => {
+            let terms = parse_user_terms(&bytes).map_err(terms_error)?;
+            let revision = Some(String::from_utf8(bytes).map_err(|_| "詞庫不是 UTF-8。")?);
+            Ok(EngineeringSnapshot { terms, revision })
+        }
+    }
+}
+fn save_at(directory: &Path, terms: Vec<UserEngineeringTerm>, expected: Option<String>) -> Result<EngineeringSnapshot, String> {
+    let bytes = encode_user_terms(&terms).map_err(terms_error)?;
+    fs::create_dir_all(directory).map_err(|_| "無法建立詞庫目錄。")?;
+    let lock = fs::OpenOptions::new().read(true).write(true).create(true).truncate(false)
+        .open(directory.join("engineering-terms.lock")).map_err(|_| "無法開啟詞庫鎖定檔。")?;
+    fs2::FileExt::try_lock_exclusive(&lock).map_err(|_| "另一個設定視窗正在儲存，請稍後重試。")?;
+    let path = directory.join(USER_TERMS_FILENAME);
+    if load_at(&path)?.revision != expected {
+        return Err("詞庫已被另一個視窗修改，請重新載入後再編輯；您的編輯內容仍保留在本視窗。".into());
+    }
+    let mut temp = tempfile::NamedTempFile::new_in(directory).map_err(|_| "無法建立暫存詞庫。")?;
+    temp.write_all(&bytes).and_then(|_| temp.as_file().sync_all()).map_err(|_| "儲存失敗，原有詞庫未變更。")?;
+    temp.persist(&path).map_err(|_| "無法替換詞庫，原有詞庫未變更。")?;
+    // Return the bytes just persisted while the lock is still held.
+    load_at(&path)
+}
+
+#[tauri::command]
+pub async fn load_engineering_terms() -> Result<EngineeringSnapshot, String> {
+    tauri::async_runtime::spawn_blocking(|| load_at(&directory()?.join(USER_TERMS_FILENAME)))
+        .await.map_err(|_| "讀取詞庫未完成。")?
+}
+#[tauri::command]
+pub async fn save_engineering_terms(terms: Vec<UserEngineeringTerm>, expected: Option<String>) -> Result<EngineeringSnapshot, String> {
+    tauri::async_runtime::spawn_blocking(move || save_at(&directory()?, terms, expected))
+        .await.map_err(|_| "儲存詞庫未完成。")?
+}
+
+#[tauri::command]
+pub async fn open_engineering_text() -> Result<(), String> {
+    tauri::async_runtime::spawn_blocking(|| {
+        let dir = directory()?;
+        fs::create_dir_all(&dir).map_err(|_| "無法建立詞庫目錄。")?;
+        let path = dir.join("engineering-terms.draft.txt");
+        match fs::OpenOptions::new().write(true).create_new(true).open(&path) {
+            Ok(mut file) => file.write_all(ENGINEERING_TEXT_TEMPLATE.as_bytes()).map_err(|_| "無法寫入範本。")?,
+            Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {},
+            Err(_) => return Err("無法建立編輯文本。".into()),
+        }
+        let windows = std::env::var_os("SystemRoot").ok_or("無法取得記事本位置。")?;
+        std::process::Command::new(PathBuf::from(windows).join("System32").join("notepad.exe"))
+            .arg(path).spawn().map_err(|_| "無法開啟記事本。")?;
+        Ok(())
+    }).await.map_err(|_| "開啟文本未完成。")?
+}
+#[tauri::command]
+pub async fn read_engineering_text() -> Result<Vec<UserEngineeringTerm>, String> {
+    tauri::async_runtime::spawn_blocking(|| {
+        let bytes = read_bounded(&directory()?.join("engineering-terms.draft.txt"))?
+            .ok_or("請先開啟工程詞彙文本，編輯並儲存後再匯入。")?;
+        parse_user_terms_text(&bytes).map_err(terms_error)
+    }).await.map_err(|_| "匯入文本未完成。")?
+}
+
+#[tauri::command]
+pub async fn export_engineering_text() -> Result<(), String> {
+    tauri::async_runtime::spawn_blocking(|| {
+        let dir = directory()?;
+        let snapshot = load_at(&dir.join(USER_TERMS_FILENAME))?;
+        fs::create_dir_all(&dir).map_err(|_| "無法建立詞庫目錄。")?;
+        let mut text = ENGINEERING_TEXT_TEMPLATE.to_owned();
+        for term in snapshot.terms { text.push_str(&format!("{}\t{}\t{}\n", term.input, term.output, term.annotation)); }
+        let mut file = tempfile::Builder::new().prefix("engineering-export-").suffix(".txt")
+            .tempfile_in(&dir).map_err(|_| "無法建立匯出文本。")?;
+        file.write_all(text.as_bytes()).map_err(|_| "無法寫入匯出文本。")?;
+        let (_, path) = file.keep().map_err(|_| "無法保留匯出文本。")?;
+        let windows = std::env::var_os("SystemRoot").ok_or("無法取得記事本位置。")?;
+        std::process::Command::new(PathBuf::from(windows).join("System32").join("notepad.exe"))
+            .arg(path).spawn().map_err(|_| "無法開啟記事本。")?;
+        Ok(())
+    }).await.map_err(|_| "匯出文本未完成。")?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn terms() -> Vec<UserEngineeringTerm> {
+        vec![UserEngineeringTerm { input: "CH4".into(), output: "CH₄".into(), annotation: "甲烷".into() }]
+    }
+    #[test]
+    fn create_edit_delete_and_restart_preserve_user_terms() {
+        let dir = tempfile::tempdir().unwrap(); let path = dir.path().join(USER_TERMS_FILENAME);
+        assert!(load_at(&path).unwrap().terms.is_empty());
+        let saved = save_at(dir.path(), terms(), None).unwrap();
+        assert_eq!(load_at(&path).unwrap().terms, terms());
+        let deleted = save_at(dir.path(), vec![], saved.revision).unwrap();
+        assert!(deleted.terms.is_empty());
+        assert!(load_at(&path).unwrap().terms.is_empty());
+    }
+    #[test]
+    fn invalid_or_conflicting_save_never_overwrites_existing_file() {
+        let dir = tempfile::tempdir().unwrap(); let path = dir.path().join(USER_TERMS_FILENAME);
+        let saved = save_at(dir.path(), terms(), None).unwrap();
+        let before = fs::read(&path).unwrap();
+        assert!(save_at(dir.path(), vec![], None).is_err());
+        let mut invalid = terms(); invalid[0].input = " ".into();
+        assert!(save_at(dir.path(), invalid, saved.revision).is_err());
+        assert_eq!(fs::read(&path).unwrap(), before);
+    }
+    #[test]
+    fn malformed_file_is_not_silently_replaced() {
+        let dir = tempfile::tempdir().unwrap(); let path = dir.path().join(USER_TERMS_FILENAME);
+        fs::write(&path, b"malformed").unwrap();
+        assert!(load_at(&path).is_err());
+        assert!(save_at(dir.path(), terms(), Some("malformed".into())).is_err());
+        assert_eq!(fs::read(&path).unwrap(), b"malformed");
+    }
+}
