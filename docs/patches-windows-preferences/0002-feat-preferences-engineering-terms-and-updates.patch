diff --git a/src/EngineeringTerms.tsx b/src/EngineeringTerms.tsx
new file mode 100644
index 0000000..49c78cf
--- /dev/null
+++ b/src/EngineeringTerms.tsx
@@ -0,0 +1,90 @@
+// SPDX-FileCopyrightText: 2026 AI Chewing contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+import { useEffect, useState } from "react";
+import { Button, Input, Text } from "@fluentui/react-components";
+import { invoke } from "@tauri-apps/api/core";
+import { ask } from "@tauri-apps/plugin-dialog";
+
+type Term = { input: string; output: string; annotation: string };
+type Snapshot = { terms: Term[]; revision: string | null };
+
+export default function EngineeringTerms({ onDirtyChange }: { onDirtyChange: (dirty: boolean) => void }) {
+  const [terms, setTerms] = useState<Term[]>([]);
+  const [revision, setRevision] = useState<string | null>(null);
+  const [loaded, setLoaded] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [dirty, setDirty] = useState(false);
+  const [status, setStatus] = useState("");
+  const [error, setError] = useState("");
+  useEffect(() => { onDirtyChange(dirty); }, [dirty, onDirtyChange]);
+  async function load() {
+    setBusy(true); setError("");
+    try {
+      const data = await invoke<Snapshot>("load_engineering_terms");
+      setTerms(data.terms); setRevision(data.revision); setLoaded(true); setDirty(false); setStatus("");
+    } catch (e) { setError(String(e)); }
+    finally { setBusy(false); }
+  }
+  useEffect(() => { void load(); }, []);
+  function edit(next: Term[]) { setTerms(next); setDirty(true); setStatus("尚未儲存"); setError(""); }
+  async function save() {
+    setBusy(true); setError("");
+    try {
+      const data = await invoke<Snapshot>("save_engineering_terms", { terms, expected: revision });
+      setTerms(data.terms); setRevision(data.revision); setDirty(false);
+      setStatus("詞彙已儲存。請重新開啟使用輸入法的應用程式後測試。");
+    } catch (e) { setError(String(e)); }
+    finally { setBusy(false); }
+  }
+  async function textAction(command: string) {
+    setBusy(true); setError("");
+    try {
+      if (command === "read_engineering_text") {
+        const imported = await invoke<Term[]>(command);
+        const merged = [...terms];
+        for (const row of imported) {
+          if (!merged.some(old => old.input.toLowerCase() === row.input.toLowerCase() && old.output === row.output)) merged.push(row);
+        }
+        const added = merged.length - terms.length;
+        if (added) edit(merged);
+        setStatus(`新增 ${added} 筆至預覽；相同輸入碼與候選已略過。請檢查後按「儲存詞彙」。`);
+      } else { await invoke(command); setStatus("已開啟文本。批次編輯文本儲存後，請按「從文本匯入」。"); }
+    } catch (e) { setError(String(e)); }
+    finally { setBusy(false); }
+  }
+  async function reload() {
+    if (dirty && !await ask("重新載入會捨棄本視窗尚未儲存的詞彙編輯，是否繼續？", { title: "重新載入詞彙", kind: "warning" })) return;
+    await load();
+  }
+  return <section aria-label="自訂工程詞彙" style={{ margin: 16, display: "flex", flexDirection: "column", gap: 12 }}>
+    <Text>輸入碼例如 H2O，候選文字填 H₂O，註解填「水」。原文仍保留，選取候選才會送出。</Text>
+    <Text>只編輯您的自訂詞條，內建詞庫會繼續提供候選。此頁請按「儲存詞彙」；儲存後重新開啟使用輸入法的應用程式生效。</Text>
+    <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
+      <Button type="button" disabled={busy || !loaded || terms.length >= 500} onClick={() => edit([...terms, { input: "", output: "", annotation: "" }])}>新增詞條</Button>
+      <Button type="button" appearance="primary" disabled={busy || !loaded || !dirty} onClick={() => void save()}>儲存詞彙</Button>
+      <Button type="button" disabled={busy} onClick={() => void reload()}>重新載入</Button>
+    </div>
+    <div style={{ maxHeight: 310, overflowY: "auto" }}>
+      <table style={{ width: "100%" }}><thead><tr><th>輸入碼</th><th>候選文字</th><th>註解</th><th>操作</th></tr></thead>
+        <tbody>{terms.map((term, index) => <tr key={index}>
+          {(["input", "output", "annotation"] as const).map((field, col) => <td key={field}>
+            <Input aria-label={`第 ${index + 1} 筆${["輸入碼", "候選文字", "註解"][col]}`}
+              style={{ width: "100%", minWidth: 50 }} value={term[field]} disabled={busy}
+              onChange={(_, data) => edit(terms.map((row, n) => n === index ? { ...row, [field]: data.value } : row))} />
+          </td>)}
+          <td><Button type="button" disabled={busy} onClick={() => edit(terms.filter((_, n) => n !== index))}>刪除</Button></td>
+        </tr>)}</tbody>
+      </table>
+      {loaded && terms.length === 0 && <Text>尚無自訂詞條，按「新增詞條」開始。</Text>}
+    </div>
+    <Text weight="semibold">批次編輯與大模型協作</Text>
+    <Text>文本附格式說明、範例與可貼給 GPT／其他模型的提示詞。既有批次文本會保留；模型產出的內容須先匯入預覽，再自行儲存。</Text>
+    <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
+      <Button type="button" disabled={busy} onClick={() => void textAction("open_engineering_text")}>開啟工程詞彙文本</Button>
+      <Button type="button" disabled={busy || !loaded} onClick={() => void textAction("read_engineering_text")}>從文本匯入</Button>
+      <Button type="button" disabled={busy || !loaded || dirty} onClick={() => void textAction("export_engineering_text")}>匯出已儲存詞彙與提示詞</Button>
+    </div>
+    <div aria-live="polite">{status && <Text>{status}</Text>}{error && <Text role="alert">{error}</Text>}</div>
+  </section>;
+}
diff --git a/src/Updates.tsx b/src/Updates.tsx
new file mode 100644
index 0000000..bccb965
--- /dev/null
+++ b/src/Updates.tsx
@@ -0,0 +1,53 @@
+// SPDX-FileCopyrightText: 2026 AI Chewing contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+import { useState } from "react";
+import { Button, Text } from "@fluentui/react-components";
+import { invoke } from "@tauri-apps/api/core";
+import { getVersion } from "@tauri-apps/api/app";
+import { openUrl } from "@tauri-apps/plugin-opener";
+import { useEffect } from "react";
+
+type UpdateStatus = {
+  current_version: string;
+  latest_version: string;
+  update_available: boolean;
+  release_url: string;
+  download_url: string | null;
+};
+
+export default function Updates() {
+  const [current, setCurrent] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [result, setResult] = useState<UpdateStatus | null>(null);
+  const [error, setError] = useState("");
+  useEffect(() => { void getVersion().then(setCurrent).catch(() => setCurrent("無法讀取")); }, []);
+  async function check() {
+    setBusy(true); setError(""); setResult(null);
+    try { setResult(await invoke<UpdateStatus>("check_for_updates")); }
+    catch (e) { setError(typeof e === "string" ? e : "更新查詢失敗，請稍後重試。"); }
+    finally { setBusy(false); }
+  }
+  async function open(url: string) {
+    try { await openUrl(url); }
+    catch { setError("無法開啟瀏覽器，請稍後重試。"); }
+  }
+  return <section aria-label="軟體更新" style={{ marginTop: 24, display: "flex", flexDirection: "column", gap: 12 }}>
+    <Text weight="semibold">軟體更新</Text>
+    <Text>目前版本：{current || "讀取中"}</Text>
+    <Text>按下檢查才會連線至 GitHub。下載由瀏覽器處理，安裝由您自行執行。</Text>
+    <Button type="button" disabled={busy} onClick={() => void check()}>{busy ? "檢查中…" : "檢查更新"}</Button>
+    <div aria-live="polite">
+      {result && <Text>{result.update_available
+        ? `發現新版本 ${result.latest_version}`
+        : `目前無較新的正式版本（GitHub 最新：${result.latest_version}）。`}</Text>}
+      {error && <Text role="alert">{error}</Text>}
+    </div>
+    {result && <>
+      {result.update_available && result.download_url &&
+        <Button type="button" appearance="primary" onClick={() => void open(result.download_url!)}>下載 Windows x64 安裝套件</Button>}
+      {result.update_available && !result.download_url && <Text>此版本尚未提供 Windows x64 安裝套件。</Text>}
+      <Button type="button" onClick={() => void open(result.release_url)}>查看 GitHub 發布說明</Button>
+    </>}
+  </section>;
+}
