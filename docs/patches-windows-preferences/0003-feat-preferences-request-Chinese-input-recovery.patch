+// SPDX-FileCopyrightText: 2026 AI Chewing contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use serde::Serialize;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+#[derive(Serialize)]
+pub struct RecoveryRequest {
+    request_id: u64,
+    expires_in_seconds: u32,
+}
+
+/// A short-lived request, not an acknowledgement that an input context recovered.
+/// Native instances consume it on their own TSF thread after checking the context.
+#[tauri::command]
+pub async fn request_input_recovery() -> Result<RecoveryRequest, String> {
+    tauri::async_runtime::spawn_blocking(|| {
+        let request_id = u64::try_from(SystemTime::now().duration_since(UNIX_EPOCH)
+            .map_err(|_| "系統時間不正確，無法送出恢復要求。")?.as_millis())
+            .map_err(|_| "系統時間超出範圍，無法送出恢復要求。")?;
+        let key = windows_registry::CURRENT_USER.options().create().write()
+            .open("Software\\ChewingDev")
+            .map_err(|_| "無法開啟 AI新酷音的恢復通道，請確認使用者權限。")?;
+        key.set_u64("InputRecoveryRequest", request_id)
+            .map_err(|_| "無法送出恢復要求，請稍後再試。")?;
+        Ok(RecoveryRequest { request_id, expires_in_seconds: 30 })
+    }).await.map_err(|_| "恢復要求未能送出，請稍後再試。")?
+}
