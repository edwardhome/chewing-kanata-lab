new file mode 100644
index 0000000..1c1d17d
--- /dev/null
+++ b/src/Recovery.tsx
@@ -0,0 +1,31 @@
+// SPDX-FileCopyrightText: 2026 AI Chewing contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+import { useState } from "react";
+import { Button, Text } from "@fluentui/react-components";
+import { invoke } from "@tauri-apps/api/core";
+
+type Request = { request_id: number; expires_in_seconds: number };
+
+export default function Recovery() {
+  const [busy, setBusy] = useState(false);
+  const [status, setStatus] = useState("");
+  const [error, setError] = useState("");
+  async function restart() {
+    setBusy(true); setStatus(""); setError("");
+    try {
+      const request = await invoke<Request>("request_input_recovery");
+      setStatus(`已送出恢復要求。請在 ${request.expires_in_seconds} 秒內回到原本的輸入欄位，放開 Shift／Ctrl／Alt／Win／F 後再輸入。若仍有組字，請先完成或自行取消。`);
+    } catch (e) { setError(typeof e === "string" ? e : "恢復要求未能送出，請稍後再試。"); }
+    finally { setBusy(false); }
+  }
+  return <section aria-label="輸入法恢復" style={{ marginTop: 24, display: "flex", flexDirection: "column", gap: 12 }}>
+    <Text weight="semibold">輸入法恢復</Text>
+    <Text>顯示中文卻只能打英文時，可重新初始化輸入狀態並恢復中文。請先完成或取消未送出的組字。</Text>
+    <Button type="button" disabled={busy} onClick={() => void restart()}>
+      {busy ? "送出中…" : "Restart：恢復中文輸入"}
+    </Button>
+    <Text>此功能恢復輸入狀態；更新程式後仍需重新開啟應用，才能載入新版輸入法。</Text>
+    <div aria-live="polite">{status && <Text>{status}</Text>}{error && <Text role="alert">{error}</Text>}</div>
+  </section>;
+}
