+// SPDX-FileCopyrightText: 2026 AI Chewing contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/**
+ * Task UNIFIED-UI-1109
+ * 台灣繁體中文 (Taiwan Traditional Chinese) 離線統一詞彙管理介面
+ * 
+ * 核心契約核對 (Backend Contract Reference):
+ * - unified_lexicon_status -> { revision, enabled, recovered, value, previous }
+ * - unified_lexicon_read({ path }) -> UnifiedLexicon
+ * - unified_lexicon_preview({ value, expected, replace, selected, incomingConflicts }) -> Preview
+ * - unified_lexicon_edit({ entry, oldId, deleteIds, expected }) -> Preview
+ * - unified_lexicon_approve({ token, confirmed: true }) -> Status
+ * - unified_lexicon_cancel({ token }) -> void
+ * - unified_lexicon_export({ path, selected, expected, json }) -> void
+ * - unified_lexicon_rollback({ expected, confirmed: true }) -> Status
+ * - unified_lexicon_enabled({ expected, enabled }) -> Status
+ */
+
+import { useEffect, useMemo, useState } from "react";
+import {
+  Badge,
+  Button,
+  Card,
+  Checkbox,
+  Dialog,
+  DialogActions,
+  DialogBody,
+  DialogContent,
+  DialogSurface,
+  DialogTitle,
+  DialogTrigger,
+  Field,
+  Input,
+  Select,
+  Text,
+  Textarea,
+  Tooltip,
+} from "@fluentui/react-components";
+import { invoke } from "@tauri-apps/api/core";
+import { ask, open, save } from "@tauri-apps/plugin-dialog";
+
+export interface Entry {
+  entry_id: string;
+  term_type: string;
+  reading: string;
+  text: string;
+  annotation?: string;
+  alias?: string;
+  alias_reading?: string;
+  category?: string;
+  source?: string;
+  review?: {
+    status: string;
+    user_confirmed: boolean;
+  };
+  usage?: unknown;
+  model_suggestion?: unknown;
+  sources?: string[];
+  policy?: string;
+}
+
+export interface Relation {
+  source_id: string;
+  target_id: string;
+  kind: "equivalent" | string;
+}
+
+export interface LexiconDocument {
+  dictionary_version?: string;
+  entries: Entry[];
+  [key: string]: unknown;
+}
+
+export interface UnifiedLexicon {
+  document: LexiconDocument;
+  relations: Relation[];
+}
+
+export interface Status {
+  revision: string | null;
+  enabled: boolean;
+  recovered: boolean;
+  value: UnifiedLexicon;
+  previous: boolean;
+}
+
+export interface Conflict {
+  existing: Entry;
+  incoming: Entry;
+}
+
+export interface Preview {
+  token: string;
+  value: UnifiedLexicon;
+  conflicts: Conflict[];
+  replace: boolean;
+  expandedCount: number;
+}
+
+export interface EditEntryInput {
+  term_type: string;
+  reading: string;
+  text: string;
+  annotation?: string;
+  alias?: string;
+  alias_reading?: string;
+}
+
+const PAGE_SIZE = 50;
+
+export default function UnifiedLexiconManager() {
+  // 核心狀態
+  const [status, setStatus] = useState<Status | null>(null);
+  const [preview, setPreview] = useState<Preview | null>(null);
+  const [previewSource, setPreviewSource] = useState<UnifiedLexicon | null>(null);
+  const [previewSelectedIds, setPreviewSelectedIds] = useState<string[] | null>(null);
+  const [incomingConflicts, setIncomingConflicts] = useState<string[]>([]);
+
+  // 匯入來源選取狀態 (在產生 preview 之前)
+  const [importedCandidate, setImportedCandidate] = useState<UnifiedLexicon | null>(null);
+  const [importCandidateSelectedIds, setImportCandidateSelectedIds] = useState<Set<string>>(new Set());
+  const [isImportSelectorOpen, setIsImportSelectorOpen] = useState(false);
+  const [importPath, setImportPath] = useState<string>("");
+
+  // CRUD 表單狀態
+  const [isEditModalOpen, setIsEditModalOpen] = useState(false);
+  const [editingOldId, setEditingOldId] = useState<string | null>(null);
+  const [formTermType, setFormTermType] = useState<string>("phrase");
+  const [formReading, setFormReading] = useState<string>("");
+  const [formText, setFormText] = useState<string>("");
+  const [formAnnotation, setFormAnnotation] = useState<string>("");
+  const [formAlias, setFormAlias] = useState<string>("");
+  const [formAliasReading, setFormAliasReading] = useState<string>("");
+
+  // 表格與分頁狀態
+  const [query, setQuery] = useState("");
+  const [typeFilter, setTypeFilter] = useState("all");
+  const [page, setPage] = useState(0);
+  const [selectedRowIds, setSelectedRowIds] = useState<Set<string>>(new Set());
+
+  // 系統訊息與忙碌狀態
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [message, setMessage] = useState("");
+
+  // 統一非同步包裝器
+  async function act(work: () => Promise<void>) {
+    setBusy(true);
+    setError("");
+    try {
+      await work();
+    } catch (e) {
+      setError(String(e));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  // 讀取目前詞庫狀態
+  async function refresh(invalidateExistingPreview = false) {
+    await act(async () => {
+      if (invalidateExistingPreview && preview) {
+        try {
+          await invoke("unified_lexicon_cancel", { token: preview.token });
+        } catch {
+          // 忽略清理時的次要錯誤
+        }
+        setPreview(null);
+        setPreviewSource(null);
+        setPreviewSelectedIds(null);
+        setIncomingConflicts([]);
+      }
+      const data = await invoke<Status>("unified_lexicon_status");
+      setStatus(data);
+      setSelectedRowIds(new Set());
+    });
+  }
+
+  // 初始載入
+  useEffect(() => {
+    void refresh(false);
+  }, []);
+
+  // 啟用 / 停用切換
+  async function handleToggleEnabled(nextEnabled: boolean) {
+    if (!status) return;
+    await act(async () => {
+      const nextStatus = await invoke<Status>("unified_lexicon_enabled", {
+        expected: status.revision,
+        enabled: nextEnabled,
+      });
+      setStatus(nextStatus);
+      setMessage(nextEnabled ? "統一詞庫已啟用。" : "統一詞庫已停用。");
+    });
+  }
+
+  // 回復上一版
+  async function handleRollback() {
+    if (!status || !status.previous) return;
+    const ok = await ask(
+      "確定要回復到上一版統一詞庫快照嗎？目前的未儲存自訂變更將被回復。",
+      { title: "回復上一版詞庫", kind: "warning" }
+    );
+    if (!ok) return;
+
+    await act(async () => {
+      if (preview) {
+        try {
+          await invoke("unified_lexicon_cancel", { token: preview.token });
+        } catch {
+          // 忽略清理錯誤
+        }
+        setPreview(null);
+      }
+      const nextStatus = await invoke<Status>("unified_lexicon_rollback", {
+        expected: status.revision,
+        confirmed: true,
+      });
+      setStatus(nextStatus);
+      setMessage("已成功回復至上一版本快照。");
+    });
+  }
+
+  // 開啟新增表單
+  function handleOpenCreateModal() {
+    setEditingOldId(null);
+    setFormTermType("phrase");
+    setFormReading("");
+    setFormText("");
+    setFormAnnotation("");
+    setFormAlias("");
+    setFormAliasReading("");
+    setIsEditModalOpen(true);
+  }
+
+  // 開啟編輯表單
+  function handleOpenEditModal(entry: Entry) {
+    setEditingOldId(entry.entry_id);
+    setFormTermType(entry.term_type || "phrase");
+    setFormReading(entry.reading || "");
+    setFormText(entry.text || "");
+    setFormAnnotation(entry.annotation || "");
+    setFormAlias(entry.alias || "");
+    setFormAliasReading(entry.alias_reading || "");
+    setIsEditModalOpen(true);
+  }
+
+  // 提交 CRUD 變更 (進入預覽狀態，經核准後才正式生效)
+  async function handleSubmitEdit() {
+    if (!status) return;
+    const textTrimmed = formText.trim();
+    const readingTrimmed = formReading.trim();
+    if (!textTrimmed || !readingTrimmed) {
+      setError("詞條文字與注音讀音為必填項目。");
+      return;
+    }
+
+    const aliasTrimmed = formAlias.trim();
+    const aliasReadingTrimmed = formAliasReading.trim();
+    if (aliasTrimmed && !aliasReadingTrimmed) {
+      setError("若提供中文別名，必須同時填寫經確認之驗證讀音（系統不猜測讀音）。");
+      return;
+    }
+
+    const entryInput: EditEntryInput = {
+      term_type: formTermType.trim() || "phrase",
+      reading: readingTrimmed,
+      text: textTrimmed,
+      annotation: formAnnotation.trim() || undefined,
+      alias: aliasTrimmed || undefined,
+      alias_reading: aliasReadingTrimmed || undefined,
+    };
+
+    await act(async () => {
+      if (preview) {
+        try {
+          await invoke("unified_lexicon_cancel", { token: preview.token });
+        } catch {}
+      }
+      const p = await invoke<Preview>("unified_lexicon_edit", {
+        entry: entryInput,
+        oldId: editingOldId,
+        deleteIds: [],
+        expected: status.revision,
+      });
+      setPreview(p);
+      setPreviewSource(null);
+      setPreviewSelectedIds(null);
+      setIncomingConflicts([]);
+      setIsEditModalOpen(false);
+      setMessage("詞條異動已進入待核准預覽。請檢查預覽項目並點選「核准套用變更」正式寫入詞庫。");
+    });
+  }
+
+  // 刪除選定項目 (進入預覽狀態，提醒僅刪除管理副本)
+  async function handleDeleteEntries(idsToDelete: string[]) {
+    if (!status || idsToDelete.length === 0) return;
+    const ok = await ask(
+      `確定要刪除選定的 ${idsToDelete.length} 筆詞條嗎？\n\n【重要提示】此動作僅刪除統一詞庫管理副本，原始或系統新酷音詞庫仍可能提供同字之候選字。`,
+      { title: "刪除管理詞條確認", kind: "warning" }
+    );
+    if (!ok) return;
+
+    await act(async () => {
+      if (preview) {
+        try {
+          await invoke("unified_lexicon_cancel", { token: preview.token });
+        } catch {}
+      }
+      const p = await invoke<Preview>("unified_lexicon_edit", {
+        entry: null,
+        oldId: null,
+        deleteIds: idsToDelete,
+        expected: status.revision,
+      });
+      setPreview(p);
+      setPreviewSource(null);
+      setPreviewSelectedIds(null);
+      setIncomingConflicts([]);
+      setMessage(`已建立刪除 ${idsToDelete.length} 筆詞條之待核准預覽，請確認核准後正式生效。`);
+    });
+  }
+
+  // 匯入檔案 (SQLite 或 JSON)
+  async function handleImportFile() {
+    await act(async () => {
+      const path = await open({
+        multiple: false,
+        directory: false,
+        filters: [
+          { name: "統一詞庫 (SQLite / JSON)", extensions: ["sqlite", "db", "json"] },
+        ],
+      });
+      if (!path || typeof path !== "string") return;
+
+      setImportPath(path);
+      const incoming = await invoke<UnifiedLexicon>("unified_lexicon_read", { path });
+      setImportedCandidate(incoming);
+      // 預設全選
+      const allIds = new Set(incoming.document.entries.map((e) => e.entry_id));
+      setImportCandidateSelectedIds(allIds);
+      setIsImportSelectorOpen(true);
+      setMessage(`已讀取 ${path}，共 ${incoming.document.entries.length} 筆詞條。請勾選欲匯入之項目。`);
+    });
+  }
+
+  // 產生匯入預覽
+  async function handleGenerateImportPreview() {
+    if (!status || !importedCandidate) return;
+    const isAll = importCandidateSelectedIds.size === importedCandidate.document.entries.length;
+    const selectedArray = isAll ? null : Array.from(importCandidateSelectedIds);
+
+    await act(async () => {
+      if (preview) {
+        try {
+          await invoke("unified_lexicon_cancel", { token: preview.token });
+        } catch {}
+      }
+      const p = await invoke<Preview>("unified_lexicon_preview", {
+        value: importedCandidate,
+        expected: status.revision,
+        replace: false,
+        selected: selectedArray,
+        incomingConflicts: [],
+      });
+      setPreview(p);
+      setPreviewSource(importedCandidate);
+      setPreviewSelectedIds(selectedArray);
+      setIncomingConflicts([]);
+      setIsImportSelectorOpen(false);
+      setMessage(
+        `匯入預覽已產生（包含關聯閉包共 ${p.expandedCount} 筆相關項目）。請核對衝突項目並確認核准。`
+      );
+    });
+  }
+
+  // 全量覆蓋回復 (Full Restore，明確區隔並提供嚴肅警告)
+  async function handleFullRestore() {
+    if (!status) return;
+    const okFirst = await ask(
+      "【嚴正警告：全量覆蓋回復 (Full Restore)】\n\n此操作將以選定備份檔完整「取代並替換」目前的統一詞庫，既有的詞條與關聯將全數被清空覆蓋！\n\n確定要選擇備份檔案進行全量回復預覽嗎？",
+      { title: "全量覆蓋回復警告", kind: "error" }
+    );
+    if (!okFirst) return;
+
+    await act(async () => {
+      const path = await open({
+        multiple: false,
+        directory: false,
+        filters: [
+          { name: "統一詞庫備份 (SQLite / JSON)", extensions: ["sqlite", "db", "json"] },
+        ],
+      });
+      if (!path || typeof path !== "string") return;
+
+      const incoming = await invoke<UnifiedLexicon>("unified_lexicon_read", { path });
+      if (preview) {
+        try {
+          await invoke("unified_lexicon_cancel", { token: preview.token });
+        } catch {}
+      }
+
+      const p = await invoke<Preview>("unified_lexicon_preview", {
+        value: incoming,
+        expected: status.revision,
+        replace: true,
+        selected: null,
+        incomingConflicts: [],
+      });
+
+      setPreview(p);
+      setPreviewSource(incoming);
+      setPreviewSelectedIds(null);
+      setIncomingConflicts([]);
+      setMessage("【全量覆蓋回復預覽】已就緒。此預覽將完整替換現有詞庫，請審慎核准。");
+    });
+  }
+
+  // 重新計算衝突預覽 (當使用者切換 incomingConflicts 選擇時)
+  async function handleRepreviewConflicts(newConflicts: string[]) {
+    if (!status || !preview) return;
+    const sourceToUse = previewSource ?? preview.value;
+    await act(async () => {
+      const p = await invoke<Preview>("unified_lexicon_preview", {
+        value: sourceToUse,
+        expected: status.revision,
+        replace: preview.replace,
+        selected: previewSelectedIds,
+        incomingConflicts: newConflicts,
+      });
+      setPreview(p);
+      setIncomingConflicts(newConflicts);
+      setMessage(`已更新衝突採用設定（目前選取採用匯入衝突：${newConflicts.length} 筆）。`);
+    });
+  }
+
+  // 核准並正式寫入詞庫
+  async function handleApprovePreview() {
+    if (!preview) return;
+    const actionText = preview.replace
+      ? "全量覆蓋回復現有統一詞庫"
+      : `寫入並套用 ${preview.value.document.entries.length} 筆詞條`;
+
+    const ok = await ask(
+      `確定要核准預覽並正式${actionText}嗎？本操作完成後將更新本機管理詞庫版本。`,
+      { title: "確認核准並寫入", kind: "warning" }
+    );
+    if (!ok) return;
+
+    const token = preview.token;
+    await act(async () => {
+      try {
+        const nextStatus = await invoke<Status>("unified_lexicon_approve", {
+          token,
+          confirmed: true,
+        });
+        setStatus(nextStatus);
+        setMessage("變更已成功核准並寫入統一詞庫。");
+      } finally {
+        setPreview(null);
+        setPreviewSource(null);
+        setPreviewSelectedIds(null);
+        setIncomingConflicts([]);
+      }
+    });
+  }
+
+  // 取消預覽
+  async function handleCancelPreview() {
+    if (!preview) return;
+    const token = preview.token;
+    await act(async () => {
+      try {
+        await invoke("unified_lexicon_cancel", { token });
+      } finally {
+        setPreview(null);
+        setPreviewSource(null);
+        setPreviewSelectedIds(null);
+        setIncomingConflicts([]);
+        setMessage("已取消預覽，詞庫未作任何變更。");
+      }
+    });
+  }
+
+  // 匯出 SQLite
+  async function handleExportSqlite() {
+    if (!status) return;
+    const isSelected = selectedRowIds.size > 0;
+    const defaultName = `unified-lexicon-${new Date().toISOString().slice(0, 10)}.sqlite`;
+
+    await act(async () => {
+      const path = await save({
+        defaultPath: defaultName,
+        filters: [{ name: "SQLite 資料庫", extensions: ["sqlite", "db"] }],
+      });
+      if (!path || typeof path !== "string") return;
+
+      const selected = isSelected ? Array.from(selectedRowIds) : null;
+      await invoke("unified_lexicon_export", {
+        path,
+        selected,
+        expected: status.revision,
+        json: false,
+      });
+      setMessage(
+        `已成功匯出 ${isSelected ? `選定的 ${selectedRowIds.size} 筆` : "全量"} SQLite 詞庫至 ${path}。`
+      );
+    });
+  }
+
+  // 匯出舊版相容 JSON (僅在後端契約允許時成功)
+  async function handleExportJson() {
+    if (!status) return;
+    const isSelected = selectedRowIds.size > 0;
+    const defaultName = `unified-lexicon-${new Date().toISOString().slice(0, 10)}.json`;
+
+    await act(async () => {
+      const path = await save({
+        defaultPath: defaultName,
+        filters: [{ name: "舊版相容 JSON 詞庫", extensions: ["json"] }],
+      });
+      if (!path || typeof path !== "string") return;
+
+      const selected = isSelected ? Array.from(selectedRowIds) : null;
+      await invoke("unified_lexicon_export", {
+        path,
+        selected,
+        expected: status.revision,
+        json: true,
+      });
+      setMessage(
+        `已匯出舊版相容 JSON 至 ${path}。若存在無法表示之別名或關聯欄位，後端已依規則處理。`
+      );
+    });
+  }
+
+  // 列表過濾與分頁計算
+  const currentEntries = status?.value?.document?.entries ?? [];
+  const currentRelations = status?.value?.relations ?? [];
+
+  const relationsMap = useMemo(() => {
+    const map = new Map<string, string[]>();
+    for (const r of currentRelations) {
+      const listA = map.get(r.source_id) ?? [];
+      listA.push(r.target_id);
+      map.set(r.source_id, listA);
+
+      const listB = map.get(r.target_id) ?? [];
+      listB.push(r.source_id);
+      map.set(r.target_id, listB);
+    }
+    return map;
+  }, [currentRelations]);
+
+  const filteredRows = useMemo(() => {
+    const q = query.trim().toLowerCase();
+    return currentEntries.filter((entry) => {
+      if (typeFilter !== "all" && entry.term_type !== typeFilter) {
+        return false;
+      }
+      if (!q) return true;
+      const matchText = (entry.text || "").toLowerCase().includes(q);
+      const matchReading = (entry.reading || "").toLowerCase().includes(q);
+      const matchAnnotation = (entry.annotation || "").toLowerCase().includes(q);
+      const matchAlias = (entry.alias || "").toLowerCase().includes(q);
+      const matchAliasReading = (entry.alias_reading || "").toLowerCase().includes(q);
+      return matchText || matchReading || matchAnnotation || matchAlias || matchAliasReading;
+    });
+  }, [currentEntries, query, typeFilter]);
+
+  const totalPages = Math.max(1, Math.ceil(filteredRows.length / PAGE_SIZE));
+  const currentPageRows = filteredRows.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE);
+
+  // 選取切換
+  function toggleRowSelection(id: string) {
+    setSelectedRowIds((prev) => {
+      const next = new Set(prev);
+      if (next.has(id)) next.delete(id);
+      else next.add(id);
+      return next;
+    });
+  }
+
+  function toggleSelectAllCurrentPage() {
+    const allPageSelected = currentPageRows.every((r) => selectedRowIds.has(r.entry_id));
+    setSelectedRowIds((prev) => {
+      const next = new Set(prev);
+      if (allPageSelected) {
+        for (const r of currentPageRows) next.delete(r.entry_id);
+      } else {
+        for (const r of currentPageRows) next.add(r.entry_id);
+      }
+      return next;
+    });
+  }
+
+  return (
+    <section
+      aria-label="統一詞庫管理"
+      style={{
+        padding: "16px 20px",
+        display: "flex",
+        flexDirection: "column",
+        gap: 16,
+        overflowY: "auto",
+        maxWidth: 1200,
+      }}
+    >
+      {/* 標題與核心狀態面板 */}
+      <Card style={{ padding: 16, display: "flex", flexDirection: "column", gap: 12 }}>
+        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", flexWrap: "wrap", gap: 8 }}>
+          <div>
+            <Text weight="bold" size={500} style={{ display: "block" }}>
+              離線統一詞彙管理 (Unified Lexicon Manager)
+            </Text>
+            <Text size={200} style={{ color: "#666" }}>
