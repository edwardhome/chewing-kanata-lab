     }
 }
+
+/// Enumerate visible applications only when the user presses the picker button.
+/// Window titles and document contents are deliberately not queried.
+#[tauri::command]
+pub(crate) fn running_app_input_rules() -> Result<Vec<AppRule>, String> {
+    use std::collections::{HashSet, BTreeMap};
+    use windows::{core::{BOOL, PWSTR}, Win32::{
+        Foundation::{HWND, LPARAM, CloseHandle},
+        System::Threading::{GetCurrentProcessId, OpenProcess, QueryFullProcessImageNameW, PROCESS_NAME_FORMAT, PROCESS_QUERY_LIMITED_INFORMATION},
+        UI::WindowsAndMessaging::{EnumWindows, IsWindowVisible, GetWindowThreadProcessId},
+    }};
+    unsafe extern "system" fn collect(hwnd: HWND, data: LPARAM) -> BOOL {
+        if unsafe { IsWindowVisible(hwnd) }.as_bool() {
+            let mut pid=0;
+            unsafe { GetWindowThreadProcessId(hwnd, Some(&mut pid)); }
+            if pid!=0 { unsafe { &mut *(data.0 as *mut HashSet<u32>) }.insert(pid); }
+        }
+        BOOL(1)
+    }
+    let mut pids=HashSet::<u32>::new();
+    unsafe { EnumWindows(Some(collect), LPARAM(&mut pids as *mut _ as isize)) }.map_err(|_| "無法列出已開啟的應用程式。")?;
+    let mut rules=BTreeMap::new();
+    for pid in pids {
+        if pid == unsafe { GetCurrentProcessId() } { continue; }
+        let Ok(handle)=(unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) }) else {continue};
+        let mut buffer=vec![0u16;32768]; let mut length=buffer.len() as u32;
+        let result=unsafe { QueryFullProcessImageNameW(handle,PROCESS_NAME_FORMAT(0),PWSTR(buffer.as_mut_ptr()), &mut length) };
+        unsafe { let _=CloseHandle(handle); }
+        if result.is_err() || length==0 || length as usize>=buffer.len() {continue;}
+        let Ok(path)=String::from_utf16(&buffer[..length as usize]) else {continue};
+        let Some(app_id)=normalize_path(&path) else {continue};
+        let Some(name)=Path::new(&path).file_name().and_then(|n|n.to_str()) else {continue};
+        rules.entry(app_id.clone()).or_insert(AppRule{app_id, display_name:name.into(),mode:"english"});
+    }
+    Ok(rules.into_values().take(256).collect())
+}
