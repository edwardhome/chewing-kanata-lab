             load_config,
             config::f_layer_defaults,
             app_input_rules::resolve_app_input_rule,
+            app_input_rules::running_app_input_rules,
             save_config,
             get_system_fonts,
             chewing_version,
diff --git a/src/AppInputRules.tsx b/src/AppInputRules.tsx
index e902512..f9e6404 100644
--- a/src/AppInputRules.tsx
+++ b/src/AppInputRules.tsx
@@ -24,12 +24,9 @@ export default function AppInputRules({ config, onChange }: { config: ChewingTsf
   const [busy, setBusy] = useState(false);
   const { rules, invalid } = decodeRules(config.app_input_rules_json);
   const update = (next: AppRule[]) => onChange({ ...latest.current, app_input_rules_json: JSON.stringify({ version: 1, rules: next }) });
-  const add = async () => {
-    setBusy(true); setError("");
-    try {
-      const path = await open({ title: "選擇應用程式", multiple: false, directory: false, filters: [{ name: "Windows 應用程式", extensions: ["exe"] }] });
-      if (typeof path !== "string") return;
-      const rule = await invoke<AppRule>("resolve_app_input_rule", { path });
+  const [running, setRunning] = useState<AppRule[]>([]);
+  const [selected, setSelected] = useState("");
+  const appendRule = (rule: AppRule) => {
       if (!mounted.current) return;
       const current = decodeRules(latest.current.app_input_rules_json);
       if (current.invalid) { setError("規則已變更，請先確認設定內容。"); return; }
@@ -39,6 +36,23 @@ export default function AppInputRules({ config, onChange }: { config: ChewingTsf
       }
       if (rules.length >= 256) { setError("最多可加入 256 個應用程式。"); return; }
       update([...rules, rule]);
+  };
+  const loadRunning = async () => {
+    setBusy(true); setError("");
+    try {
+      const apps = await invoke<AppRule[]>("running_app_input_rules");
+      if (!mounted.current) return;
+      setRunning(apps); setSelected(apps[0]?.app_id ?? "");
+    } catch (e) { setError(String(e)); }
+    finally { setBusy(false); }
+  };
+  const add = async () => {
+    setBusy(true); setError("");
+    try {
+      const path = await open({ title: "選擇應用程式", multiple: false, directory: false, filters: [{ name: "Windows 應用程式", extensions: ["exe"] }] });
+      if (typeof path !== "string") return;
+      const rule = await invoke<AppRule>("resolve_app_input_rule", { path });
+      appendRule(rule);
     } catch (e) { setError(String(e)); }
     finally { setBusy(false); }
   };
@@ -48,6 +62,15 @@ export default function AppInputRules({ config, onChange }: { config: ChewingTsf
     <Text>只切換 AI新酷音內部的英文／注音，不會搶回其他輸入法。同一 App 手動切換後會保留選擇；離開再返回才重新套用。</Text>
     <Text>按下「套用」或「確定」儲存後，規則與開關從下一次切入 App 生效。組字、選字或按鍵手勢尚未結束時會延後切換。</Text>
     {config.enable_caps_lock && <Text role="status">Caps Lock 模式控制已啟用; App 規則暫不介入。</Text>}
+    <div style={{ display: "flex", gap: "8px", flexWrap: "wrap" }}>
+      <Button disabled={busy || invalid} onClick={loadRunning}>從已開啟的 App 選擇</Button>
+      {running.length > 0 && <>
+        <Select aria-label="已開啟的應用程式" value={selected} onChange={(_, data) => setSelected(data.value)}>
+          {running.map(app => <option key={app.app_id} value={app.app_id}>{app.display_name} — {app.app_id}</option>)}
+        </Select>
+        <Button disabled={busy || invalid || !selected} onClick={() => { const app = running.find(a => a.app_id === selected); if (app) appendRule(app); }}>加入選取的 App</Button>
+      </>}
+    </div>
     <div><Button disabled={busy || invalid} onClick={add}>加入應用程式…</Button></div>
     <Text size={200}>請選擇實際的 .exe，不是捷徑。辨識依完整程式路徑，程式搬移後請重新加入。不辨識網站、Vim、SSH 或終端機分頁。</Text>
     {invalid && <div role="alert"><Text>儲存的規則格式無法辨識，暫不套用。可清空規則後重新加入。</Text> <Button onClick={() => update([])}>清空規則</Button></div>}
