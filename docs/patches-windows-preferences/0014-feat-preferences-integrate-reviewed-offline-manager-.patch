diff --git a/src-tauri/src/unified_lexicon.rs b/src-tauri/src/unified_lexicon.rs
new file mode 100644
index 0000000..97b119a
--- /dev/null
+++ b/src-tauri/src/unified_lexicon.rs
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (c) 2026 AI-Chewing contributors
+use chewing_policy_core::{shared_lexicon as lex, unified_sqlite as sql, unified_management as manage};
+use chewing_policy_core::shared_lexicon_store::{SharedStore,PreparedImport};
+use serde::Serialize;
+use std::{fs,io::{Read,Write},path::{Path,PathBuf},sync::{Mutex,atomic::{AtomicU64,Ordering}}};
+#[derive(Default)]
+pub struct UnifiedState { pending:Mutex<Option<Pending>> }
+struct Pending {token:String,owner:String,prepared:PreparedImport}
+static NEXT:AtomicU64=AtomicU64::new(1);
+fn cancel_pending(state:&UnifiedState,token:&str,owner:&str)->Result<(),String>{
+    let mut pending=state.pending.lock().map_err(|_|"預覽鎖定失敗。")?;
+    if pending.as_ref().is_some_and(|p|p.token==token&&p.owner==owner){*pending=None;}
+    Ok(())
+}
+fn take_pending(state:&UnifiedState,token:&str,owner:&str)->Result<Pending,String>{
+    let mut guard=state.pending.lock().map_err(|_|"預覽鎖定失敗。")?;
+    if !guard.as_ref().is_some_and(|p|p.token==token&&p.owner==owner){return Err("預覽已失效。".into());}
+    guard.take().ok_or_else(||"預覽已失效。".into())
+}
+
+#[derive(Serialize)]
+pub struct Status {revision:Option<String>,enabled:bool,recovered:bool,value:sql::UnifiedLexicon,previous:bool}
+#[derive(Serialize)]
+pub struct Preview {token:String,value:sql::UnifiedLexicon,conflicts:Vec<lex::EntryConflict>,replace:bool,#[serde(rename="expandedCount")]expanded_count:usize}
+fn error(e:impl std::fmt::Display)->String {format!("詞庫操作未完成：{e}；原有詞庫未被覆寫。")}
+fn store()->Result<SharedStore,String>{Ok(SharedStore::new(chewing_tip_core::shell::user_dir().map_err(error)?.join("SharedLexicon")))}
+fn status()->Result<Status,String>{
+    let store=store()?;let loaded=store.load_unified().map_err(error)?;let info=store.status().map_err(error)?;
+    if loaded.as_ref().map(|s|s.snapshot.revision.as_str())!=info.revision.as_deref(){return Err("詞庫已變更，請重新載入。".into());}
+    Ok(match loaded {
+        Some(s)=>Status{revision:Some(s.snapshot.revision),enabled:s.snapshot.enabled,recovered:s.recovered,value:s.value,previous:info.previous.is_some()},
+        None=>Status{revision:None,enabled:false,recovered:false,value:manage::empty(),previous:false},
+    })
+}
+fn check(expected:&Option<String>)->Result<Status,String>{let current=status()?;if &current.revision!=expected{return Err("詞庫已由其他操作變更，請重新載入並預覽。".into());}Ok(current)}
+fn read(path:&Path)->Result<sql::UnifiedLexicon,String>{
+    let m=fs::symlink_metadata(path).map_err(error)?;
+    #[cfg(windows)]
+    let link={use std::os::windows::fs::MetadataExt;m.file_attributes()&0x400!=0};
+    #[cfg(not(windows))]
+    let link=m.file_type().is_symlink();
+    if !m.is_file()||link||m.len()>sql::MAX_BYTES as u64{return Err("請選取不超過 16 MiB 的一般 SQLite／JSON 檔案。".into());}
+    let mut bytes=Vec::new();fs::File::open(path).map_err(error)?.take(sql::MAX_BYTES as u64+1).read_to_end(&mut bytes).map_err(error)?;
+    if bytes.starts_with(b"SQLite format 3\0"){sql::decode(&bytes).map_err(error)}else{Ok(sql::UnifiedLexicon{document:lex::parse(&bytes).map_err(error)?,relations:vec![]})}
+}
+fn save_pending(state:&UnifiedState,owner:&str,prepared:PreparedImport,conflicts:Vec<lex::EntryConflict>,replace:bool,expanded_count:usize)->Result<Preview,String>{
+    let token=NEXT.fetch_add(1,Ordering::Relaxed).to_string();
+    let value=prepared.unified_value().ok_or("預覽格式不完整。")?.clone();
+    *state.pending.lock().map_err(|_|"預覽鎖定失敗。")?=Some(Pending{token:token.clone(),owner:owner.into(),prepared});
+    Ok(Preview{token,value,conflicts,replace,expanded_count})
+}
+#[tauri::command]
+pub async fn unified_lexicon_status()->Result<Status,String>{tauri::async_runtime::spawn_blocking(status).await.map_err(error)?}
+#[tauri::command]
+pub async fn unified_lexicon_read(path:String)->Result<sql::UnifiedLexicon,String>{tauri::async_runtime::spawn_blocking(move||read(Path::new(&path))).await.map_err(error)?}
+#[tauri::command]
+pub async fn unified_lexicon_preview(value:sql::UnifiedLexicon,expected:Option<String>,replace:bool,selected:Option<Vec<String>>,incoming_conflicts:Vec<String>,window:tauri::Window,state:tauri::State<'_,UnifiedState>)->Result<Preview,String>{
+    let (prepared,conflicts,count)=tauri::async_runtime::spawn_blocking(move||{
+        let source=manage::digest(&value).map_err(error)?;
+        let incoming=manage::selected(&value,selected.as_deref()).map_err(error)?;
+        let count=incoming.document.entries.len();
+        let current=check(&expected)?;
+        let (result,conflicts)=if replace {if !incoming_conflicts.is_empty(){return Err("完整替換不使用合併衝突選項。".into());}(incoming,vec![])}else{manage::merge(&current.value,&incoming,&incoming_conflicts).map_err(error)?};
+        let prepared=store()?.prepare_unified(result,expected.as_deref(),&source).map_err(error)?;
+        Ok::<_,String>((prepared,conflicts,count))
+    }).await.map_err(error)??;
+    save_pending(&state,window.label(),prepared,conflicts,replace,count)
+}
+#[tauri::command]
+pub async fn unified_lexicon_edit(entry:Option<manage::Edit>,old_id:Option<String>,delete_ids:Vec<String>,expected:Option<String>,window:tauri::Window,state:tauri::State<'_,UnifiedState>)->Result<Preview,String>{
+    let prepared=tauri::async_runtime::spawn_blocking(move||{
+        let current=check(&expected)?;
+        let value=manage::edit(&current.value,entry,old_id.as_deref(),&delete_ids).map_err(error)?;
+        let source=manage::digest(&value).map_err(error)?;
+        store()?.prepare_unified(value,expected.as_deref(),&source).map_err(error)
+    }).await.map_err(error)??;
+    let count=prepared.document().entries.len();
+    save_pending(&state,window.label(),prepared,vec![],true,count)
+}
+#[tauri::command]
+pub fn unified_lexicon_cancel(token:String,window:tauri::Window,state:tauri::State<'_,UnifiedState>)->Result<(),String>{
+    cancel_pending(&state,&token,window.label())
+}
+#[tauri::command]
+pub async fn unified_lexicon_approve(token:String,confirmed:bool,window:tauri::Window,state:tauri::State<'_,UnifiedState>)->Result<Status,String>{
+    if !confirmed{return Err("請先確認預覽內容。".into());}
+    let pending=take_pending(&state,&token,window.label())?;
+    tauri::async_runtime::spawn_blocking(move||{store()?.approve(pending.prepared).map_err(error)?;status()}).await.map_err(error)?
+}
+#[tauri::command]
+pub async fn unified_lexicon_export(path:String,selected:Option<Vec<String>>,expected:Option<String>,json:bool)->Result<(),String>{
+    tauri::async_runtime::spawn_blocking(move||{
+        let current=check(&expected)?;
+        let value=manage::export_snapshot(&current.value,selected.as_deref()).map_err(error)?;
+        let bytes=if json {if !value.relations.is_empty(){return Err("所選詞條含中文關聯；請使用 SQLite，以保留完整內容。".into());}lex::encode(&value.document).map_err(error)?}else{sql::encode(&value).map_err(error)?};
+        let path=PathBuf::from(path);let parent=path.parent().ok_or("匯出位置不合法。")?;
+        let mut file=tempfile::NamedTempFile::new_in(parent).map_err(error)?;
+        file.write_all(&bytes).and_then(|_|file.as_file().sync_all()).map_err(error)?;
+        file.persist_noclobber(path).map_err(|_|"請使用尚未存在的新檔名；未覆寫既有檔案。")?;Ok(())
+    }).await.map_err(error)?
+}
+#[tauri::command]
+pub async fn unified_lexicon_rollback(expected:Option<String>,confirmed:bool)->Result<Status,String>{
+    if !confirmed{return Err("請先確認回復上一版。".into());}
+    tauri::async_runtime::spawn_blocking(move||{store()?.rollback(expected.as_deref()).map_err(error)?;status()}).await.map_err(error)?
+}
+#[tauri::command]
+pub async fn unified_lexicon_enabled(expected:Option<String>,enabled:bool)->Result<Status,String>{
+    tauri::async_runtime::spawn_blocking(move||{store()?.set_enabled(enabled,expected.as_deref()).map_err(error)?;status()}).await.map_err(error)?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn pending(state:&UnifiedState,root:&Path)->Preview {
+        let store=SharedStore::new(root.join("managed"));
+        let value=manage::empty();let source=manage::digest(&value).unwrap();
+        save_pending(state,"owner",store.prepare_unified(value,None,&source).unwrap(),vec![],false,0).unwrap()
+    }
+    #[test]fn preview_is_owner_bound_and_single_use(){
+        let t=tempfile::tempdir().unwrap();let state=UnifiedState::default();let preview=pending(&state,t.path());
+        assert!(take_pending(&state,&preview.token,"other").is_err());
+        assert!(take_pending(&state,"wrong","owner").is_err());
+        assert!(take_pending(&state,&preview.token,"owner").is_ok());
+        assert!(take_pending(&state,&preview.token,"owner").is_err());
+        assert!(!t.path().join("managed").exists());
+    }
+    #[test]fn cancellation_cannot_cancel_another_window_or_write_files(){
+        let t=tempfile::tempdir().unwrap();let state=UnifiedState::default();let preview=pending(&state,t.path());
+        cancel_pending(&state,&preview.token,"other").unwrap();assert!(state.pending.lock().unwrap().is_some());
+        cancel_pending(&state,&preview.token,"owner").unwrap();assert!(state.pending.lock().unwrap().is_none());
+        assert!(!t.path().join("managed").exists());
+    }
+    #[test]fn replacing_preview_invalidates_prior_token(){
+        let t=tempfile::tempdir().unwrap();let state=UnifiedState::default();let first=pending(&state,t.path());let next=pending(&state,t.path());
+        assert!(take_pending(&state,&first.token,"owner").is_err());assert!(take_pending(&state,&next.token,"owner").is_ok());
+    }
+    #[test]fn reader_rejects_directory_and_invalid_sqlite(){
+        let t=tempfile::tempdir().unwrap();assert!(read(t.path()).is_err());let p=t.path().join("broken.sqlite");
+        fs::write(&p,b"SQLite format 3\0broken").unwrap();assert!(read(&p).is_err());assert_eq!(fs::read(&p).unwrap(),b"SQLite format 3\0broken");
