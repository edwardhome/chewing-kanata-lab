+// SPDX-FileCopyrightText: 2026 AI Chewing contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+use chewing_policy_core::shared_lexicon::{self as exchange, LexiconDocument, MergePreview, MAX_BYTES};
+use chewing_policy_core::shared_lexicon_store::SharedStore;
+use chewing_policy_core::shared_engineering_exchange::{preview_engineering_export, EngineeringExportPreview};
+use chewing_policy_core::user_engineering::{parse_user_terms, UserEngineeringTerm, MAX_USER_TERMS_BYTES, USER_TERMS_FILENAME};
+use serde::Serialize;
+use std::{fs, io::{Read, Write}, path::{Path, PathBuf}, sync::{Mutex, atomic::{AtomicU64, Ordering}}};
+
+#[derive(Default)]
+pub struct SharedState {
+    pending: Mutex<Option<Pending>>,
+    engineering_export: Mutex<Option<PendingEngineeringExport>>,
+}
+struct Pending { token: String, owner: String, expected: Option<String>, document: LexiconDocument, preview: MergePreview }
+static NEXT_TOKEN: AtomicU64 = AtomicU64::new(1);
+#[derive(Serialize)]
+pub struct Status { revision: Option<String>, version: Option<String>, entries: usize, enabled: bool }
+#[derive(Serialize)]
+pub struct Preview { token: String, suggested_version: String, diff: MergePreview }
+fn store() -> Result<SharedStore,String> {
+    let root=chewing_tip_core::shell::user_dir().map_err(|_|"無法取得 AI新酷音資料目錄。")?;
+    Ok(SharedStore::new(root.join("SharedLexicon")))
+}
+fn error(e:impl std::fmt::Display)->String { format!("共用詞庫操作未完成：{e}。原有個人詞庫不受影響。") }
+fn load_status()->Result<Status,String> {
+    match store()?.load().map_err(error)? {
+        None=>Ok(Status{revision:None,version:None,entries:0,enabled:false}),
+        Some(s)=>Ok(Status{revision:Some(s.revision),version:Some(s.document.dictionary_version),entries:s.document.entries.len(),enabled:s.enabled}),
+    }
+}
+fn read_selected(path:String)->Result<Vec<u8>,String> {
+    let p=PathBuf::from(path);let metadata=fs::symlink_metadata(&p).map_err(error)?;
+    if !metadata.is_file() || metadata.file_type().is_symlink() || metadata.len()>MAX_BYTES as u64 {return Err("請選擇不超過 8 MiB 的一般 JSON 檔案。".into());}
+    let mut bytes=Vec::new();fs::File::open(p).map_err(error)?.take(MAX_BYTES as u64+1).read_to_end(&mut bytes).map_err(error)?;
+    if bytes.len()>MAX_BYTES {return Err("詞庫檔案超過 8 MiB。".into());}Ok(bytes)
+}
+#[tauri::command]
+pub async fn shared_lexicon_status()->Result<Status,String> {
+    tauri::async_runtime::spawn_blocking(load_status).await.map_err(error)?
+}
+#[tauri::command]
+pub async fn preview_shared_lexicon(path:String, window:tauri::Window, state:tauri::State<'_,SharedState>)->Result<Preview,String> {
+    let (document,expected,preview)=tauri::async_runtime::spawn_blocking(move|| {
+        let incoming=exchange::parse(&read_selected(path)?).map_err(error)?;
+        let current=store()?.load().map_err(error)?;
+        let expected=current.as_ref().map(|s|s.revision.clone());
+        let base=current.map(|s|s.document).unwrap_or(LexiconDocument{format:"ai-bopomofo.lexicon".into(),schema_version:"1.0.0".into(),document_type:"review".into(),dictionary_version:"empty-local".into(),entries:vec![]});
+        let preview=exchange::merge_preview(&base,&incoming).map_err(error)?;
+        Ok::<_,String>((incoming,expected,preview))
+    }).await.map_err(error)??;
+    let token=NEXT_TOKEN.fetch_add(1,Ordering::Relaxed).to_string();
+    let result=Preview{token:token.clone(),suggested_version:document.dictionary_version.clone(),diff:preview.clone()};
+    *state.pending.lock().map_err(|_|"預覽狀態鎖定失敗。")?=Some(Pending{token,owner:window.label().to_owned(),expected,document,preview});
+    Ok(result)
+}
+#[tauri::command]
+pub fn cancel_shared_lexicon(token:String, window:tauri::Window, state:tauri::State<'_,SharedState>)->Result<(),String> {
+    cancel_import_for(&state, &token, window.label())
+}
+#[tauri::command]
+pub async fn approve_shared_lexicon(token:String, version:String, incoming_conflicts:Vec<String>, confirmed:bool, window:tauri::Window, state:tauri::State<'_,SharedState>)->Result<Status,String> {
+    if !confirmed {return Err("請先明確確認部署預覽內容。".into());}
+    let pending={let mut guard=state.pending.lock().map_err(|_|"預覽狀態鎖定失敗。")?;
+        if !guard.as_ref().is_some_and(|p|p.token==token && p.owner==window.label()){return Err("預覽已失效，請重新選檔。".into());}guard.take().unwrap()};
+    tauri::async_runtime::spawn_blocking(move|| {
+        let (document, expected) = resolve_import(pending, &version, &incoming_conflicts)?;
+        let bytes=exchange::encode(&document).map_err(error)?;
+        let store=store()?;let prepared=store.prepare(&bytes,expected.as_deref()).map_err(error)?;
+        store.approve(prepared).map_err(error)?;load_status()
+    }).await.map_err(error)?
+}
+#[tauri::command]
+pub async fn export_shared_lexicon(path:String)->Result<(),String> {
+    tauri::async_runtime::spawn_blocking(move|| {
+        let snapshot=store()?.load().map_err(error)?.ok_or("尚未有本機共用詞庫可匯出。")?;
+        let bytes=exchange::encode(&snapshot.document).map_err(error)?;
+        write_export_snapshot(&PathBuf::from(path), &bytes)?;
+        Ok(())
+    }).await.map_err(error)?
+}
+#[tauri::command]
+pub async fn set_shared_lexicon_enabled(enabled:bool,expected:Option<String>)->Result<Status,String> {
+    tauri::async_runtime::spawn_blocking(move|| {store()?.set_enabled(enabled,expected.as_deref()).map_err(error)?;load_status()}).await.map_err(error)?
+}
+#[tauri::command]
+pub async fn rollback_shared_lexicon(expected:Option<String>,confirmed:bool)->Result<Status,String> {
+    if !confirmed {return Err("請先確認回復上一版。".into());}
+    tauri::async_runtime::spawn_blocking(move|| {store()?.rollback(expected.as_deref()).map_err(error)?;load_status()}).await.map_err(error)?
+}
+
+
+fn cancel_import_for(state: &SharedState, token: &str, owner: &str) -> Result<(), String> {
+    let mut pending=state.pending.lock().map_err(|_|"預覽狀態鎖定失敗。")?;
+    if pending.as_ref().is_some_and(|p|p.token==token && p.owner==owner){*pending=None;}
+    Ok(())
+}
+fn resolve_import(pending: Pending, version: &str, incoming_conflicts: &[String]) -> Result<(LexiconDocument, Option<String>), String> {
+    let mut entries = pending.preview.entries;
+    let allowed: std::collections::HashSet<_> = pending.preview.conflicts.iter().map(|c| c.incoming.entry_id.as_str()).collect();
+    if incoming_conflicts.iter().any(|id| !allowed.contains(id.as_str())) { return Err("衝突選擇不符合預覽。".into()); }
+    for conflict in pending.preview.conflicts {
+        if incoming_conflicts.contains(&conflict.incoming.entry_id) {
+            if let Some(entry) = entries.iter_mut().find(|e| e.entry_id == conflict.incoming.entry_id) { *entry = conflict.incoming; }
+        }
+    }
+    let mut document = pending.document;
+    document.entries = entries;
+    document.dictionary_version = version.to_owned();
+    document.validate().map_err(error)?;
+    Ok((document, pending.expected))
+}
+
+#[derive(Serialize)]
+pub struct EngineeringExportSource {
+    terms: Vec<UserEngineeringTerm>,
+    revision: Option<String>,
+}
+#[derive(Serialize)]
+pub struct EngineeringExportResult {
+    token: String,
+    selected_count: usize,
+    preview: EngineeringExportPreview,
+}
+struct PendingEngineeringExport {
+    token: String,
+    owner: String,
+    source_revision: Option<String>,
+    preview: EngineeringExportPreview,
+}
+
+fn engineering_directory() -> Result<PathBuf, String> {
+    chewing_tip_core::shell::user_dir().map_err(|_| "無法取得 AI新酷音資料目錄。".into())
+}
+fn read_engineering_export_source(directory: &Path) -> Result<EngineeringExportSource, String> {
+    let path = directory.join(USER_TERMS_FILENAME);
+    let metadata = match fs::symlink_metadata(&path) {
+        Ok(metadata) => metadata,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(EngineeringExportSource { terms: vec![], revision: None }),
+        Err(_) => return Err("無法讀取已儲存的私人工程詞。".into()),
+    };
+    #[cfg(windows)]
+    let linked = { use std::os::windows::fs::MetadataExt; metadata.file_attributes() & 0x400 != 0 };
+    #[cfg(not(windows))]
+    let linked = metadata.file_type().is_symlink();
+    if !metadata.is_file() || metadata.file_type().is_symlink() || linked || metadata.len() > MAX_USER_TERMS_BYTES as u64 {
+        return Err("工程詞來源必須是有效的一般檔案，且不可超過 256 KiB。".into());
+    }
+    let mut bytes = Vec::new();
+    fs::File::open(&path).map_err(|_| "無法讀取私人工程詞。")?
+        .take(MAX_USER_TERMS_BYTES as u64 + 1).read_to_end(&mut bytes).map_err(|_| "讀取私人工程詞未完成。")?;
+    if bytes.len() > MAX_USER_TERMS_BYTES { return Err("私人工程詞超過 256 KiB。".into()); }
+    let terms = parse_user_terms(&bytes).map_err(|_| "私人工程詞格式無效，請先在工程詞設定檢查。")?;
+    let revision = String::from_utf8(bytes).map_err(|_| "私人工程詞必須使用 UTF-8。")?;
+    Ok(EngineeringExportSource { terms, revision: Some(revision) })
+}
+fn prepare_engineering_export_at(directory: &Path, selected: Vec<usize>, expected: Option<String>, version: &str, allow_alias_omission: bool)
+    -> Result<PendingEngineeringExport, String> {
+    let source = read_engineering_export_source(directory)?;
+    if source.revision != expected { return Err("工程詞已變更，請重新載入並選取後再預覽。".into()); }
+    let indices: std::collections::BTreeSet<_> = selected.iter().copied().collect();
+    if indices.is_empty() || indices.len() != selected.len() || indices.iter().any(|&i| i >= source.terms.len()) {
+        return Err("請至少選取一筆有效工程詞；選取清單不可重複。".into());
+    }
+    let indices: Vec<_> = indices.into_iter().collect();
+    let terms: Vec<_> = indices.iter().map(|&i| source.terms[i].clone()).collect();
+    let mut preview = preview_engineering_export(&terms, version, allow_alias_omission)
+        .map_err(|_| "無法產生共用格式；請檢查版本名稱、詞條格式與容量。")?;
+    // Display indices refer to the source list, never an unrelated partial subset.
+    for row in &mut preview.omitted_aliases { row.index = indices[row.index]; }
+    for row in &mut preview.unsupported { row.index = indices[row.index]; }
+    Ok(PendingEngineeringExport { token: String::new(), owner: String::new(), source_revision: source.revision, preview })
+}
+fn take_engineering_export(state: &SharedState, token: &str, owner: &str) -> Result<PendingEngineeringExport, String> {
+    let mut guard = state.engineering_export.lock().map_err(|_| "匯出預覽狀態鎖定失敗。")?;
+    if !guard.as_ref().is_some_and(|pending| pending.token == token && pending.owner == owner) {
+        return Err("匯出預覽已失效，請重新預覽。".into());
+    }
+    guard.take().ok_or_else(|| "匯出預覽已失效。".into())
+}
+fn cancel_engineering_export_for(state: &SharedState, token: &str, owner: &str) -> Result<(), String> {
+    let mut guard = state.engineering_export.lock().map_err(|_| "匯出預覽狀態鎖定失敗。")?;
+    if guard.as_ref().is_some_and(|pending| pending.token == token && pending.owner == owner) { *guard = None; }
+    Ok(())
+}
+fn write_export_snapshot(path: &Path, bytes: &[u8]) -> Result<(), String> {
+    let parent = path.parent().ok_or("匯出位置無效。")?;
+    let mut file = tempfile::NamedTempFile::new_in(parent).map_err(|_| "無法在選取位置建立匯出暫存檔。")?;
+    file.write_all(bytes).and_then(|_| file.as_file().sync_all()).map_err(|_| "匯出寫入失敗，未建立完成的快照。")?;
+    file.persist_noclobber(path).map_err(|_| "無法建立匯出檔；請選擇尚未存在的新檔名。")?;
+    Ok(())
+}
+fn finish_engineering_export_at(directory: &Path, pending: PendingEngineeringExport, destination: &Path, confirmed: bool) -> Result<(), String> {
+    if !confirmed { return Err("請先確認匯出及預覽中列出的省略內容。".into()); }
+    let document = pending.preview.document.as_ref().ok_or("選取詞條包含不支援項目；不會匯出不完整的子集。")?;
+    // Use the same lock as the existing engineering editor, so the revision cannot
+    // change between validation and publishing the independent snapshot.
+    let lock = fs::OpenOptions::new().read(true).write(true).create(true).truncate(false)
+        .open(directory.join("engineering-terms.lock")).map_err(|_| "無法鎖定工程詞來源以完成匯出。")?;
+    fs2::FileExt::try_lock_exclusive(&lock).map_err(|_| "工程詞正在由其他視窗儲存，請稍後重新預覽。")?;
+    let source = read_engineering_export_source(directory)?;
+    if source.revision != pending.source_revision { return Err("工程詞在預覽後已變更；未匯出，請重新預覽。".into()); }
+    write_export_snapshot(destination, &exchange::encode(document).map_err(error)?)
+}
+
+/// Explicit source selection only; not called on settings startup or background refresh.
+#[tauri::command]
+pub async fn load_engineering_export_source() -> Result<EngineeringExportSource, String> {
+    tauri::async_runtime::spawn_blocking(|| read_engineering_export_source(&engineering_directory()?))
+        .await.map_err(|_| "讀取工程詞來源未完成。")?
+}
+#[tauri::command]
+pub async fn preview_engineering_shared_export(selected: Vec<usize>, expected: Option<String>, version: String, allow_alias_omission: bool,
+    window: tauri::Window, state: tauri::State<'_, SharedState>) -> Result<EngineeringExportResult, String> {
+    let selected_count = selected.len();
+    let mut pending = tauri::async_runtime::spawn_blocking(move ||
+        prepare_engineering_export_at(&engineering_directory()?, selected, expected, &version, allow_alias_omission))
+        .await.map_err(|_| "產生匯出預覽未完成。")??;
+    let token = NEXT_TOKEN.fetch_add(1, Ordering::Relaxed).to_string();
+    pending.token = token.clone(); pending.owner = window.label().to_owned();
+    let result = EngineeringExportResult { token, selected_count, preview: pending.preview.clone() };
+    *state.engineering_export.lock().map_err(|_| "匯出預覽狀態鎖定失敗。")? = Some(pending);
+    Ok(result)
+}
+#[tauri::command]
+pub fn cancel_engineering_shared_export(token: String, window: tauri::Window, state: tauri::State<'_, SharedState>) -> Result<(), String> {
+    cancel_engineering_export_for(&state, &token, window.label())
+}
+#[tauri::command]
+pub async fn export_engineering_shared_lexicon(token: String, path: String, confirmed: bool, window: tauri::Window,
+    state: tauri::State<'_, SharedState>) -> Result<(), String> {
+    if !confirmed { return Err("請先確認匯出及預覽中列出的省略內容。".into()); }
+    let pending = take_engineering_export(&state, &token, window.label())?;
+    tauri::async_runtime::spawn_blocking(move || finish_engineering_export_at(&engineering_directory()?, pending, &PathBuf::from(path), confirmed))
+        .await.map_err(|_| "工程詞匯出未完成。")?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use chewing_policy_core::user_engineering::encode_user_terms;
+    fn terms() -> Vec<UserEngineeringTerm> {
+        vec![UserEngineeringTerm { input: "CH4".into(), output: "CH₄".into(), annotation: "甲烷".into(), zh_aliases: vec!["甲烷".into(), "沼氣".into()] },
+            UserEngineeringTerm { input: "H2O".into(), output: "H₂O".into(), annotation: "水".into(), zh_aliases: vec![] }]
+    }
+    fn source() -> (tempfile::TempDir, Vec<u8>, Option<String>) {
+        let temp = tempfile::tempdir().unwrap(); let bytes = encode_user_terms(&terms()).unwrap();
+        fs::write(temp.path().join(USER_TERMS_FILENAME), &bytes).unwrap();
+        let revision = Some(String::from_utf8(bytes.clone()).unwrap()); (temp, bytes, revision)
+    }
+    #[test]
+    fn export_preview_and_cancel_leave_source_and_destination_untouched() {
+        let (temp, original, revision) = source();
+        let mut pending = prepare_engineering_export_at(temp.path(), vec![1], revision, "v1", false).unwrap();
+        pending.token = "export-1".into(); pending.owner = "main".into();
+        let state = SharedState::default(); *state.engineering_export.lock().unwrap() = Some(pending);
+        cancel_engineering_export_for(&state, "export-1", "other-window").unwrap();
+        assert!(state.engineering_export.lock().unwrap().is_some());
+        cancel_engineering_export_for(&state, "export-1", "main").unwrap();
+        assert!(take_engineering_export(&state, "export-1", "main").is_err());
+        assert_eq!(fs::read(temp.path().join(USER_TERMS_FILENAME)).unwrap(), original);
+        assert_eq!(fs::read_dir(temp.path()).unwrap().count(), 1);
+    }
+    #[test]
+    fn unsupported_aliases_block_entire_export_by_default() {
+        let (temp, original, revision) = source();
+        let pending = prepare_engineering_export_at(temp.path(), vec![0, 1], revision, "v1", false).unwrap();
+        assert!(pending.preview.document.is_none()); assert_eq!(pending.preview.unsupported.len(), 1);
+        let output = temp.path().join("exchange.json");
+        assert!(finish_engineering_export_at(temp.path(), pending, &output, true).is_err());
+        assert!(!output.exists()); assert_eq!(fs::read(temp.path().join(USER_TERMS_FILENAME)).unwrap(), original);
+    }
+    #[test]
+    fn alias_omission_is_exact_and_requires_final_confirmation() {
+        let (temp, original, revision) = source();
+        let pending = prepare_engineering_export_at(temp.path(), vec![0], revision.clone(), "v1", true).unwrap();
+        assert_eq!(pending.preview.omitted_aliases[0].aliases, terms()[0].zh_aliases);
+        let output = temp.path().join("exchange.json");
+        assert!(finish_engineering_export_at(temp.path(), pending, &output, false).is_err());
+        assert!(!output.exists());
+        let pending = prepare_engineering_export_at(temp.path(), vec![0], revision, "v1", true).unwrap();
+        finish_engineering_export_at(temp.path(), pending, &output, true).unwrap();
+        let doc = exchange::parse(&fs::read(&output).unwrap()).unwrap();
+        assert_eq!(doc.entries.len(), 1); assert_eq!(doc.entries[0].text, "CH₄"); assert_eq!(doc.document_type, "review");
+        assert!(!doc.entries[0].review.user_confirmed);
+        assert_eq!(fs::read(temp.path().join(USER_TERMS_FILENAME)).unwrap(), original);
+    }
+    #[test]
+    fn changed_source_after_preview_rejects_export() {
+        let (temp, _, revision) = source();
+        let pending = prepare_engineering_export_at(temp.path(), vec![1], revision, "v1", false).unwrap();
+        let changed = encode_user_terms(&[]).unwrap(); fs::write(temp.path().join(USER_TERMS_FILENAME), &changed).unwrap();
+        let output = temp.path().join("exchange.json");
+        assert!(finish_engineering_export_at(temp.path(), pending, &output, true).is_err());
+        assert!(!output.exists()); assert_eq!(fs::read(temp.path().join(USER_TERMS_FILENAME)).unwrap(), changed);
+    }
+    #[test]
+    fn existing_export_and_source_paths_are_never_overwritten() {
+        let (temp, original, revision) = source();
+        let output = temp.path().join("existing.json"); fs::write(&output, b"existing contents").unwrap();
+        let pending = prepare_engineering_export_at(temp.path(), vec![1], revision.clone(), "v1", false).unwrap();
+        assert!(finish_engineering_export_at(temp.path(), pending, &output, true).is_err());
+        assert_eq!(fs::read(output).unwrap(), b"existing contents");
+        let pending = prepare_engineering_export_at(temp.path(), vec![1], revision, "v1", false).unwrap();
+        assert!(finish_engineering_export_at(temp.path(), pending, &temp.path().join(USER_TERMS_FILENAME), true).is_err());
+        assert_eq!(fs::read(temp.path().join(USER_TERMS_FILENAME)).unwrap(), original);
+    }
+    #[test]
+    fn source_selection_and_revision_are_checked_before_preview() {
+        let (temp, _, revision) = source();
+        for selection in [vec![], vec![2], vec![1, 1]] {
+            assert!(prepare_engineering_export_at(temp.path(), selection, revision.clone(), "v1", false).is_err());
+        }
+        assert!(prepare_engineering_export_at(temp.path(), vec![1], None, "v1", false).is_err());
+    }
+    #[test]
+    fn export_token_is_window_bound_and_single_use() {
+        let (temp, _, revision) = source();
+        let mut pending = prepare_engineering_export_at(temp.path(), vec![1], revision, "v1", false).unwrap();
+        pending.token = "export-2".into(); pending.owner = "main".into();
+        let state = SharedState::default(); *state.engineering_export.lock().unwrap() = Some(pending);
+        assert!(take_engineering_export(&state, "export-2", "other").is_err());
+        assert!(take_engineering_export(&state, "wrong", "main").is_err());
+        assert!(take_engineering_export(&state, "export-2", "main").is_ok());
+        assert!(take_engineering_export(&state, "export-2", "main").is_err());
+    }
+    #[test]
+    fn source_writer_lock_prevents_export_during_save() {
+        let (temp, _, revision) = source();
