+        let lock = fs::OpenOptions::new().read(true).write(true).create_new(true).open(temp.path().join("engineering-terms.lock")).unwrap();
+        fs2::FileExt::try_lock_exclusive(&lock).unwrap();
+        let output = temp.path().join("exchange.json");
+        assert!(finish_engineering_export_at(temp.path(), pending, &output, true).is_err()); assert!(!output.exists());
+    }
+    fn pending_import() -> Pending {
+        let base = preview_engineering_export(&terms()[1..], "base", false).unwrap().document.unwrap();
+        let mut incoming = base.clone(); incoming.dictionary_version = "incoming".into();
+        incoming.entries[0].annotation = Some("匯入註解".into());
+        incoming.entries[0].usage = Some(exchange::Usage { commit_count: 10, manual_selection_count: 2 });
+        let preview = exchange::merge_preview(&base, &incoming).unwrap();
+        Pending { token: "import-1".into(), owner: "main".into(), expected: Some("base-revision".into()), document: incoming, preview }
+    }
+    #[test]
+    fn import_conflicts_default_to_base_and_explicit_choice_preserves_fields() {
+        let pending = pending_import(); let old = pending.preview.conflicts[0].existing.clone();
+        let (default, revision) = resolve_import(pending, "merged-default", &[]).unwrap();
+        assert_eq!(default.entries[0], old); assert_eq!(revision.as_deref(), Some("base-revision"));
+        let pending = pending_import(); let incoming = pending.preview.conflicts[0].incoming.clone();
+        let (selected, _) = resolve_import(pending, "merged-selected", &[incoming.entry_id.clone()]).unwrap();
+        assert_eq!(selected.entries[0], incoming); assert_eq!(selected.entries[0].usage.as_ref().unwrap().commit_count, 10);
+        assert!(resolve_import(pending_import(), "merged", &["unknown-entry".into()]).is_err());
+    }
+    #[test]
+    fn import_cancellation_is_window_and_token_bound() {
+        let state = SharedState::default(); *state.pending.lock().unwrap() = Some(pending_import());
+        cancel_import_for(&state, "import-1", "other").unwrap(); assert!(state.pending.lock().unwrap().is_some());
+        cancel_import_for(&state, "wrong", "main").unwrap(); assert!(state.pending.lock().unwrap().is_some());
+        cancel_import_for(&state, "import-1", "main").unwrap(); assert!(state.pending.lock().unwrap().is_none());
+    }
+}
