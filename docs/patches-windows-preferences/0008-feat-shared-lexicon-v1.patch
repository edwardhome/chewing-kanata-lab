+        <table><thead><tr><th>輸入碼</th><th>候選</th><th>註解</th></tr></thead><tbody>{preview.preview.document.entries.map(e=><tr key={e.entry_id}>
+          <td>{e.reading}</td><td>{e.text}</td><td>{e.annotation??""}</td></tr>)}</tbody></table></details>}
+      <Button appearance="primary" disabled={busy||!preview.preview.document} onClick={()=>void exportFile()}>確認內容並另存新 JSON</Button>
+    </>}
+    <Text aria-live="polite">{message}</Text>{error&&<Text role="alert">{error}</Text>}
+  </section>;
