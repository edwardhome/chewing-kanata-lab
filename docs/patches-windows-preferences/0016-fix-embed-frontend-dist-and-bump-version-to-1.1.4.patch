 src-tauri/tauri.conf.json | 2 +-
 4 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/package.json b/package.json
index bad1767..0403984 100644
--- a/package.json
+++ b/package.json
@@ -1,7 +1,7 @@
 {
   "name": "chewing-preferences",
   "private": true,
-  "version": "1.1.2",
+  "version": "1.1.4",
   "type": "module",
   "scripts": {
     "dev": "vite",
diff --git a/src-tauri/Cargo.lock b/src-tauri/Cargo.lock
index 638e3ba..b4b0102 100644
--- a/src-tauri/Cargo.lock
+++ b/src-tauri/Cargo.lock
@@ -514,7 +514,7 @@ dependencies = [
 
 [[package]]
 name = "chewing-preferences"
-version = "1.1.2"
+version = "1.1.4"
 dependencies = [
  "chewing-policy-core",
  "chewing_tip_core",
@@ -538,7 +538,7 @@ dependencies = [
 
 [[package]]
 name = "chewing_tip_core"
-version = "1.1.3"
+version = "1.1.4"
 dependencies = [
  "base64 0.22.1",
  "base64-serde",
diff --git a/src-tauri/Cargo.toml b/src-tauri/Cargo.toml
index 47ee593..1ab0b23 100644
--- a/src-tauri/Cargo.toml
+++ b/src-tauri/Cargo.toml
@@ -4,7 +4,7 @@
 
 [package]
 name = "chewing-preferences"
-version = "1.1.2"
+version = "1.1.4"
 edition = "2024"
 license = "GPL-3.0-or-later"
 
@@ -31,7 +31,7 @@ fs2 = "0.4"
 tempfile = "3"
